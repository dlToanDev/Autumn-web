// Trang RoomSearchPage la man tim phong chinh cho nguoi dung.
// Muc dich:
// - Tai phong + dia gioi hanh chinh + amenity
// - Cho loc theo khu vuc, gia, dien tich va tu khoa
// - Render ket qua bang RoomCard
import { useEffect, useMemo, useState } from 'react'
import { getDistricts, getProvinces, getWards } from '../api/addressApi'
import { getAmenities, getRooms } from '../api/rentalApi'
import RoomCard from '../components/RoomCard'

const defaultFilters = {
  q: '',
  provinceId: '',
  districtId: '',
  wardId: '',
  minPrice: '',
  maxPrice: '',
  minArea: '',
  maxArea: '',
  amenityIds: [],
}

function buildRoomQuery(filters) {
  return {
    q: filters.q || undefined,
    provinceId: filters.provinceId || undefined,
    districtId: filters.districtId || undefined,
    wardId: filters.wardId || undefined,
    minPrice: filters.minPrice || undefined,
    maxPrice: filters.maxPrice || undefined,
    minArea: filters.minArea || undefined,
    maxArea: filters.maxArea || undefined,
    amenityIds: filters.amenityIds,
  }
}

function countActiveFilters(filters) {
  return [
    filters.q,
    filters.provinceId,
    filters.districtId,
    filters.wardId,
    filters.minPrice,
    filters.maxPrice,
    filters.minArea,
    filters.maxArea,
  ].filter(Boolean).length + filters.amenityIds.length
}

function buildPaginationItems(currentPage, totalPages) {
  if (totalPages <= 7) {
    return Array.from({ length: totalPages }, (_, index) => index + 1)
  }

  if (currentPage <= 3) {
    return [1, 2, 3, 4, 'end-ellipsis', totalPages]
  }

  if (currentPage >= totalPages - 2) {
    return [1, 'start-ellipsis', totalPages - 3, totalPages - 2, totalPages - 1, totalPages]
  }

  return [1, 'start-ellipsis', currentPage - 1, currentPage, currentPage + 1, 'end-ellipsis', totalPages]
}

export default function RoomSearchPage() {
  const roomsPerPage = 9
  const [rooms, setRooms] = useState([])
  const [provinces, setProvinces] = useState([])
  const [districts, setDistricts] = useState([])
  const [wards, setWards] = useState([])
  const [amenities, setAmenities] = useState([])
  const [filters, setFilters] = useState(defaultFilters)
  const [appliedFilters, setAppliedFilters] = useState(defaultFilters)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState('')
  const [isFilterOpen, setIsFilterOpen] = useState(false)
  const [currentPage, setCurrentPage] = useState(1)

  const activeFilterCount = countActiveFilters(appliedFilters)
  const totalPages = Math.max(1, Math.ceil(rooms.length / roomsPerPage))
  const paginatedRooms = useMemo(() => {
    const startIndex = (currentPage - 1) * roomsPerPage
    return rooms.slice(startIndex, startIndex + roomsPerPage)
  }, [currentPage, rooms])
  const paginationItems = useMemo(
    () => buildPaginationItems(currentPage, totalPages),
    [currentPage, totalPages],
  )

  useEffect(() => {
    setCurrentPage((prev) => Math.min(prev, totalPages))
  }, [totalPages])

  useEffect(() => {
    // Tai bo du lieu can thiet cho form filter ngay khi page mo.
    const loadInitial = async () => {
      setLoading(true)
      setError('')

      try {
        const [roomData, provinceData, amenityData] = await Promise.all([
          getRooms(),
          getProvinces(),
          getAmenities(),
        ])
        setRooms(roomData)
        setCurrentPage(1)
        setProvinces(provinceData)
        setAmenities(amenityData)
      } catch (err) {
        setError(err?.response?.data?.message || 'Không thể tải danh sách phòng.')
      } finally {
        setLoading(false)
      }
    }

    loadInitial()
  }, [])

  useEffect(() => {
    const loadDistricts = async () => {
      if (!filters.provinceId) {
        setDistricts([])
        return
      }

      try {
        const data = await getDistricts(filters.provinceId)
        setDistricts(data)
      } catch {
        setDistricts([])
      }
    }

    loadDistricts()
  }, [filters.provinceId])

  useEffect(() => {
    const loadWards = async () => {
      if (!filters.districtId) {
        setWards([])
        return
      }

      try {
        const data = await getWards(filters.districtId)
        setWards(data)
      } catch {
        setWards([])
      }
    }

    loadWards()
  }, [filters.districtId])

  const handleFilterChange = (field, value) => {
    setFilters((prev) => {
      if (field === 'provinceId') {
        return { ...prev, provinceId: value, districtId: '', wardId: '' }
      }

      if (field === 'districtId') {
        return { ...prev, districtId: value, wardId: '' }
      }

      return { ...prev, [field]: value }
    })
  }

  const toggleAmenity = (amenityId) => {
    setFilters((prev) => ({
      ...prev,
      amenityIds: prev.amenityIds.includes(amenityId)
        ? prev.amenityIds.filter((id) => id !== amenityId)
        : [...prev.amenityIds, amenityId],
    }))
  }

  const applyFilters = async (nextFilters, options = {}) => {
    setLoading(true)
    setError('')

    try {
      const roomData = await getRooms(buildRoomQuery(nextFilters))
      setRooms(roomData)
      setCurrentPage(1)
      setAppliedFilters(nextFilters)
      if (options.closePanel) {
        setIsFilterOpen(false)
      }
    } catch (err) {
      setError(err?.response?.data?.message || 'Không thể lọc danh sách phòng.')
    } finally {
      setLoading(false)
    }
  }

  const handleSearch = async (event) => {
    event.preventDefault()
    await applyFilters(filters)
  }

  const handleApplyFilterPanel = async () => {
    await applyFilters(filters, { closePanel: true })
  }

  const closeFilterPanel = () => {
    setFilters((prev) => ({ ...appliedFilters, q: prev.q }))
    setIsFilterOpen(false)
  }

  const resetFilters = async () => {
    setDistricts([])
    setWards([])
    setFilters(defaultFilters)
    setLoading(true)
    setError('')

    try {
      const roomData = await getRooms()
      setRooms(roomData)
      setCurrentPage(1)
      setAppliedFilters(defaultFilters)
      setIsFilterOpen(false)
    } catch (err) {
      setError(err?.response?.data?.message || 'Không thể tải lại danh sách phòng.')
    } finally {
      setLoading(false)
    }
  }

  return (
    <div className="room-search-page">
      <section className="listing-hero">
        <div className="listing-hero-copy">
          <span className="hero-badge">TLMT</span>
          <h1>Đây Là Trang Web Giúp Bạn Tìm Phòng Trọ Uy Tín Số 1 Thế Giới</h1>
          <p>TLMT không phải là một trang web mà là một đế chế by DLToan.</p>
          <div className="hero-search-note">
            Lọc theo khu vực, mức giá, diện tích và tiện ích để tìm phòng phù hợp nhanh hơn.
          </div>
        </div>
      </section>

      <section className="search-toolbar">
        <form className="search-toolbar-shell" onSubmit={handleSearch}>
          <label className="search-toolbar-input" htmlFor="room-search-q">
            <span className="search-toolbar-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="11" cy="11" r="6.5" stroke="currentColor" strokeWidth="1.8" />
                <path d="M16 16L21 21" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" />
              </svg>
            </span>
            <input
              id="room-search-q"
              value={filters.q}
              onChange={(event) => handleFilterChange('q', event.target.value)}
              placeholder="Tên phòng, mã phòng hoặc khu vực bạn muốn tìm..."
            />
            <button type="submit" className="search-toolbar-submit" disabled={loading}>
              {loading ? 'Đang tìm...' : 'Tìm kiếm'}
            </button>
          </label>

          <button
            type="button"
            className={`filter-toggle-btn${isFilterOpen ? ' active' : ''}`}
            onClick={() => setIsFilterOpen(true)}
          >
            <span>Bộ lọc</span>
            {activeFilterCount > 0 && <span className="filter-toggle-count">{activeFilterCount}</span>}
          </button>
        </form>
      </section>

      {isFilterOpen && (
        <div className="filter-overlay" onClick={closeFilterPanel}>
          <div className="filter-dialog" onClick={(event) => event.stopPropagation()}>
            <div className="filter-dialog-header">
              <div className="filter-dialog-title">
                <h2>Bộ lọc tìm phòng</h2>
                <p>Thiết lập đầy đủ tiêu chí rồi bấm áp dụng để cập nhật kết quả.</p>
              </div>
              <div className="filter-dialog-meta">
                <span className="filter-status-badge">
                  {countActiveFilters(filters) > 0 ? `${countActiveFilters(filters)} tiêu chí` : 'Chưa có tiêu chí'}
                </span>
                <button type="button" className="dialog-close" onClick={closeFilterPanel} aria-label="Đóng bộ lọc">
                  ×
                </button>
              </div>
            </div>

            <div className="filter-dialog-body">
              <section className="filter-section filter-section-wide">
                <div className="filter-section-head">
                  <h3>Từ khóa và khu vực</h3>
                  <p>Nhập từ khóa rồi chọn địa bàn để thu hẹp kết quả chính xác hơn.</p>
                </div>

                <label className="form-field">
                  <span>Từ khóa</span>
                  <input
                    value={filters.q}
                    onChange={(event) => handleFilterChange('q', event.target.value)}
                    placeholder="Tên phòng, mã phòng hoặc khu vực..."
                  />
                </label>

                <div className="form-grid one-col area-grid">
                  <label className="form-field">
                    <span>Tỉnh/Thành</span>
                    <select value={filters.provinceId} onChange={(event) => handleFilterChange('provinceId', event.target.value)}>
                      <option value="">Tất cả tỉnh/thành</option>
                      {provinces.map((province) => (
                        <option key={province.id} value={province.id}>{province.name}</option>
                      ))}
                    </select>
                  </label>

                  <label className="form-field">
                    <span>Quận/Huyện</span>
                    <select value={filters.districtId} onChange={(event) => handleFilterChange('districtId', event.target.value)} disabled={!filters.provinceId}>
                      <option value="">Tất cả quận/huyện</option>
                      {districts.map((district) => (
                        <option key={district.id} value={district.id}>{district.name}</option>
                      ))}
                    </select>
                  </label>
                </div>

                <label className="form-field">
                  <span>Phường/Xã</span>
                  <select value={filters.wardId} onChange={(event) => handleFilterChange('wardId', event.target.value)} disabled={!filters.districtId}>
                    <option value="">Tất cả phường/xã</option>
                    {wards.map((ward) => (
                      <option key={ward.id} value={ward.id}>{ward.name}</option>
                    ))}
                  </select>
                </label>
              </section>

              <section className="filter-section">
                <div className="filter-section-head">
                  <h3>Mức giá</h3>
                  <p>Thu hẹp theo ngân sách dự kiến.</p>
                </div>

                <div className="form-grid one-col">
                  <label className="form-field">
                    <span>Giá từ</span>
                    <input type="number" min="0" value={filters.minPrice} onChange={(event) => handleFilterChange('minPrice', event.target.value)} placeholder="1000000" />
                  </label>

                  <label className="form-field">
                    <span>Giá đến</span>
                    <input type="number" min="0" value={filters.maxPrice} onChange={(event) => handleFilterChange('maxPrice', event.target.value)} placeholder="5000000" />
                  </label>
                </div>
              </section>

              <section className="filter-section">
                <div className="filter-section-head">
                  <h3>Diện tích</h3>
                  <p>Chọn khoảng diện tích mong muốn.</p>
                </div>

                <div className="form-grid one-col">
                  <label className="form-field">
                    <span>Diện tích từ</span>
                    <input type="number" min="0" value={filters.minArea} onChange={(event) => handleFilterChange('minArea', event.target.value)} placeholder="15" />
                  </label>

                  <label className="form-field">
                    <span>Diện tích đến</span>
                    <input type="number" min="0" value={filters.maxArea} onChange={(event) => handleFilterChange('maxArea', event.target.value)} placeholder="35" />
                  </label>
                </div>
              </section>

              <section className="filter-section filter-section-wide">
                <div className="filter-section-head">
                  <h3>Tiện ích</h3>
                  <p>Chọn các nhu cầu quan trọng nhất.</p>
                </div>

                <div className="chip-grid chip-grid-scroll">
                  {amenities.map((amenity) => (
                    <button
                      key={amenity.id}
                      type="button"
                      className={`choice-chip${filters.amenityIds.includes(amenity.id) ? ' selected' : ''}`}
                      onClick={() => toggleAmenity(amenity.id)}
                    >
                      {amenity.name}
                    </button>
                  ))}
                </div>
              </section>
            </div>

            <div className="filter-dialog-actions">
              <button type="button" className="ghost-button" onClick={resetFilters}>
                Đặt lại
              </button>
              <button type="button" className="primary-button" onClick={handleApplyFilterPanel} disabled={loading}>
                {loading ? 'Đang lọc...' : 'Áp dụng bộ lọc'}
              </button>
            </div>
          </div>
        </div>
      )}

      <section className="rooms-panel room-results-panel">
        <div className="panel-heading panel-heading-inline">
          <div className="panel-heading-copy">
            <h2>Kết quả tìm phòng</h2>
            <p>Danh sách lấy từ Room API, mỗi phòng đều có thể mở trang chi tiết riêng.</p>
          </div>
          <div className="results-counter">
            {loading ? 'Đang tìm...' : `${rooms.length} phòng`}
          </div>
        </div>

        {error && <div className="alert error">{error}</div>}

        {loading ? (
          <div className="dashboard-empty">Đang tải danh sách phòng...</div>
        ) : rooms.length === 0 ? (
          <div className="dashboard-empty">Không tìm thấy phòng phù hợp với bộ lọc hiện tại.</div>
        ) : (
          <>
            <div className="room-grid">
              {paginatedRooms.map((room) => (
                <RoomCard key={room.id} room={room} />
              ))}
            </div>

            {totalPages > 1 && (
              <div className="rooms-pagination" aria-label="Phân trang danh sách phòng">
                <button
                  type="button"
                  className="pagination-button pagination-nav"
                  onClick={() => setCurrentPage((prev) => Math.max(prev - 1, 1))}
                  disabled={currentPage === 1}
                >
                  Trang trước
                </button>

                <div className="pagination-pages">
                  {paginationItems.map((item, index) => {
                    if (typeof item !== 'number') {
                      return (
                        <span key={`${item}-${index}`} className="pagination-ellipsis" aria-hidden="true">
                          ...
                        </span>
                      )
                    }

                    return (
                      <button
                        key={item}
                        type="button"
                        className={`pagination-button${item === currentPage ? ' active' : ''}`}
                        onClick={() => setCurrentPage(item)}
                      >
                        {item}
                      </button>
                    )
                  })}
                </div>

                <button
                  type="button"
                  className="pagination-button pagination-nav"
                  onClick={() => setCurrentPage((prev) => Math.min(prev + 1, totalPages))}
                  disabled={currentPage === totalPages}
                >
                  Trang sau
                </button>
              </div>
            )}
          </>
        )}
      </section>
    </div>
  )
}
