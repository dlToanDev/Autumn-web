// Trang AdminRoomsPage cho admin duyet/moderate phong dang dang tren he thong.
// Muc dich:
// - Xem toan bo phong cua cac landlord
// - Loc theo tinh trang/phong/chu tro
// - Duyet hoac cap nhat approvalStatus
import { useEffect, useMemo, useState } from 'react'
import { Link } from 'react-router-dom'
import DashboardHeroBanner from '../components/DashboardHeroBanner'
import { getAdminRooms, updateAdminRoomModeration } from '../api/adminApi'
import { formatCurrency, formatDateTime } from '../utils/rentalFormat'

function normalizeText(value) {
  return String(value || '').trim().toLowerCase()
}

function buildPropertyLabel(room) {
  return room.propertyName || `Nhà #${room.propertyId}`
}

export default function AdminRoomsPage() {
  const [rooms, setRooms] = useState([])
  const [keyword, setKeyword] = useState('')
  const [propertyFilter, setPropertyFilter] = useState('all')
  const [landlordFilter, setLandlordFilter] = useState('all')
  const [statusFilter, setStatusFilter] = useState('all')
  const [approvalFilter, setApprovalFilter] = useState('all')
  const [loading, setLoading] = useState(true)
  const [updatingRoomId, setUpdatingRoomId] = useState(0)
  const [message, setMessage] = useState('')
  const [error, setError] = useState('')

  // Admin lay mot danh sach room tong hop kem thong tin property + landlord.
  const loadRooms = async () => {
    const data = await getAdminRooms()
    const nextRooms = Array.isArray(data)
      ? [...data].sort((left, right) => new Date(right.updatedAt || 0) - new Date(left.updatedAt || 0))
      : []

    setRooms(nextRooms)
    return nextRooms
  }

  useEffect(() => {
    const loadInitial = async () => {
      setLoading(true)
      setError('')

      try {
        await loadRooms()
      } catch (err) {
        setError(err?.response?.data?.message || 'Không thể tải danh sách phòng toàn hệ thống.')
      } finally {
        setLoading(false)
      }
    }

    loadInitial()
  }, [])

  const propertyOptions = useMemo(() => {
    const optionMap = new Map()
    rooms.forEach((room) => {
      optionMap.set(String(room.propertyId), buildPropertyLabel(room))
    })

    return Array.from(optionMap.entries())
      .map(([id, label]) => ({ id, label }))
      .sort((left, right) => left.label.localeCompare(right.label, 'vi'))
  }, [rooms])

  const landlordOptions = useMemo(() => {
    const optionMap = new Map()
    rooms.forEach((room) => {
      optionMap.set(String(room.landlordId), room.landlordName || `Chủ trọ #${room.landlordId}`)
    })

    return Array.from(optionMap.entries())
      .map(([id, label]) => ({ id, label }))
      .sort((left, right) => left.label.localeCompare(right.label, 'vi'))
  }, [rooms])

  const stats = useMemo(() => ({
    total: rooms.length,
    pending: rooms.filter((room) => room.approvalStatus === 'pending').length,
    approved: rooms.filter((room) => room.approvalStatus === 'approved').length,
    rejected: rooms.filter((room) => room.approvalStatus === 'rejected').length,
    hidden: rooms.filter((room) => room.status === 'hidden').length,
    rented: rooms.filter((room) => room.status === 'rented').length,
  }), [rooms])

  const filteredRooms = useMemo(() => {
    const searchTerm = normalizeText(keyword)

    return rooms.filter((room) => {
      if (propertyFilter !== 'all' && String(room.propertyId) !== propertyFilter) return false
      if (landlordFilter !== 'all' && String(room.landlordId) !== landlordFilter) return false
      if (statusFilter !== 'all' && room.status !== statusFilter) return false
      if (approvalFilter !== 'all' && room.approvalStatus !== approvalFilter) return false

      if (!searchTerm) return true

      const haystack = [
        room.title,
        room.roomCode,
        room.propertyName,
        room.landlordName,
        room.fullAddress,
      ].map(normalizeText).join(' ')

      return haystack.includes(searchTerm)
    })
  }, [approvalFilter, keyword, landlordFilter, propertyFilter, rooms, statusFilter])

  const handleRoomUpdate = async (roomId, payload, successMessage) => {
    setUpdatingRoomId(roomId)
    setMessage('')
    setError('')

    try {
      const updatedRoom = await updateAdminRoomModeration(roomId, payload)
      setRooms((prev) => prev.map((room) => (
        room.id === updatedRoom.id ? updatedRoom : room
      )))
      setMessage(successMessage)
    } catch (err) {
      setError(err?.response?.data?.message || 'Không thể cập nhật trạng thái phòng.')
    } finally {
      setUpdatingRoomId(0)
    }
  }

  if (loading) {
    return (
      <div className="dashboard-page">
        <div className="dashboard-container">
          <div className="dashboard-empty">Đang tải danh sách phòng toàn hệ thống...</div>
        </div>
      </div>
    )
  }

  return (
    <div className="dashboard-page">
      <div className="dashboard-container room-manager-page">
        <DashboardHeroBanner
          title="Đây là trang quản lý phòng toàn hệ thống"
          description={[
            'Bạn có thể duyệt phòng, rà soát trạng thái hiển thị và kiểm tra dữ liệu của từng landlord.',
            'Nếu cần trao đổi nhanh về một phòng cụ thể, hãy mở hộp tin.',
          ]}
          action={{ to: '/messages', label: 'Mở hộp tin' }}
        />

        <div className="inline-actions">
          <Link to="/admin" className="ghost-button card-link-button">
            Về dashboard
          </Link>
          <Link to="/admin/users" className="primary-button card-link-button">
            Quản lý user
          </Link>
        </div>

        {message && <div className="alert success">{message}</div>}
        {error && <div className="alert error">{error}</div>}

        <div className="detail-summary-grid user-payment-stats">
          <div className="detail-summary-item">
            <span>Tổng phòng</span>
            <strong>{stats.total}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Chờ duyệt</span>
            <strong>{stats.pending}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Đã duyệt</span>
            <strong>{stats.approved}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Bị từ chối</span>
            <strong>{stats.rejected}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Đang ẩn</span>
            <strong>{stats.hidden}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Đang thuê</span>
            <strong>{stats.rented}</strong>
          </div>
        </div>

        <section className="dashboard-panel section-top-gap">
          <div className="panel-heading">
            <div>
              <h2>Bộ lọc phòng</h2>
              <p>Lọc nhanh theo bài đăng, nhà, chủ trọ và trạng thái quản trị.</p>
            </div>
          </div>

          <div className="form-grid four-cols admin-filter-grid">
            <label className="form-field">
              <span>Tìm nhanh</span>
              <input
                type="text"
                value={keyword}
                onChange={(event) => setKeyword(event.target.value)}
                placeholder="Tên phòng, mã phòng, địa chỉ..."
              />
            </label>

            <label className="form-field">
              <span>Nhà / khu trọ</span>
              <select value={propertyFilter} onChange={(event) => setPropertyFilter(event.target.value)}>
                <option value="all">Tất cả</option>
                {propertyOptions.map((property) => (
                  <option key={property.id} value={property.id}>{property.label}</option>
                ))}
              </select>
            </label>

            <label className="form-field">
              <span>Chủ trọ</span>
              <select value={landlordFilter} onChange={(event) => setLandlordFilter(event.target.value)}>
                <option value="all">Tất cả</option>
                {landlordOptions.map((landlord) => (
                  <option key={landlord.id} value={landlord.id}>{landlord.label}</option>
                ))}
              </select>
            </label>

            <label className="form-field">
              <span>Trạng thái phòng</span>
              <select value={statusFilter} onChange={(event) => setStatusFilter(event.target.value)}>
                <option value="all">Tất cả</option>
                <option value="available">Đang mở</option>
                <option value="reserved">Đã giữ chỗ</option>
                <option value="rented">Đang thuê</option>
                <option value="hidden">Đang ẩn</option>
              </select>
            </label>

            <label className="form-field">
              <span>Trạng thái duyệt</span>
              <select value={approvalFilter} onChange={(event) => setApprovalFilter(event.target.value)}>
                <option value="all">Tất cả</option>
                <option value="pending">Chờ duyệt</option>
                <option value="approved">Đã duyệt</option>
                <option value="rejected">Đã từ chối</option>
              </select>
            </label>
          </div>
        </section>

        <section className="dashboard-panel section-top-gap">
          <div className="panel-heading">
            <div>
              <h2>Danh sách phòng</h2>
              <p>{filteredRooms.length} phòng khớp bộ lọc hiện tại.</p>
            </div>
          </div>

          {filteredRooms.length === 0 ? (
            <div className="dashboard-empty">Không có phòng nào khớp bộ lọc.</div>
          ) : (
            <div className="table-shell">
              <table className="data-table">
                <thead>
                  <tr>
                    <th>Phòng</th>
                    <th>Nhà</th>
                    <th>Chủ trọ</th>
                    <th>Giá</th>
                    <th>Trạng thái</th>
                    <th>Duyệt</th>
                    <th>Cập nhật</th>
                    <th>Thao tác</th>
                  </tr>
                </thead>
                <tbody>
                  {filteredRooms.map((room) => {
                    const isUpdating = updatingRoomId === room.id

                    return (
                      <tr key={room.id}>
                        <td>
                          <div className="table-strong">{room.title}</div>
                          <div className="table-sub">Mã: {room.roomCode}</div>
                          <div className="table-sub">{room.roomType || 'Phòng trọ'}</div>
                        </td>
                        <td>
                          <div className="table-strong">{buildPropertyLabel(room)}</div>
                          <div className="table-sub">{room.fullAddress || room.addressLine || '---'}</div>
                        </td>
                        <td>
                          <div className="table-strong">{room.landlordName || '---'}</div>
                          <div className="table-sub">{room.landlordEmail || '---'}</div>
                          <div className="table-sub">{room.landlordPhone || '---'}</div>
                        </td>
                        <td>{formatCurrency(room.price)} đ</td>
                        <td>
                          <span className={`status-pill ${room.status}`}>{room.status}</span>
                        </td>
                        <td>
                          <span className={`status-pill ${room.approvalStatus}`}>{room.approvalStatus}</span>
                        </td>
                        <td>{formatDateTime(room.updatedAt)}</td>
                        <td>
                          <div className="table-action-wrap">
                            <button
                              type="button"
                              className="ghost-button compact"
                              disabled={isUpdating || room.approvalStatus === 'approved'}
                              onClick={() => handleRoomUpdate(
                                room.id,
                                { approvalStatus: 'approved' },
                                'Đã duyệt bài đăng phòng.',
                              )}
                            >
                              Duyệt
                            </button>
                            <button
                              type="button"
                              className="danger-btn mini"
                              disabled={isUpdating || room.approvalStatus === 'rejected'}
                              onClick={() => handleRoomUpdate(
                                room.id,
                                { approvalStatus: 'rejected' },
                                'Đã từ chối và ẩn bài đăng phòng.',
                              )}
                            >
                              Từ chối
                            </button>
                            <button
                              type="button"
                              className="ghost-button compact"
                              disabled={isUpdating || room.status === 'hidden'}
                              onClick={() => handleRoomUpdate(
                                room.id,
                                { status: 'hidden' },
                                'Đã ẩn bài đăng phòng.',
                              )}
                            >
                              Ẩn
                            </button>
                            <button
                              type="button"
                              className="ghost-button compact"
                              disabled={isUpdating || (room.status !== 'hidden' && room.approvalStatus === 'approved')}
                              onClick={() => handleRoomUpdate(
                                room.id,
                                { status: 'available', approvalStatus: 'approved' },
                                'Đã mở lại bài đăng phòng.',
                              )}
                            >
                              Mở lại
                            </button>
                            <Link to={`/rooms/${room.id}`} className="ghost-button compact card-link-button">
                              Xem
                            </Link>
                          </div>
                        </td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </div>
    </div>
  )
}
