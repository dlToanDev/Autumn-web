// Trang AdminLandlordApplicationsPage la noi admin duyet don dang ky chu tro.
// Muc dich:
// - Xem thong tin giay to va trang thai nop don
// - Theo doi fee payment dang ky landlord
// - Phe duyet hoac tu choi ho so
import { useEffect, useState } from 'react'
import { useNavigate } from 'react-router-dom'
import { getMe } from '../api/authApi'
import { markAdminPaymentPaid } from '../api/paymentApi'
import {
  getAdminLandlordApplicationById,
  getAdminLandlordApplications,
  reviewLandlordApplication,
} from '../api/landlordApplicationApi'

const statusOptions = [
  { value: '', label: 'Tất cả' },
  { value: 'pending', label: 'Chờ duyệt' },
  { value: 'approved', label: 'Đã duyệt' },
  { value: 'rejected', label: 'Đã từ chối' },
]

function formatDateTime(value) {
  if (!value) return '---'
  return new Date(value).toLocaleString('vi-VN')
}

function formatDateOnly(value) {
  if (!value) return '---'
  return new Date(value).toLocaleDateString('vi-VN')
}

function formatCurrency(value) {
  return Number(value || 0).toLocaleString('vi-VN')
}

function statusClass(status) {
  if (status === 'approved') return 'status-chip approved'
  if (status === 'rejected') return 'status-chip rejected'
  return 'status-chip pending'
}

function formatFeeStatusLabel(value) {
  const normalized = String(value || '').toLowerCase()
  if (normalized === 'pending') return 'Đã tạo QR, chờ chuyển khoản'
  if (normalized === 'waiting_confirm') return 'Đã gửi minh chứng, chờ admin xác nhận'
  if (normalized === 'success') return 'Đã xác nhận đóng phí'
  if (normalized === 'expired') return 'QR đã hết hạn'
  if (normalized === 'canceled') return 'Đã hủy'
  return 'Chưa tạo thanh toán phí'
}

export default function AdminLandlordApplicationsPage() {
  const navigate = useNavigate()
  // Page nay vua co danh sach, vua co panel chi tiet/duyet nen state hoi nhieu.
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState('')
  const [success, setSuccess] = useState('')
  const [statusFilter, setStatusFilter] = useState('pending')
  const [applications, setApplications] = useState([])
  const [selectedId, setSelectedId] = useState(null)
  const [detail, setDetail] = useState(null)
  const [reviewAction, setReviewAction] = useState('approve')
  const [rejectReason, setRejectReason] = useState('')
  const [submitting, setSubmitting] = useState(false)
  const [confirmingFee, setConfirmingFee] = useState(false)
  const [previewUrl, setPreviewUrl] = useState('')
  const [previewType, setPreviewType] = useState('image')

  const loadList = async (statusValue = statusFilter) => {
    const data = await getAdminLandlordApplications(statusValue)
    setApplications(data)
    if (!selectedId && data.length > 0) {
      setSelectedId(data[0].id)
    }
  }

  const loadDetail = async (id) => {
    if (!id) {
      setDetail(null)
      return
    }

    const data = await getAdminLandlordApplicationById(id)
    setDetail(data)
  }

  useEffect(() => {
    const token = localStorage.getItem('token')
    if (!token) {
      navigate('/login')
      return
    }

    const init = async () => {
      setLoading(true)
      setError('')
      try {
        // Trang admin chi lay du lieu qua layer api, khong viet URL truc tiep trong page.
        const me = await getMe()
        localStorage.setItem('user', JSON.stringify(me))
        if ((me.roleCode || '').toUpperCase() !== 'ADMIN') {
          navigate('/')
          return
        }

        await loadList('pending')
      } catch (err) {
        setError(err.response?.data?.message || 'Không thể tải danh sách hồ sơ.')
      } finally {
        setLoading(false)
      }
    }

    init()
  }, [navigate])

  useEffect(() => {
    if (!selectedId) {
      setDetail(null)
      return
    }

    const fetchDetail = async () => {
      try {
        await loadDetail(selectedId)
      } catch (err) {
        setError(err.response?.data?.message || 'Không thể tải chi tiết hồ sơ.')
      }
    }

    fetchDetail()
  }, [selectedId])

  const onChangeFilter = async (event) => {
    const nextStatus = event.target.value
    setStatusFilter(nextStatus)
    setSelectedId(null)
    setDetail(null)
    setError('')
    setSuccess('')
    try {
      await loadList(nextStatus)
    } catch (err) {
      setError(err.response?.data?.message || 'Không thể lọc hồ sơ.')
    }
  }

  const onReview = async (event) => {
    event.preventDefault()
    if (!detail) return

    setError('')
    setSuccess('')

    if (reviewAction === 'reject' && !rejectReason.trim()) {
      setError('Bạn phải nhập lý do từ chối.')
      return
    }

    setSubmitting(true)
    try {
      await reviewLandlordApplication(detail.id, {
        action: reviewAction,
        rejectReason: reviewAction === 'reject' ? rejectReason.trim() : null,
      })

      setSuccess(reviewAction === 'approve' ? 'Đã duyệt hồ sơ thành công.' : 'Đã từ chối hồ sơ.')
      setRejectReason('')
      await loadList(statusFilter)
      await loadDetail(detail.id)
    } catch (err) {
      setError(err.response?.data?.message || 'Thao tác duyệt hồ sơ thất bại.')
    } finally {
      setSubmitting(false)
    }
  }

  const onConfirmFeePayment = async () => {
    if (!detail?.registrationFeePaymentCode) return

    setConfirmingFee(true)
    setError('')
    setSuccess('')

    try {
      await markAdminPaymentPaid(detail.registrationFeePaymentCode)
      setSuccess('Đã xác nhận phí đăng ký chủ trọ thành công.')
      await loadList(statusFilter)
      await loadDetail(detail.id)
    } catch (err) {
      setError(err.response?.data?.message || 'Không thể xác nhận phí đăng ký chủ trọ.')
    } finally {
      setConfirmingFee(false)
    }
  }

  const getDocType = (url) => {
    const normalized = (url || '').trim().toLowerCase()
    if (normalized.startsWith('data:application/pdf') || normalized.endsWith('.pdf')) return 'pdf'
    return 'image'
  }

  const onOpenPreview = (url) => {
    const normalized = (url || '').trim()
    if (!normalized) return
    setPreviewType(getDocType(normalized))
    setPreviewUrl(normalized)
  }

  if (loading) {
    return (
      <div className="auth-wrapper">
        <div className="auth-container">
          <div className="loading-screen">
            <span className="spinner large"></span>
            <p>Đang tải danh sách hồ sơ...</p>
          </div>
        </div>
      </div>
    )
  }

  return (
    <div className="profile-wrapper">
      <div className="admin-application-layout">
        <section className="profile-card">
          <div className="profile-header">
            <h1>Admin duyệt hồ sơ chủ trọ</h1>
            <p>Chọn hồ sơ để xem giấy tờ rồi duyệt hoặc từ chối.</p>
          </div>

          {error && <div className="auth-error">{error}</div>}
          {success && <div className="auth-success">{success}</div>}

          <div className="filter-row">
            <label htmlFor="statusFilter">Lọc trạng thái</label>
            <select id="statusFilter" value={statusFilter} onChange={onChangeFilter}>
              {statusOptions.map((item) => (
                <option key={item.value || 'all'} value={item.value}>{item.label}</option>
              ))}
            </select>
          </div>

          <div className="application-list">
            {applications.length === 0 && <div className="empty-note">Không có hồ sơ phù hợp bộ lọc.</div>}
            {applications.map((item) => (
              <button
                key={item.id}
                type="button"
                className={`application-item${selectedId === item.id ? ' active' : ''}`}
                onClick={() => setSelectedId(item.id)}
              >
                <div>
                  <strong>#{item.id}</strong> - {item.userFullName}
                </div>
                <div>{item.userEmail || item.userPhone || '---'}</div>
                <div>Phí: {formatFeeStatusLabel(item.registrationFeePaymentStatus)}</div>
                <div className={statusClass(item.status)}>{item.status}</div>
              </button>
            ))}
          </div>
        </section>

        <section className="profile-card">
          {!detail ? (
            <div className="empty-note">Chọn một hồ sơ để xem chi tiết.</div>
          ) : (
            <>
              <div className="profile-header">
                <h2>Hồ sơ #{detail.id}</h2>
                <p>{detail.userFullName} - {detail.userEmail || detail.userPhone || '---'}</p>
              </div>

              <div className="applicant-card">
                <div className="applicant-avatar-wrap">
                  {detail.userAvatarUrl ? (
                    <img src={detail.userAvatarUrl} alt={detail.userFullName} className="applicant-avatar" />
                  ) : (
                    <div className="applicant-avatar applicant-avatar-fallback">
                      {detail.userFullName?.charAt(0)?.toUpperCase() || 'U'}
                    </div>
                  )}
                </div>
                <div className="applicant-info-grid">
                  <div><strong>Họ tên:</strong> {detail.userFullName || '---'}</div>
                  <div><strong>Email:</strong> {detail.userEmail || '---'}</div>
                  <div><strong>Số điện thoại:</strong> {detail.userPhone || '---'}</div>
                  <div><strong>Ngày sinh:</strong> {formatDateOnly(detail.userDateOfBirth)}</div>
                  <div><strong>Giới tính:</strong> {detail.userGender || '---'}</div>
                  <div><strong>Quê quán:</strong> {detail.userHometown || '---'}</div>
                  <div className="full-row"><strong>Địa chỉ:</strong> {detail.userAddress || '---'}</div>
                </div>
              </div>

              <div className="detail-grid">
                <div><strong>CCCD:</strong> {detail.cccdNumber}</div>
                <div><strong>Trạng thái:</strong> <span className={statusClass(detail.status)}>{detail.status}</span></div>
                <div><strong>Phí đăng ký:</strong> {formatCurrency(detail.registrationFeeAmount)} đ</div>
                <div><strong>Trạng thái phí:</strong> {formatFeeStatusLabel(detail.registrationFeePaymentStatus)}</div>
                <div><strong>Mã payment phí:</strong> {detail.registrationFeePaymentCode || '---'}</div>
                <div><strong>Phí đã xác nhận lúc:</strong> {formatDateTime(detail.registrationFeePaidAt)}</div>
                <div><strong>Nộp lúc:</strong> {formatDateTime(detail.createdAt)}</div>
                <div><strong>Duyệt lúc:</strong> {formatDateTime(detail.reviewedAt)}</div>
                <div><strong>Admin duyệt:</strong> {detail.reviewedByName || '---'}</div>
                <div><strong>Lý do từ chối:</strong> {detail.rejectReason || '---'}</div>
              </div>

              <div className="doc-grid">
                <button type="button" className="doc-card" onClick={() => onOpenPreview(detail.cccdFrontUrl)}>
                  <span>CCCD mặt trước</span>
                  <small>Xem tài liệu</small>
                </button>
                <button type="button" className="doc-card" onClick={() => onOpenPreview(detail.cccdBackUrl)}>
                  <span>CCCD mặt sau</span>
                  <small>Xem tài liệu</small>
                </button>
                {(detail.rentalDocumentUrls ?? []).map((docUrl, index) => (
                  <button
                    key={`${docUrl.slice(0, 30)}-${index}`}
                    type="button"
                    className="doc-card"
                    onClick={() => onOpenPreview(docUrl)}
                  >
                    <span>Giấy tờ nhà trọ #{index + 1}</span>
                    <small>Xem tài liệu</small>
                  </button>
                ))}
                {detail.registrationFeeProofImageUrl && (
                  <button
                    type="button"
                    className="doc-card"
                    onClick={() => onOpenPreview(detail.registrationFeeProofImageUrl)}
                  >
                    <span>Minh chứng đóng phí</span>
                    <small>Xem ảnh chuyển khoản</small>
                  </button>
                )}
              </div>

              {detail.note && (
                <div className="note-box">
                  <strong>Ghi chú user:</strong>
                  <p>{detail.note}</p>
                </div>
              )}

              <div className="status-box">
                <div>
                  <strong>Phí đăng ký chủ trọ:</strong> {formatFeeStatusLabel(detail.registrationFeePaymentStatus)}
                </div>
                {detail.registrationFeeProofSubmittedAt && (
                  <div className="status-meta">
                    <span>Người dùng gửi minh chứng lúc: {formatDateTime(detail.registrationFeeProofSubmittedAt)}</span>
                    <span>QR hết hạn lúc: {formatDateTime(detail.registrationFeeExpiredAt)}</span>
                  </div>
                )}
                {detail.registrationFeePaymentStatus === 'waiting_confirm' && (
                  <div className="inline-actions">
                    <button type="button" className="ghost-button" onClick={onConfirmFeePayment} disabled={confirmingFee}>
                      {confirmingFee ? 'Đang xác nhận phí...' : 'Xác nhận đã thu phí'}
                    </button>
                  </div>
                )}
              </div>

              {detail.status === 'pending' ? (
                <form className="auth-form" onSubmit={onReview}>
                  <div className="form-row">
                    <div className="form-group">
                      <label htmlFor="reviewAction">Hành động</label>
                      <select id="reviewAction" value={reviewAction} onChange={(e) => setReviewAction(e.target.value)}>
                        <option value="approve">Duyệt hồ sơ</option>
                        <option value="reject">Từ chối hồ sơ</option>
                      </select>
                    </div>
                    <div className="form-group">
                      <label htmlFor="rejectReason">Lý do từ chối</label>
                      <input
                        id="rejectReason"
                        value={rejectReason}
                        onChange={(e) => setRejectReason(e.target.value)}
                        placeholder="Bắt buộc khi chọn từ chối"
                        disabled={reviewAction !== 'reject'}
                      />
                    </div>
                  </div>

                  <button type="submit" className="auth-btn" disabled={submitting}>
                    {submitting ? 'Đang xử lý...' : 'Xác nhận'}
                  </button>
                </form>
              ) : (
                <div className="empty-note">Hồ sơ đã xử lý, không thể duyệt lại.</div>
              )}
            </>
          )}
        </section>
      </div>

      {previewUrl && (
        <div className="doc-preview-backdrop" onClick={() => setPreviewUrl('')}>
          <div className="doc-preview-modal" onClick={(event) => event.stopPropagation()}>
            <div className="doc-preview-header">
              <strong>Xem tài liệu</strong>
              <div className="doc-preview-actions">
                <a href={previewUrl} target="_blank" rel="noreferrer" className="doc-preview-link">Mở tab mới</a>
                <button type="button" className="danger-btn mini" onClick={() => setPreviewUrl('')}>Đóng</button>
              </div>
            </div>
            <div className="doc-preview-body">
              {previewType === 'pdf' ? (
                <iframe title="preview-pdf" src={previewUrl} className="doc-preview-frame" />
              ) : (
                <img src={previewUrl} alt="preview" className="doc-preview-image" />
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  )
}
