// Trang AdminUsersPage giup admin quan ly user toan he thong.
// Chuc nang chinh:
// - Tai danh sach users
// - Loc theo role, status, cau hinh thanh toan
// - Khoa/mo khoa user
import { useEffect, useMemo, useState } from 'react'
import { Link } from 'react-router-dom'
import DashboardHeroBanner from '../components/DashboardHeroBanner'
import { getAdminUsers, updateAdminUserStatus } from '../api/adminApi'
import { getStoredUser } from '../utils/auth'
import { formatDateTime } from '../utils/rentalFormat'

function formatRoleLabel(value) {
  const normalized = String(value || '').toUpperCase()
  if (normalized === 'ADMIN') return 'Admin'
  if (normalized === 'LANDLORD') return 'Chủ trọ'
  if (normalized === 'USER') return 'Người thuê'
  return value || '---'
}

function formatUserStatusLabel(value) {
  const normalized = String(value || '').toLowerCase()
  if (normalized === 'active') return 'Đang hoạt động'
  if (normalized === 'inactive') return 'Tạm ngưng'
  if (normalized === 'locked') return 'Đã khóa'
  return value || '---'
}

function normalizeText(value) {
  return String(value || '').trim().toLowerCase()
}

export default function AdminUsersPage() {
  const currentUser = getStoredUser()
  const [users, setUsers] = useState([])
  const [keyword, setKeyword] = useState('')
  const [roleFilter, setRoleFilter] = useState('all')
  const [statusFilter, setStatusFilter] = useState('all')
  const [paymentConfigFilter, setPaymentConfigFilter] = useState('all')
  const [loading, setLoading] = useState(true)
  const [updatingUserId, setUpdatingUserId] = useState(0)
  const [message, setMessage] = useState('')
  const [error, setError] = useState('')

  // Danh sach nay la nguon du lieu goc cho tat ca bo loc/search ben duoi.
  const loadUsers = async () => {
    const data = await getAdminUsers()
    const nextUsers = Array.isArray(data)
      ? [...data].sort((left, right) => new Date(right.createdAt || 0) - new Date(left.createdAt || 0))
      : []

    setUsers(nextUsers)
    return nextUsers
  }

  useEffect(() => {
    const loadInitial = async () => {
      setLoading(true)
      setError('')

      try {
        await loadUsers()
      } catch (err) {
        setError(err?.response?.data?.message || 'Không thể tải danh sách user hệ thống.')
      } finally {
        setLoading(false)
      }
    }

    loadInitial()
  }, [])

  const stats = useMemo(() => ({
    total: users.length,
    active: users.filter((user) => user.status === 'active').length,
    locked: users.filter((user) => user.status === 'locked').length,
    landlords: users.filter((user) => user.roleCode === 'LANDLORD').length,
    tenants: users.filter((user) => user.roleCode === 'USER').length,
    paymentConfigured: users.filter((user) => user.hasPaymentConfig).length,
  }), [users])

  const filteredUsers = useMemo(() => {
    const searchTerm = normalizeText(keyword)

    return users.filter((user) => {
      if (roleFilter !== 'all' && user.roleCode !== roleFilter) return false
      if (statusFilter !== 'all' && user.status !== statusFilter) return false

      if (paymentConfigFilter === 'configured' && !user.hasPaymentConfig) return false
      if (paymentConfigFilter === 'missing' && user.hasPaymentConfig) return false

      if (!searchTerm) return true

      const haystack = [
        user.fullName,
        user.email,
        user.phone,
        user.roleCode,
      ].map(normalizeText).join(' ')

      return haystack.includes(searchTerm)
    })
  }, [keyword, paymentConfigFilter, roleFilter, statusFilter, users])

  const handleChangeStatus = async (userId, nextStatus) => {
    setUpdatingUserId(userId)
    setMessage('')
    setError('')

    try {
      const updatedUser = await updateAdminUserStatus(userId, nextStatus)
      setUsers((prev) => prev.map((user) => (
        user.id === updatedUser.id ? updatedUser : user
      )))
      setMessage('Đã cập nhật trạng thái user.')
    } catch (err) {
      setError(err?.response?.data?.message || 'Không thể cập nhật trạng thái user.')
    } finally {
      setUpdatingUserId(0)
    }
  }

  if (loading) {
    return (
      <div className="dashboard-page">
        <div className="dashboard-container">
          <div className="dashboard-empty">Đang tải danh sách user toàn hệ thống...</div>
        </div>
      </div>
    )
  }

  return (
    <div className="dashboard-page">
      <div className="dashboard-container room-manager-page">
        <DashboardHeroBanner
          title="Đây là trang quản lý người dùng toàn hệ thống"
          description={[
            'Bạn có thể lọc, kiểm tra trạng thái và xử lý tài khoản theo từng vai trò trên một màn hình.',
            'Nếu cần trao đổi nhanh với user hoặc landlord, hãy mở hộp tin.',
          ]}
          action={{ to: '/messages', label: 'Mở hộp tin' }}
        />

        <div className="inline-actions">
          <Link to="/admin" className="ghost-button card-link-button">
            Về dashboard
          </Link>
          <Link to="/admin/rooms" className="primary-button card-link-button">
            Quản lý phòng hệ thống
          </Link>
        </div>

        {message && <div className="alert success">{message}</div>}
        {error && <div className="alert error">{error}</div>}

        <div className="detail-summary-grid user-payment-stats">
          <div className="detail-summary-item">
            <span>Tổng user</span>
            <strong>{stats.total}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Đang hoạt động</span>
            <strong>{stats.active}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Bị khóa</span>
            <strong>{stats.locked}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Chủ trọ</span>
            <strong>{stats.landlords}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Người thuê</span>
            <strong>{stats.tenants}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Đã cấu hình VietQR</span>
            <strong>{stats.paymentConfigured}</strong>
          </div>
        </div>

        <section className="dashboard-panel section-top-gap">
          <div className="panel-heading">
            <div>
              <h2>Bộ lọc user</h2>
              <p>Lọc theo tên, email, số điện thoại, vai trò và trạng thái tài khoản.</p>
            </div>
          </div>

          <div className="form-grid four-cols admin-filter-grid">
            <label className="form-field">
              <span>Tìm nhanh</span>
              <input
                type="text"
                value={keyword}
                onChange={(event) => setKeyword(event.target.value)}
                placeholder="Tên, email, số điện thoại..."
              />
            </label>

            <label className="form-field">
              <span>Vai trò</span>
              <select value={roleFilter} onChange={(event) => setRoleFilter(event.target.value)}>
                <option value="all">Tất cả</option>
                <option value="ADMIN">Admin</option>
                <option value="LANDLORD">Chủ trọ</option>
                <option value="USER">Người thuê</option>
              </select>
            </label>

            <label className="form-field">
              <span>Trạng thái</span>
              <select value={statusFilter} onChange={(event) => setStatusFilter(event.target.value)}>
                <option value="all">Tất cả</option>
                <option value="active">Đang hoạt động</option>
                <option value="inactive">Tạm ngưng</option>
                <option value="locked">Đã khóa</option>
              </select>
            </label>

            <label className="form-field">
              <span>VietQR</span>
              <select value={paymentConfigFilter} onChange={(event) => setPaymentConfigFilter(event.target.value)}>
                <option value="all">Tất cả</option>
                <option value="configured">Đã cấu hình</option>
                <option value="missing">Chưa cấu hình</option>
              </select>
            </label>
          </div>
        </section>

        <section className="dashboard-panel section-top-gap">
          <div className="panel-heading">
            <div>
              <h2>Danh sách user</h2>
              <p>{filteredUsers.length} user khớp bộ lọc hiện tại.</p>
            </div>
          </div>

          {filteredUsers.length === 0 ? (
            <div className="dashboard-empty">Không có user nào khớp bộ lọc.</div>
          ) : (
            <div className="table-shell">
              <table className="data-table">
                <thead>
                  <tr>
                    <th>User</th>
                    <th>Liên hệ</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Cấu hình</th>
                    <th>Tạo lúc</th>
                    <th>Thao tác</th>
                  </tr>
                </thead>
                <tbody>
                  {filteredUsers.map((user) => {
                    const isCurrentAdmin = Number(user.id) === Number(currentUser?.id || 0)
                    const isUpdating = updatingUserId === user.id

                    return (
                      <tr key={user.id}>
                        <td>
                          <div className="table-strong">{user.fullName}</div>
                          <div className="table-sub">ID: {user.id}</div>
                        </td>
                        <td>
                          <div className="table-sub">{user.email || '---'}</div>
                          <div className="table-sub">{user.phone || '---'}</div>
                        </td>
                        <td>{formatRoleLabel(user.roleCode)}</td>
                        <td>
                          <span className={`status-pill ${user.status}`}>{formatUserStatusLabel(user.status)}</span>
                        </td>
                        <td>
                          <div className="table-sub">{user.isVerified ? 'Đã xác minh' : 'Chưa xác minh'}</div>
                          <div className="table-sub">{user.hasPaymentConfig ? 'Đã có VietQR' : 'Chưa có VietQR'}</div>
                        </td>
                        <td>{formatDateTime(user.createdAt)}</td>
                        <td>
                          <div className="table-action-wrap">
                            <button
                              type="button"
                              className="ghost-button compact"
                              disabled={isUpdating || isCurrentAdmin || user.status === 'active'}
                              onClick={() => handleChangeStatus(user.id, 'active')}
                            >
                              Kích hoạt
                            </button>
                            <button
                              type="button"
                              className="ghost-button compact"
                              disabled={isUpdating || isCurrentAdmin || user.status === 'inactive'}
                              onClick={() => handleChangeStatus(user.id, 'inactive')}
                            >
                              Tạm ngưng
                            </button>
                            <button
                              type="button"
                              className="danger-btn mini"
                              disabled={isUpdating || isCurrentAdmin || user.status === 'locked'}
                              onClick={() => handleChangeStatus(user.id, 'locked')}
                            >
                              Khóa
                            </button>
                            {isCurrentAdmin && <span className="table-sub">Bạn</span>}
                          </div>
                        </td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </div>
    </div>
  )
}
