// Trang UserPaymentsPage la lich su thanh toan cua nguoi thue.
// Tu day user co the mo lai QR, xem trang thai, va xem tong quan cac khoan da/chua thanh toan.
import { useEffect, useMemo, useState } from 'react'
import { Link } from 'react-router-dom'
import DashboardHeroBanner from '../components/DashboardHeroBanner'
import { getMyContracts } from '../api/contractApi'
import { getMyPayments, getPaymentByCode } from '../api/paymentApi'
import PaymentQrModal from '../components/PaymentQrModal'
import {
  formatRentBillingLabel,
  getCurrentRentBillingPeriod,
  isContractActiveForBillingPeriod,
  isDueDatePassed,
  isRentPaymentSuccess,
  mapBillingPaymentsByBooking,
} from '../utils/rentBilling'
import { formatCurrency, formatDateTime } from '../utils/rentalFormat'

function formatPaymentStatusLabel(value) {
  const normalized = String(value || '').toLowerCase()
  if (normalized === 'pending') return 'Đang chờ thanh toán'
  if (normalized === 'waiting_confirm') return 'Chờ bên nhận xác nhận'
  if (normalized === 'success') return 'Đã xác nhận thanh toán'
  if (normalized === 'failed') return 'Thanh toán thất bại'
  if (normalized === 'canceled') return 'Đã hủy'
  if (normalized === 'expired') return 'QR đã hết hạn'
  return value || '---'
}

function formatPaymentTypeLabel(value) {
  const normalized = String(value || '').toLowerCase()
  if (normalized === 'deposit') return 'Tiền cọc'
  if (normalized === 'rent') return 'Tiền thuê'
  if (normalized === 'service') return 'Phí dịch vụ'
  if (normalized === 'listing_fee') return 'Phí đăng tin'
  return value || '---'
}

function isPaidStatus(status) {
  return String(status || '').toLowerCase() === 'success'
}

function sumAmount(payments) {
  return payments.reduce((total, payment) => total + Number(payment.amount || 0), 0)
}

function getCurrentRentBillTone(payment, isOverdue) {
  const normalized = String(payment?.status || '').toLowerCase()
  if (normalized === 'success') return 'success'
  if (normalized === 'waiting_confirm') return 'waiting_confirm'
  if (normalized === 'pending') return 'pending'
  if (normalized === 'expired') return 'expired'
  return isOverdue ? 'due' : 'missing'
}

function getCurrentRentBillLabel(payment, isOverdue) {
  const normalized = String(payment?.status || '').toLowerCase()
  if (normalized === 'success') return 'Đã xác nhận thanh toán'
  if (normalized === 'waiting_confirm') return 'Đã gửi minh chứng, chờ xác nhận'
  if (normalized === 'pending') return 'Đã có QR, chờ bạn thanh toán'
  if (normalized === 'expired') return 'QR tháng này đã hết hạn'
  return isOverdue ? 'Đã tới hạn nhưng chủ trọ chưa tạo QR' : 'Đang chờ chủ trọ tạo QR'
}

export default function UserPaymentsPage() {
  const [payments, setPayments] = useState([])
  const [contracts, setContracts] = useState([])
  const [selectedPayment, setSelectedPayment] = useState(null)
  const [statusFilter, setStatusFilter] = useState('all')
  const [typeFilter, setTypeFilter] = useState('all')
  const [loading, setLoading] = useState(true)
  const [openingCode, setOpeningCode] = useState('')
  const [refreshing, setRefreshing] = useState(false)
  const [message, setMessage] = useState('')
  const [error, setError] = useState('')
  const [paymentError, setPaymentError] = useState('')
  const billingPeriod = useMemo(() => getCurrentRentBillingPeriod(), [])

  // stats phuc vu cac card tong hop ben tren, khong anh huong du lieu goc.
  const stats = useMemo(() => ({
    total: payments.length,
    pendingCount: payments.filter((payment) => !isPaidStatus(payment.status)).length,
    successCount: payments.filter((payment) => isPaidStatus(payment.status)).length,
    unpaidAmount: sumAmount(payments.filter((payment) => !isPaidStatus(payment.status))),
    paidAmount: sumAmount(payments.filter((payment) => isPaidStatus(payment.status))),
    expiredCount: payments.filter((payment) => String(payment.status).toLowerCase() === 'expired').length,
  }), [payments])

  const filteredPayments = useMemo(() => {
    return payments.filter((payment) => {
      const status = String(payment.status || '').toLowerCase()
      const paymentType = String(payment.paymentType || '').toLowerCase()

      if (statusFilter === 'paid' && status !== 'success') return false
      if (statusFilter === 'unpaid' && status === 'success') return false
      if (typeFilter !== 'all' && paymentType !== typeFilter) return false

      return true
    })
  }, [payments, statusFilter, typeFilter])

  const currentRentPaymentMap = useMemo(
    () => mapBillingPaymentsByBooking(payments, billingPeriod.year, billingPeriod.month),
    [billingPeriod.month, billingPeriod.year, payments],
  )

  const currentRentBills = useMemo(() => {
    return contracts
      .filter((contract) => isContractActiveForBillingPeriod(contract, billingPeriod.year, billingPeriod.month))
      .map((contract) => {
        const currentPayment = currentRentPaymentMap.get(Number(contract.bookingRequestId)) || null
        const isCurrentRentPaid = isRentPaymentSuccess(currentPayment?.status)
        const isOverdue = !isCurrentRentPaid && isDueDatePassed(billingPeriod.dueDate)

        return {
          ...contract,
          currentPayment,
          dueDate: billingPeriod.dueDate,
          isCurrentRentPaid,
          isOverdue,
        }
      })
      .sort((left, right) => Number(right.isOverdue) - Number(left.isOverdue) || Number(left.isCurrentRentPaid) - Number(right.isCurrentRentPaid))
  }, [billingPeriod.dueDate, billingPeriod.month, billingPeriod.year, contracts, currentRentPaymentMap])

  const rentBillStats = useMemo(() => ({
    activeContracts: currentRentBills.length,
    paidThisMonth: currentRentBills.filter((item) => item.isCurrentRentPaid).length,
    dueThisMonth: currentRentBills.filter((item) => !item.isCurrentRentPaid).length,
    dueAmount: currentRentBills
      .filter((item) => !item.isCurrentRentPaid)
      .reduce((total, item) => total + Number(item.currentPayment?.amount || item.monthlyRent || 0), 0),
  }), [currentRentBills])

  const loadPayments = async () => {
    const data = await getMyPayments()
    const nextPayments = Array.isArray(data)
      ? [...data].sort((firstPayment, secondPayment) => new Date(secondPayment.createdAt || 0) - new Date(firstPayment.createdAt || 0))
      : []

    setPayments(nextPayments)
    return nextPayments
  }

  const loadContracts = async () => {
    const data = await getMyContracts()
    const nextContracts = Array.isArray(data) ? data : []
    setContracts(nextContracts)
    return nextContracts
  }

  useEffect(() => {
    const loadInitial = async () => {
      setLoading(true)
      setError('')

      try {
        await Promise.all([loadPayments(), loadContracts()])
      } catch (err) {
        setError(err?.response?.data?.message || 'Không thể tải danh sách thanh toán.')
      } finally {
        setLoading(false)
      }
    }

    loadInitial()
  }, [])

  useEffect(() => {
    const paymentCode = selectedPayment?.paymentCode
    const normalizedStatus = String(selectedPayment?.status || '').toLowerCase()

    if (!paymentCode || (normalizedStatus !== 'pending' && normalizedStatus !== 'waiting_confirm')) {
      return undefined
    }

    const intervalId = window.setInterval(async () => {
      try {
        const latestPayment = await getPaymentByCode(paymentCode)
        setSelectedPayment(latestPayment)
        setPayments((prev) => prev.map((payment) => (
          payment.paymentCode === latestPayment.paymentCode ? latestPayment : payment
        )))
      } catch {
        // Cho phép người dùng tự refresh nếu polling thất bại.
      }
    }, 10000)

    return () => window.clearInterval(intervalId)
  }, [selectedPayment?.paymentCode, selectedPayment?.status])

  const openPayment = async (paymentCode) => {
    if (!paymentCode) return

    setOpeningCode(paymentCode)
    setPaymentError('')
    setMessage('')

    try {
      const payment = await getPaymentByCode(paymentCode)
      setSelectedPayment(payment)
      setPayments((prev) => {
        const exists = prev.some((item) => item.paymentCode === payment.paymentCode)
        return exists
          ? prev.map((item) => (item.paymentCode === payment.paymentCode ? payment : item))
          : [payment, ...prev]
      })
    } catch (err) {
      setPaymentError(err?.response?.data?.message || 'Không thể mở chi tiết thanh toán.')
    } finally {
      setOpeningCode('')
    }
  }

  const refreshSelectedPayment = async () => {
    if (!selectedPayment?.paymentCode) return

    setRefreshing(true)
    setPaymentError('')

    try {
      const payment = await getPaymentByCode(selectedPayment.paymentCode)
      setSelectedPayment(payment)
      setPayments((prev) => {
        const exists = prev.some((item) => item.paymentCode === payment.paymentCode)
        return exists
          ? prev.map((item) => (item.paymentCode === payment.paymentCode ? payment : item))
          : [payment, ...prev]
      })
      setMessage('Đã cập nhật trạng thái thanh toán mới nhất.')
    } catch (err) {
      setPaymentError(err?.response?.data?.message || 'Không thể kiểm tra trạng thái thanh toán.')
    } finally {
      setRefreshing(false)
    }
  }

  const handlePaymentChanged = (payment) => {
    setSelectedPayment(payment)
    setPayments((prev) => {
      const exists = prev.some((item) => item.paymentCode === payment.paymentCode)
      return exists
        ? prev.map((item) => (item.paymentCode === payment.paymentCode ? payment : item))
        : [payment, ...prev]
    })
    setMessage('Đã gửi ảnh minh chứng chuyển khoản. Hãy chờ bên nhận xác nhận.')
  }

  const handlePaymentDeleted = async (payment) => {
    setPayments((prev) => prev.filter((item) => item.paymentCode !== payment.paymentCode))
    setSelectedPayment(null)
    setRefreshing(false)
    setPaymentError('')
    setMessage('Đã xóa QR hết hạn khỏi danh sách của bạn.')
  }

  if (loading) {
    return (
      <div className="dashboard-page">
        <div className="dashboard-container">
          <div className="dashboard-empty">Đang tải trang thanh toán của bạn...</div>
        </div>
      </div>
    )
  }

  return (
    <div className="dashboard-page">
      <div className="dashboard-container room-manager-page">
        <DashboardHeroBanner
          title="Đây là trang thanh toán tiền thuê và QR của bạn"
          description={[
            `Tiền thuê kỳ ${formatRentBillingLabel(billingPeriod.year, billingPeriod.month)} được nhắc hạn vào ngày 05 hằng tháng. Nếu chủ trọ đã tạo QR, bạn có thể mở và thanh toán ngay tại đây.`,
            'Nếu tới hạn mà vẫn chưa có QR hoặc payment chưa khớp, hãy nhắn chủ trọ để được hỗ trợ.',
          ]}
          action={{ to: '/messages', label: 'Nhắn chủ trọ' }}
        />

        <div className="detail-summary-grid user-payment-stats">
          <div className="detail-summary-item">
            <span>Tổng payment</span>
            <strong>{stats.total}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Chưa thanh toán</span>
            <strong>{stats.pendingCount}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Payment đã thanh toán</span>
            <strong>{stats.successCount}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Cần thanh toán</span>
            <strong>{formatCurrency(stats.unpaidAmount)} đ</strong>
          </div>
          <div className="detail-summary-item">
            <span>Tổng đã thanh toán</span>
            <strong>{formatCurrency(stats.paidAmount)} đ</strong>
          </div>
          <div className="detail-summary-item">
            <span>Đã hết hạn</span>
            <strong>{stats.expiredCount}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Hợp đồng còn hiệu lực</span>
            <strong>{rentBillStats.activeContracts}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Kỳ tháng này đã trả</span>
            <strong>{rentBillStats.paidThisMonth}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Kỳ tháng này chưa xong</span>
            <strong>{rentBillStats.dueThisMonth}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Cần trả kỳ này</span>
            <strong>{formatCurrency(rentBillStats.dueAmount)} đ</strong>
          </div>
        </div>

        {message && <div className="alert success">{message}</div>}
        {error && <div className="alert error">{error}</div>}
        {paymentError && !selectedPayment && <div className="alert error">{paymentError}</div>}

        <section className="dashboard-panel rent-billing-panel">
          <div className="room-toolbar">
            <div>
              <h2>Tiền thuê kỳ hiện tại</h2>
              <p>{`Hạn thanh toán chung của kỳ này là ngày ${billingPeriod.dueDate.toLocaleDateString('vi-VN')}. Nếu QR chưa xuất hiện, bạn cần nhắn chủ trọ tạo mã mới.`}</p>
            </div>
          </div>

          {currentRentBills.length === 0 ? (
            <div className="dashboard-empty">
              Bạn chưa có hợp đồng thuê nào còn hiệu lực trong kỳ {formatRentBillingLabel(billingPeriod.year, billingPeriod.month)}.
            </div>
          ) : (
            <div className="rent-billing-grid">
              {currentRentBills.map((bill) => (
                <article key={bill.id} className={`rent-billing-card ${getCurrentRentBillTone(bill.currentPayment, bill.isOverdue)}`}>
                  <div className="rent-billing-card-top">
                    <div>
                      <span className="rent-billing-kicker">{formatRentBillingLabel(billingPeriod.year, billingPeriod.month)}</span>
                      <h3>{bill.roomTitle}</h3>
                      <p>{bill.propertyName}</p>
                    </div>
                    <span className={`status-pill ${getCurrentRentBillTone(bill.currentPayment, bill.isOverdue)}`}>
                      {getCurrentRentBillLabel(bill.currentPayment, bill.isOverdue)}
                    </span>
                  </div>

                  <div className="rent-billing-amount">
                    <span>Tiền thuê tháng này</span>
                    <strong>{formatCurrency(bill.currentPayment?.amount || bill.monthlyRent)} đ</strong>
                  </div>

                  <div className="rent-billing-meta">
                    <span>Hạn thanh toán: {bill.dueDate.toLocaleDateString('vi-VN')}</span>
                    <span>Hợp đồng: {bill.contractCode}</span>
                    <span>
                      {bill.currentPayment
                        ? `QR cập nhật: ${formatDateTime(bill.currentPayment.createdAt)}`
                        : 'Chủ trọ chưa phát hành QR kỳ này'}
                    </span>
                  </div>

                  <div className="table-actions">
                    {bill.currentPayment ? (
                      <button
                        type="button"
                        className={bill.isCurrentRentPaid ? 'success-button compact' : bill.isOverdue ? 'danger-button compact' : 'primary-button compact'}
                        disabled={openingCode === bill.currentPayment.paymentCode}
                        onClick={() => openPayment(bill.currentPayment.paymentCode)}
                      >
                        {openingCode === bill.currentPayment.paymentCode ? 'Đang mở...' : 'Mở QR tháng này'}
                      </button>
                    ) : (
                      <Link to="/messages" className="ghost-button compact rent-billing-link">
                        Nhắn chủ trọ tạo QR
                      </Link>
                    )}
                    <Link to="/user/contracts" className="ghost-button compact rent-billing-link">
                      Xem hợp đồng
                    </Link>
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>

        <section className="dashboard-panel">
          <div className="room-toolbar">
            <div>
              <h2>Theo dõi payment</h2>
              <p>Lọc nhanh payment đã thanh toán hoặc chưa thanh toán để xem còn bao nhiêu tiền cần xử lý.</p>
            </div>
          </div>

          <div className="booking-filter-bar">
            <label className="form-field">
              <span>Trạng thái</span>
              <select value={statusFilter} onChange={(event) => setStatusFilter(event.target.value)}>
                <option value="all">Tất cả</option>
                <option value="unpaid">Chưa thanh toán</option>
                <option value="paid">Đã thanh toán</option>
              </select>
            </label>

            <label className="form-field">
              <span>Loại payment</span>
              <select value={typeFilter} onChange={(event) => setTypeFilter(event.target.value)}>
                <option value="all">Tất cả</option>
                <option value="deposit">Tiền cọc</option>
                <option value="rent">Tiền thuê</option>
                <option value="service">Phí dịch vụ</option>
                <option value="listing_fee">Phí đăng tin</option>
              </select>
            </label>
          </div>

          {filteredPayments.length === 0 ? (
            <div className="dashboard-empty">
              {payments.length === 0
                ? 'Chủ trọ chưa gửi payment nào cho bạn.'
                : 'Không có payment nào khớp với bộ lọc hiện tại.'}
            </div>
          ) : (
            <div className="table-shell">
              <table className="data-table">
                <thead>
                  <tr>
                    <th>STT</th>
                    <th>Mã payment</th>
                    <th>Phòng</th>
                    <th>Loại</th>
                    <th>Số tiền</th>
                    <th>Trạng thái</th>
                    <th>Thời gian</th>
                    <th>Thao tác</th>
                  </tr>
                </thead>
                <tbody>
                  {filteredPayments.map((payment, index) => (
                    <tr key={payment.paymentCode}>
                      <td>{index + 1}</td>
                      <td>
                        <strong>{payment.paymentCode}</strong>
                        <div className="table-sub">Booking: {payment.bookingCode || '---'}</div>
                      </td>
                      <td>
                        <strong>{payment.roomTitle || '---'}</strong>
                        <div className="table-sub">{payment.propertyName || '---'}</div>
                      </td>
                      <td>{formatPaymentTypeLabel(payment.paymentType)}</td>
                      <td>{formatCurrency(payment.amount)} đ</td>
                      <td>
                        <span className={`status-pill ${payment.status}`}>{formatPaymentStatusLabel(payment.status)}</span>
                      </td>
                      <td>
                        <div className="table-sub">Tạo: {formatDateTime(payment.createdAt)}</div>
                        <div className="table-sub">Hạn: {formatDateTime(payment.expiredAt)}</div>
                      </td>
                      <td>
                        <div className="table-actions">
                          <button
                            type="button"
                            className={String(payment.status).toLowerCase() === 'success' ? 'ghost-button compact' : 'primary-button compact'}
                            disabled={openingCode === payment.paymentCode}
                            onClick={() => openPayment(payment.paymentCode)}
                          >
                            {openingCode === payment.paymentCode ? 'Đang mở...' : 'Xem QR'}
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        {selectedPayment && (
          <PaymentQrModal
            payment={selectedPayment}
            onClose={() => {
              setSelectedPayment(null)
              setRefreshing(false)
              setPaymentError('')
            }}
            onRefresh={refreshSelectedPayment}
            refreshing={refreshing}
            error={paymentError}
            onPaymentChanged={handlePaymentChanged}
            onPaymentDeleted={handlePaymentDeleted}
          />
        )}
      </div>
    </div>
  )
}
