// Trang LandlordDashboardPage la tong quan cho chu tro.
// Layout moi gom 3 cot:
// - Trai: bieu do + cong suat phong/khu tro
// - Giua: canh bao va hoat dong gan day
// - Phai: nut thao tac nhanh
import { useEffect, useMemo, useState } from 'react'
import { Link } from 'react-router-dom'
import {
  AreaChart, Area, BarChart, Bar, XAxis, YAxis, CartesianGrid,
  Tooltip, Legend, ResponsiveContainer, PieChart, Pie, Cell,
} from 'recharts'
import { getLandlordBookingRequests } from '../api/bookingApi'
import { getMyNotifications } from '../api/notificationApi'
import { getLandlordProperties, getLandlordRooms } from '../api/rentalApi'
import { formatCurrency, formatDateTime } from '../utils/rentalFormat'

const FLOW_RANGE_OPTIONS = [
  { value: 'month', label: '1 tháng' },
  { value: 'quarter', label: '1 quý' },
  { value: 'year', label: '1 năm' },
]

function startOfDay(value) {
  const next = new Date(value)
  next.setHours(0, 0, 0, 0)
  return next
}

function shiftDays(value, amount) {
  const next = new Date(value)
  next.setDate(next.getDate() + amount)
  return next
}

function formatBucketLabel(start, end, mode) {
  if (mode === 'month') {
    return `${start.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' })}-${shiftDays(end, -1).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' })}`
  }

  if (mode === 'quarter') {
    return `T${start.getMonth() + 1}`
  }

  return `${start.toLocaleDateString('vi-VN', { month: '2-digit' })}/${start.getFullYear().toString().slice(-2)}`
}

function summarizeFlowBuckets(items) {
  return items.reduce(
    (summary, item) => ({
      bookingCount: summary.bookingCount + Number(item.bookingCount || 0),
      scheduledVisits: summary.scheduledVisits + Number(item.scheduledVisits || 0),
      projectedRevenue: summary.projectedRevenue + Number(item.projectedRevenue || 0),
      confirmedRevenue: summary.confirmedRevenue + Number(item.confirmedRevenue || 0),
    }),
    { bookingCount: 0, scheduledVisits: 0, projectedRevenue: 0, confirmedRevenue: 0 },
  )
}

function buildFlowBuckets(mode) {
  const today = startOfDay(new Date())
  const tomorrow = shiftDays(today, 1)

  if (mode === 'month') {
    return Array.from({ length: 4 }, (_, index) => {
      const start = shiftDays(tomorrow, -((4 - index) * 7))
      const end = shiftDays(tomorrow, -((3 - index) * 7))
      return { key: `month-${index}`, label: formatBucketLabel(start, end, mode), start, end }
    })
  }

  if (mode === 'quarter') {
    return Array.from({ length: 3 }, (_, index) => {
      const start = startOfDay(new Date(today.getFullYear(), today.getMonth() - (2 - index), 1))
      const end = startOfDay(new Date(start.getFullYear(), start.getMonth() + 1, 1))
      return { key: `quarter-${index}`, label: formatBucketLabel(start, end, mode), start, end }
    })
  }

  return Array.from({ length: 6 }, (_, index) => {
    const start = startOfDay(new Date(today.getFullYear(), today.getMonth() - ((5 - index) * 2), 1))
    const end = startOfDay(new Date(start.getFullYear(), start.getMonth() + 2, 1))
    return { key: `year-${index}`, label: formatBucketLabel(start, end, mode), start, end }
  })
}

function isDateWithinRange(value, start, end) {
  if (!value) return false
  const time = new Date(value).getTime()
  return time >= start.getTime() && time < end.getTime()
}

export default function LandlordDashboardPage() {
  const [properties, setProperties] = useState([])
  const [rooms, setRooms] = useState([])
  const [bookings, setBookings] = useState([])
  const [notifications, setNotifications] = useState([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState('')
  const [flowRange, setFlowRange] = useState('month')

  useEffect(() => {
    const loadDashboard = async () => {
      setLoading(true)
      setError('')

      try {
        const [propertyResult, roomResult, bookingResult, notificationResult] = await Promise.allSettled([
          getLandlordProperties(),
          getLandlordRooms(),
          getLandlordBookingRequests(),
          getMyNotifications(),
        ])

        if (propertyResult.status !== 'fulfilled' || roomResult.status !== 'fulfilled' || bookingResult.status !== 'fulfilled') {
          throw propertyResult.reason || roomResult.reason || bookingResult.reason
        }

        setProperties(Array.isArray(propertyResult.value) ? propertyResult.value : [])
        setRooms(Array.isArray(roomResult.value) ? roomResult.value : [])
        setBookings(Array.isArray(bookingResult.value) ? bookingResult.value : [])
        setNotifications(
          notificationResult.status === 'fulfilled' && Array.isArray(notificationResult.value)
            ? [...notificationResult.value].sort((left, right) => new Date(right.createdAt || 0) - new Date(left.createdAt || 0)).slice(0, 5)
            : [],
        )
      } catch (err) {
        setError(err?.response?.data?.message || 'Không thể tải dashboard chủ trọ.')
      } finally {
        setLoading(false)
      }
    }

    loadDashboard()
  }, [])

  const roomPriceById = useMemo(() => {
    return new Map(rooms.map((room) => [Number(room.id), Number(room.price || 0)]))
  }, [rooms])

  const stats = useMemo(() => {
    const availableRooms = rooms.filter((item) => String(item.status).toLowerCase() === 'available').length
    const occupiedRooms = rooms.filter((item) => ['reserved', 'rented'].includes(String(item.status).toLowerCase())).length
    const hiddenRooms = rooms.filter((item) => String(item.status).toLowerCase() === 'hidden').length
    const pendingApproval = rooms.filter((item) => String(item.approvalStatus).toLowerCase() !== 'approved').length
    const pendingBookings = bookings.filter((item) => String(item.status).toLowerCase() === 'pending').length
    const scheduledVisits = bookings.filter((item) => String(item.requestType).toLowerCase() === 'schedule_visit').length
    const activeTenants = new Set(
      bookings
        .filter((item) => ['confirmed', 'waiting_payment', 'paid'].includes(String(item.status).toLowerCase()))
        .map((item) => Number(item.tenantId)),
    ).size
    const projectedMonthlyRevenue = rooms
      .filter((item) => ['reserved', 'rented'].includes(String(item.status).toLowerCase()))
      .reduce((total, item) => total + Number(item.price || 0), 0)

    return {
      propertyCount: properties.length,
      roomCount: rooms.length,
      availableRooms,
      occupiedRooms,
      hiddenRooms,
      pendingApproval,
      pendingBookings,
      scheduledVisits,
      activeTenants,
      projectedMonthlyRevenue,
    }
  }, [properties, rooms, bookings])

  const flowData = useMemo(() => {
    return buildFlowBuckets(flowRange).map((bucket) => {
      const bucketBookings = bookings.filter((item) => isDateWithinRange(item.requestedAt, bucket.start, bucket.end))
      const rentDemand = bucketBookings.filter((item) => String(item.requestType).toLowerCase() === 'rent')
      const projectedRevenue = rentDemand.reduce((total, item) => total + (roomPriceById.get(Number(item.roomId)) || 0), 0)
      const confirmedRevenue = bucketBookings
        .filter((item) => ['confirmed', 'waiting_payment', 'paid'].includes(String(item.status).toLowerCase()))
        .reduce((total, item) => total + (roomPriceById.get(Number(item.roomId)) || 0), 0)

      return {
        ...bucket,
        bookingCount: bucketBookings.length,
        scheduledVisits: bucketBookings.filter((item) => String(item.requestType).toLowerCase() === 'schedule_visit').length,
        projectedRevenue,
        confirmedRevenue,
      }
    })
  }, [bookings, flowRange, roomPriceById])

  const flowSummary = useMemo(() => summarizeFlowBuckets(flowData), [flowData])

  const roomMix = useMemo(() => {
    return [
      { label: 'Phòng đang có khách', value: stats.occupiedRooms, tone: 'occupied' },
      { label: 'Phòng còn trống', value: stats.availableRooms, tone: 'available' },
      { label: 'Phòng chờ duyệt', value: stats.pendingApproval, tone: 'pending' },
      { label: 'Phòng đang ẩn', value: stats.hiddenRooms, tone: 'hidden' },
    ]
  }, [stats])

  const maxRoomMix = useMemo(() => Math.max(...roomMix.map((item) => item.value), 1), [roomMix])

  const roomPieData = useMemo(() => {
    const items = [
      { name: 'Đang có khách', value: stats.occupiedRooms, color: '#0E7490' },
      { name: 'Còn trống', value: stats.availableRooms, color: '#10B981' },
      { name: 'Chờ duyệt', value: stats.pendingApproval, color: '#F59E0B' },
      { name: 'Đang ẩn', value: stats.hiddenRooms, color: '#94A3B8' },
    ].filter((item) => item.value > 0)
    return items.length > 0 ? items : [{ name: 'Chưa có phòng', value: 1, color: '#E2E8F0' }]
  }, [stats])

  const propertyBarData = useMemo(() => {
    return propertyHealth.map((p) => ({
      name: p.name.length > 14 ? `${p.name.slice(0, 14)}…` : p.name,
      'Lấp đầy': p.fillRate,
      'Còn trống': 100 - p.fillRate,
    }))
  }, [propertyHealth])

  const propertyHealth = useMemo(() => {
    return properties
      .map((property) => {
        const propertyRooms = rooms.filter((room) => Number(room.propertyId) === Number(property.id))
        const totalRooms = propertyRooms.length || Number(property.roomCount || 0)
        const occupiedRooms = propertyRooms.filter((room) => ['reserved', 'rented'].includes(String(room.status).toLowerCase())).length
        const availableRooms = propertyRooms.filter((room) => String(room.status).toLowerCase() === 'available').length

        return {
          id: property.id,
          name: property.name,
          address: property.fullAddress,
          totalRooms,
          occupiedRooms,
          availableRooms,
          updatedAt: property.updatedAt,
          fillRate: totalRooms > 0 ? Math.round((occupiedRooms / totalRooms) * 100) : 0,
        }
      })
      .sort((left, right) => right.totalRooms - left.totalRooms || new Date(right.updatedAt || 0) - new Date(left.updatedAt || 0))
      .slice(0, 5)
  }, [properties, rooms])

  const upcomingVisitCount = useMemo(() => {
    const now = startOfDay(new Date())
    const nextWeek = shiftDays(now, 7)
    return bookings.filter((item) =>
      String(item.requestType).toLowerCase() === 'schedule_visit'
      && isDateWithinRange(item.appointmentAt, now, nextWeek)).length
  }, [bookings])

  const moveInSoonCount = useMemo(() => {
    const now = startOfDay(new Date())
    const nextTenDays = shiftDays(now, 10)
    return bookings.filter((item) =>
      String(item.requestType).toLowerCase() === 'rent'
      && ['confirmed', 'waiting_payment', 'paid'].includes(String(item.status).toLowerCase())
      && isDateWithinRange(item.moveInDate, now, nextTenDays)).length
  }, [bookings])

  const emptyPropertyCount = useMemo(() => {
    return propertyHealth.filter((item) => item.totalRooms === 0).length
  }, [propertyHealth])

  const quickAlerts = useMemo(() => {
    const nextAlerts = []

    if (stats.pendingBookings > 0) {
      nextAlerts.push({
        id: 'pending-bookings',
        tone: 'urgent',
        title: `${stats.pendingBookings} booking đang chờ xử lý`,
        description: 'Có yêu cầu thuê hoặc lịch xem phòng mới cần bạn phản hồi.',
        to: '/landlord/bookings',
        actionLabel: 'Mở booking',
      })
    }

    if (stats.pendingApproval > 0) {
      nextAlerts.push({
        id: 'pending-approval',
        tone: 'warning',
        title: `${stats.pendingApproval} phòng đang chờ duyệt`,
        description: 'Kiểm tra lại ảnh, mô tả hoặc trạng thái hiển thị của các phòng mới cập nhật.',
        to: '/landlord/rooms',
        actionLabel: 'Xem phòng',
      })
    }

    if (upcomingVisitCount > 0) {
      nextAlerts.push({
        id: 'upcoming-visits',
        tone: 'info',
        title: `${upcomingVisitCount} lịch xem phòng trong 7 ngày tới`,
        description: 'Bạn nên xác nhận lại người xem và chuẩn bị phòng trước lịch hẹn.',
        to: '/landlord/bookings',
        actionLabel: 'Kiểm tra lịch',
      })
    }

    if (moveInSoonCount > 0) {
      nextAlerts.push({
        id: 'move-in-soon',
        tone: 'success',
        title: `${moveInSoonCount} khách sắp vào ở`,
        description: 'Kiểm tra hợp đồng, phòng và tiến độ thanh toán trước ngày vào ở.',
        to: '/landlord/tenants',
        actionLabel: 'Mở người thuê',
      })
    }

    if (emptyPropertyCount > 0) {
      nextAlerts.push({
        id: 'empty-properties',
        tone: 'muted',
        title: `${emptyPropertyCount} khu trọ chưa có phòng`,
        description: 'Bạn có thể bổ sung phòng mới để tận dụng các khu trọ đang trống dữ liệu.',
        to: '/landlord/properties',
        actionLabel: 'Mở khu trọ',
      })
    }

    if (nextAlerts.length === 0) {
      nextAlerts.push({
        id: 'all-clear',
        tone: 'success',
        title: 'Vận hành đang ổn định',
        description: 'Hiện chưa có cảnh báo khẩn. Bạn có thể tiếp tục quản lý phòng và người thuê như bình thường.',
        to: '/landlord/rooms',
        actionLabel: 'Xem phòng',
      })
    }

    return nextAlerts.slice(0, 5)
  }, [emptyPropertyCount, moveInSoonCount, stats.pendingApproval, stats.pendingBookings, upcomingVisitCount])

  const activityFeed = useMemo(() => {
    const roomItems = rooms.map((room) => ({
      id: `room-${room.id}`,
      type: 'room',
      title: room.title,
      subtitle: `${room.propertyName} · ${formatCurrency(room.price)} đ`,
      time: room.updatedAt,
      meta: 'Phòng vừa cập nhật',
      to: '/landlord/rooms',
    }))

    const propertyItems = properties.map((property) => ({
      id: `property-${property.id}`,
      type: 'property',
      title: property.name,
      subtitle: property.fullAddress,
      time: property.updatedAt,
      meta: 'Khu trọ vừa cập nhật',
      to: '/landlord/properties',
    }))

    const bookingItems = bookings.map((booking) => ({
      id: `booking-${booking.id}`,
      type: 'booking',
      title: booking.bookingCode,
      subtitle: `${booking.tenantName} · ${booking.roomTitle}`,
      time: booking.updatedAt || booking.requestedAt,
      meta: String(booking.requestType).toLowerCase() === 'schedule_visit' ? 'Lịch xem phòng' : 'Yêu cầu thuê phòng',
      to: '/landlord/bookings',
    }))

    return [...roomItems, ...propertyItems, ...bookingItems]
      .sort((left, right) => new Date(right.time || 0) - new Date(left.time || 0))
      .slice(0, 7)
  }, [bookings, properties, rooms])

  const unreadNotificationCount = useMemo(() => notifications.filter((item) => !item.isRead).length, [notifications])

  if (loading) {
    return (
      <div className="dashboard-page landlord-dashboard-page">
        <div className="dashboard-container landlord-dashboard-shell">
          <section className="landlord-overview-panel landlord-loading-panel">
            <span className="landlord-panel-badge">TLMT</span>
            <h1>Dashboard chủ trọ</h1>
            <p>Đang dựng bảng điều hành vận hành khu trọ, biểu đồ và cảnh báo nhanh...</p>
            <div className="dashboard-empty">Đang tải dashboard chủ trọ...</div>
          </section>
        </div>
      </div>
    )
  }

  return (
    <div className="dashboard-page landlord-dashboard-page">
      <div className="dashboard-container landlord-dashboard-shell">
        {error && <div className="alert error">{error}</div>}

        <section className="landlord-overview-panel">
          <span className="landlord-panel-badge">TLMT</span>
          <div className="landlord-overview-head">
            <div>
              <h1>Dashboard chủ trọ</h1>
              <p>Bố cục được gom về 3 phần chính: chuyển trang nhanh, cụm biểu đồ vận hành và khu hoạt động cùng thông báo mới nhất.</p>
            </div>
            <div className="landlord-overview-side">
              <span>{stats.roomCount} phòng</span>
              <strong>{formatCurrency(stats.projectedMonthlyRevenue)} đ</strong>
              <small>Dòng tiền dự kiến mỗi tháng</small>
            </div>
          </div>

          <div className="landlord-kpi-strip">
            <article className="landlord-kpi-card">
              <span>Khu trọ đang quản lý</span>
              <strong>{stats.propertyCount}</strong>
            </article>
            <article className="landlord-kpi-card">
              <span>Người thuê đang hoạt động</span>
              <strong>{stats.activeTenants}</strong>
            </article>
            <article className="landlord-kpi-card">
              <span>Booking chờ xử lý</span>
              <strong>{stats.pendingBookings}</strong>
            </article>
            <article className="landlord-kpi-card">
              <span>Thông báo chưa đọc</span>
              <strong>{unreadNotificationCount}</strong>
            </article>
          </div>
        </section>

        <div className="landlord-dashboard-stack">
          <section className="landlord-dashboard-card landlord-main-section">
            <div className="landlord-section-heading landlord-section-heading-split">
              <div>
                <h2>Biểu đồ vận hành</h2>
                <p>Doanh thu, trạng thái phòng và công suất khu trọ trên một giao diện.</p>
              </div>
              <div className="landlord-flow-tools">
                <div className="landlord-flow-legend landlord-flow-legend-dark">
                  <span><i className="demand" />Nhu cầu thuê</span>
                  <span><i className="confirmed" />Đã xác nhận</span>
                </div>
                <div className="landlord-flow-switch landlord-flow-switch-light" role="tablist" aria-label="Bộ lọc thời gian">
                  {FLOW_RANGE_OPTIONS.map((option) => (
                    <button
                      key={option.value}
                      type="button"
                      className={flowRange === option.value ? 'active' : ''}
                      onClick={() => setFlowRange(option.value)}
                    >
                      {option.label}
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <article className="landlord-chart-card landlord-chart-card-unified">
              <div className="landlord-card-head landlord-chart-card-unified-head">
                <div>
                  <span className="landlord-card-kicker">Tổng hợp biểu đồ</span>
                  <h3>Doanh thu, nguồn cung và công suất trong một khung</h3>
                  <p>Khối trên theo dõi dòng booking và doanh thu. Khối dưới giúp nhìn nhanh trạng thái phòng và độ lấp đầy từng khu trọ.</p>
                </div>
              </div>

              <div className="landlord-flow-chart">
                <div className="landlord-flow-month-head landlord-flow-month-head-unified">
                  <div>
                    <strong>
                      {flowRange === 'year'
                        ? '12 tháng gần đây'
                        : flowRange === 'quarter'
                          ? '3 tháng gần đây'
                          : '30 ngày gần đây'}
                    </strong>
                    <p>
                      {flowRange === 'year'
                        ? '6 mốc, mỗi mốc tương ứng 2 tháng'
                        : flowRange === 'quarter'
                          ? 'Theo dõi theo từng tháng'
                          : 'Theo dõi theo từng tuần'}
                    </p>
                  </div>
                  <span>{formatCurrency(flowSummary.projectedRevenue)} đ</span>
                </div>

                {flowData.length === 0 ? (
                  <div className="dashboard-empty">Chưa có dữ liệu để vẽ biểu đồ.</div>
                ) : (
                  <ResponsiveContainer width="100%" height={260}>
                    <AreaChart data={flowData} margin={{ top: 8, right: 4, left: 0, bottom: 0 }}>
                      <defs>
                        <linearGradient id="colorProjected" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="5%" stopColor="#0E7490" stopOpacity={0.25} />
                          <stop offset="95%" stopColor="#0E7490" stopOpacity={0.02} />
                        </linearGradient>
                        <linearGradient id="colorConfirmed" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="5%" stopColor="#2563EB" stopOpacity={0.25} />
                          <stop offset="95%" stopColor="#2563EB" stopOpacity={0.02} />
                        </linearGradient>
                      </defs>
                      <CartesianGrid strokeDasharray="3 3" stroke="#E2E8F0" vertical={false} />
                      <XAxis dataKey="label" tick={{ fontSize: 11, fill: '#94A3B8', fontWeight: 600 }} axisLine={false} tickLine={false} />
                      <YAxis tickFormatter={(v) => v >= 1e6 ? `${(v / 1e6).toFixed(0)}M` : v >= 1e3 ? `${(v / 1e3).toFixed(0)}K` : v} tick={{ fontSize: 11, fill: '#94A3B8' }} axisLine={false} tickLine={false} width={48} />
                      <Tooltip formatter={(value, name) => [formatCurrency(value) + ' đ', name]} labelStyle={{ fontWeight: 700, color: '#0F172A', marginBottom: 4 }} contentStyle={{ borderRadius: 12, border: '1px solid #E2E8F0', fontSize: 12 }} />
                      <Legend wrapperStyle={{ fontSize: 12, paddingTop: 8 }} />
                      <Area type="monotone" dataKey="projectedRevenue" name="Dự kiến" stroke="#0E7490" strokeWidth={2.5} fill="url(#colorProjected)" dot={false} />
                      <Area type="monotone" dataKey="confirmedRevenue" name="Đã chốt" stroke="#2563EB" strokeWidth={2.5} fill="url(#colorConfirmed)" dot={false} />
                    </AreaChart>
                  </ResponsiveContainer>
                )}

                <div className="landlord-flow-meta landlord-flow-meta-unified">
                  <span>
                    <small>Nhu cầu</small>
                    <strong>{flowSummary.bookingCount} booking</strong>
                  </span>
                  <span>
                    <small>Dự kiến</small>
                    <strong>{formatCurrency(flowSummary.projectedRevenue)} đ</strong>
                  </span>
                  <span>
                    <small>Đã chốt</small>
                    <strong>{formatCurrency(flowSummary.confirmedRevenue)} đ</strong>
                  </span>
                  <span>

                    <small>Lịch xem</small>
                    <strong>{flowSummary.scheduledVisits}</strong>
                  </span>
                </div>
              </div>

              <div className="landlord-chart-insights-grid">
                <section className="landlord-chart-subpanel">
                  <div className="landlord-card-head">
                    <div>
                      <span className="landlord-card-kicker">Phòng trọ</span>
                      <h3>Tần suất trạng thái phòng</h3>
                      <p>Biểu đồ tròn thể hiện phân bổ trạng thái phòng hiện tại.</p>
                    </div>
                  </div>

                  <ResponsiveContainer width="100%" height={220}>
                    <PieChart>
                      <Pie
                        data={roomPieData}
                        cx="50%"
                        cy="50%"
                        innerRadius={58}
                        outerRadius={90}
                        paddingAngle={3}
                        dataKey="value"
                      >
                        {roomPieData.map((entry, index) => (
                          <Cell key={`cell-${index}`} fill={entry.color} />
                        ))}
                      </Pie>
                      <Tooltip
                        formatter={(v, name) => [`${v} phòng`, name]}
                        contentStyle={{ borderRadius: 12, border: '1px solid #E2E8F0', fontSize: 12 }}
                      />
                      <Legend wrapperStyle={{ fontSize: 12 }} />
                    </PieChart>
                  </ResponsiveContainer>
                </section>

                <section className="landlord-chart-subpanel">
                  <div className="landlord-card-head">
                    <div>
                      <span className="landlord-card-kicker">Công suất</span>
                      <h3>So sánh công suất khu trọ</h3>
                      <p>Biểu đồ so sánh mức lấp đầy giữa các khu trọ.</p>
                    </div>
                  </div>

                  {propertyHealth.length === 0 ? (
                    <div className="dashboard-empty">Bạn chưa có khu trọ nào.</div>
                  ) : (
                    <ResponsiveContainer width="100%" height={Math.max(180, propertyBarData.length * 52)}>
                      <BarChart
                        data={propertyBarData}
                        layout="vertical"
                        margin={{ top: 4, right: 16, left: 0, bottom: 0 }}
                        barSize={14}
                      >
                        <CartesianGrid strokeDasharray="3 3" stroke="#E2E8F0" horizontal={false} />
                        <XAxis type="number" domain={[0, 100]} tickFormatter={(v) => `${v}%`} tick={{ fontSize: 11, fill: '#94A3B8' }} axisLine={false} tickLine={false} />
                        <YAxis type="category" dataKey="name" tick={{ fontSize: 11, fill: '#94A3B8' }} axisLine={false} tickLine={false} width={90} />
                        <Tooltip formatter={(v) => [`${v}%`]} contentStyle={{ borderRadius: 12, border: '1px solid #E2E8F0', fontSize: 12 }} />
                        <Legend wrapperStyle={{ fontSize: 12 }} />
                        <Bar dataKey="Lấp đầy" fill="#0E7490" radius={[0, 4, 4, 0]} stackId="s" />
                        <Bar dataKey="Còn trống" fill="#E2E8F0" radius={[0, 4, 4, 0]} stackId="s" />
                      </BarChart>
                    </ResponsiveContainer>
                  )}
                </section>
              </div>
            </article>
          </section>

          <section className="landlord-dashboard-card landlord-main-section">
            <div className="landlord-section-heading">
              <div>
                <h2>Hoạt động và thông báo</h2>
                <p>Theo dõi các cập nhật mới nhất từ vận hành và hệ thống.</p>
              </div>
            </div>

            <div className="landlord-feed-grid">
              <section className="landlord-feed-card">
                <div className="landlord-card-head">
                  <div>
                    <span className="landlord-card-kicker">Hoạt động</span>
                    <h3>Luồng cập nhật gần đây</h3>
                  </div>
                </div>

                <div className="landlord-activity-stack">
                  {activityFeed.length === 0 ? (
                    <div className="dashboard-empty">Chưa có hoạt động nào để hiển thị.</div>
                  ) : (
                    activityFeed.map((item) => (
                      <article key={item.id} className={`landlord-activity-item ${item.type}`}>
                        <div className="landlord-activity-badge">{item.meta}</div>
                        <strong>{item.title}</strong>
                        <p>{item.subtitle}</p>
                        <div className="landlord-activity-footer">
                          <span>{formatDateTime(item.time)}</span>
                          <Link to={item.to}>Mở</Link>
                        </div>
                      </article>
                    ))
                  )}
                </div>
              </section>

              <section className="landlord-feed-card">
                <div className="landlord-card-head">
                  <div>
                    <span className="landlord-card-kicker">Thông báo</span>
                    <h3>Thông báo mới nhất</h3>
                    <p>{unreadNotificationCount} thông báo chưa đọc cần bạn xem lại.</p>
                  </div>
                  <Link to="/notifications" className="landlord-inline-link">Xem tất cả</Link>
                </div>

                <div className="landlord-alert-stack">
                  {notifications.length === 0 ? (
                    quickAlerts.map((alert) => (
                      <article key={alert.id} className={`landlord-alert-item ${alert.tone}`}>
                        <div>
                          <strong>{alert.title}</strong>
                          <p>{alert.description}</p>
                        </div>
                        <Link to={alert.to}>{alert.actionLabel}</Link>
                      </article>
                    ))
                  ) : (
                    notifications.map((notification) => (
                      <article key={notification.id} className={`landlord-alert-item ${notification.isRead ? 'muted' : 'info'}`}>
                        <div>
                          <strong>{notification.title || 'Thông báo hệ thống'}</strong>
                          <p>{notification.content || 'Không có nội dung hiển thị.'}</p>
                        </div>
                        <div className="landlord-notification-footer">
                          <span>{formatDateTime(notification.createdAt)}</span>
                          <Link to={`/notifications/${notification.id}`}>{notification.isRead ? 'Mở lại' : 'Đọc ngay'}</Link>
                        </div>
                      </article>
                    ))
                  )}
                </div>
              </section>
            </div>
          </section>
        </div>
      </div>
    </div>
  )
}
