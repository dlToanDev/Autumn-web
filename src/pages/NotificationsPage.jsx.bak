// Trang NotificationsPage hien lich su notification cua user dang login.
// Muc dich:
// - Doc du lieu tu bang notifications qua notificationApi
// - Cho loc theo da doc/chua doc
// - Cho danh dau tung muc hoac tat ca la da doc
// - Dan link sang trang chi tiet NotificationDetailPage
import { useEffect, useMemo, useState } from 'react'
import { Link } from 'react-router-dom'
import DashboardHeroBanner from '../components/DashboardHeroBanner'
import {
  getMyNotifications,
  markAllNotificationsAsRead,
  markNotificationAsRead,
} from '../api/notificationApi'
import { getHomePathForUser, getStoredUser } from '../utils/auth'
import { emitNotificationsChanged } from '../utils/notificationEvents'
import { formatNotificationTypeLabel, getNotificationTypeClass } from '../utils/notificationPresentation'
import { formatDateTime } from '../utils/rentalFormat'

export default function NotificationsPage() {
  const currentUser = getStoredUser()
  const homePath = getHomePathForUser(currentUser)
  const [notifications, setNotifications] = useState([])
  const [viewFilter, setViewFilter] = useState('all')
  const [loading, setLoading] = useState(true)
  const [markingId, setMarkingId] = useState(0)
  const [markingAll, setMarkingAll] = useState(false)
  const [message, setMessage] = useState('')
  const [error, setError] = useState('')

  // Ham tai trung tam cua page.
  // Header.jsx cung goi cung endpoint nay de dem so thong bao chua doc tren icon chuong.
  const loadNotifications = async () => {
    const data = await getMyNotifications()
    const nextNotifications = Array.isArray(data)
      ? [...data].sort((left, right) => new Date(right.createdAt || 0) - new Date(left.createdAt || 0))
      : []

    setNotifications(nextNotifications)
    return nextNotifications
  }

  useEffect(() => {
    // Tai lan dau khi vao page.
    const loadInitial = async () => {
      setLoading(true)
      setError('')

      try {
        await loadNotifications()
      } catch (err) {
        setError(err?.response?.data?.message || 'Không thể tải danh sách thông báo.')
      } finally {
        setLoading(false)
      }
    }

    loadInitial()
  }, [])

  // stats la thong tin tong hop de render o 4 o summary ben tren.
  const stats = useMemo(() => ({
    total: notifications.length,
    unread: notifications.filter((item) => !item.isRead).length,
    read: notifications.filter((item) => item.isRead).length,
  }), [notifications])

  // filteredNotifications giup UI loc client-side ma khong can goi lai backend.
  const filteredNotifications = useMemo(() => {
    return notifications.filter((item) => {
      if (viewFilter === 'unread') return !item.isRead
      if (viewFilter === 'read') return item.isRead
      return true
    })
  }, [notifications, viewFilter])

  const handleMarkRead = async (notificationId) => {
    // Goi API mark read, cap nhat ngay state local va phat event de Header refresh badge.
    setMarkingId(notificationId)
    setMessage('')
    setError('')

    try {
      const updatedNotification = await markNotificationAsRead(notificationId)
      setNotifications((prev) => prev.map((item) => (
        item.id === updatedNotification.id ? updatedNotification : item
      )))
      emitNotificationsChanged()
      setMessage('Đã đánh dấu thông báo là đã đọc.')
    } catch (err) {
      setError(err?.response?.data?.message || 'Không thể cập nhật trạng thái thông báo.')
    } finally {
      setMarkingId(0)
    }
  }

  const handleMarkAllRead = async () => {
    // Backend tra updatedCount de hien thong bao ket qua cho user.
    setMarkingAll(true)
    setMessage('')
    setError('')

    try {
      const result = await markAllNotificationsAsRead()
      setNotifications((prev) => prev.map((item) => ({ ...item, isRead: true })))
      emitNotificationsChanged()
      setMessage(
        Number(result?.updatedCount || 0) > 0
          ? `Đã đánh dấu ${result.updatedCount} thông báo là đã đọc.`
          : 'Tất cả thông báo đã ở trạng thái đã đọc.',
      )
    } catch (err) {
      setError(err?.response?.data?.message || 'Không thể đánh dấu tất cả thông báo.')
    } finally {
      setMarkingAll(false)
    }
  }

  if (loading) {
    return (
      <div className="dashboard-page">
        <div className="dashboard-container">
          <div className="dashboard-empty">Đang tải trang thông báo...</div>
        </div>
      </div>
    )
  }

  return (
    <div className="dashboard-page">
      <div className="dashboard-container room-manager-page">
        <DashboardHeroBanner
          title="Đây là trang thông báo của bạn"
          description={[
            'Mọi cập nhật về booking, thanh toán và hệ thống đều được lưu lại tại đây để bạn theo dõi.',
            'Nếu cần phản hồi nhanh về một thông báo, bạn có thể mở hộp tin để trao đổi ngay.',
          ]}
          action={{ to: '/messages', label: 'Mở hộp tin' }}
        />

        <div className="notification-toolbar">
          <Link to={homePath} className="ghost-button card-link-button">
            Về trang chính
          </Link>
          <button
            type="button"
            className="primary-button"
            onClick={handleMarkAllRead}
            disabled={markingAll || stats.unread === 0}
          >
            {markingAll ? 'Đang cập nhật...' : 'Đánh dấu tất cả đã đọc'}
          </button>
        </div>

        <div className="detail-summary-grid">
          <div className="detail-summary-item">
            <span>Tổng thông báo</span>
            <strong>{stats.total}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Chưa đọc</span>
            <strong>{stats.unread}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Đã đọc</span>
            <strong>{stats.read}</strong>
          </div>
          <div className="detail-summary-item">
            <span>Bộ lọc hiện tại</span>
            <strong>{viewFilter === 'all' ? 'Tất cả' : viewFilter === 'unread' ? 'Chưa đọc' : 'Đã đọc'}</strong>
          </div>
        </div>

        {message && <div className="alert success">{message}</div>}
        {error && <div className="alert error">{error}</div>}

        <section className="dashboard-panel section-top-gap">
          <div className="panel-heading">
            <div>
              <h2>Danh sách thông báo</h2>
              <p>Lọc nhanh để xem các thông báo chưa đọc hoặc toàn bộ lịch sử đã gửi tới tài khoản của bạn.</p>
            </div>
          </div>

          <div className="chip-grid notification-filter-row">
            <button
              type="button"
              className={`choice-chip${viewFilter === 'all' ? ' selected' : ''}`}
              onClick={() => setViewFilter('all')}
            >
              Tất cả
            </button>
            <button
              type="button"
              className={`choice-chip${viewFilter === 'unread' ? ' selected' : ''}`}
              onClick={() => setViewFilter('unread')}
            >
              Chưa đọc
            </button>
            <button
              type="button"
              className={`choice-chip${viewFilter === 'read' ? ' selected' : ''}`}
              onClick={() => setViewFilter('read')}
            >
              Đã đọc
            </button>
          </div>

          {filteredNotifications.length === 0 ? (
            <div className="dashboard-empty">
              {notifications.length === 0
                ? 'Tài khoản của bạn chưa có thông báo nào trong cơ sở dữ liệu.'
                : 'Không có thông báo nào khớp với bộ lọc hiện tại.'}
            </div>
          ) : (
            <div className="stack-list notification-list">
              {filteredNotifications.map((notification) => (
                <article
                  key={notification.id}
                  className={`stack-card notification-card${notification.isRead ? '' : ' unread'}`}
                >
                  <div className="notification-card-head">
                    <div>
                      <div className="inline-actions notification-card-meta">
                        <span className={`status-pill ${notification.isRead ? 'expired' : 'pending'}`}>
                          {notification.isRead ? 'Đã đọc' : 'Chưa đọc'}
                        </span>
                        <span className={`mini-tag notification-type-pill ${getNotificationTypeClass(notification.type)}`}>
                          {formatNotificationTypeLabel(notification.type)}
                        </span>
                      </div>
                      <h3>{notification.title}</h3>
                      <p className="stack-note">Gửi lúc: {formatDateTime(notification.createdAt)}</p>
                    </div>

                    {!notification.isRead && (
                      <button
                        type="button"
                        className="ghost-button compact"
                        onClick={() => handleMarkRead(notification.id)}
                        disabled={markingId === notification.id}
                      >
                        {markingId === notification.id ? 'Đang cập nhật...' : 'Đánh dấu đã đọc'}
                      </button>
                    )}
                  </div>

                  <p className="notification-card-content">{notification.content}</p>

                  <div className="inline-actions notification-card-actions">
                    <Link
                      to={`/notifications/${notification.id}`}
                      className="ghost-button card-link-button"
                    >
                      Xem chi tiết
                    </Link>
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>
      </div>
    </div>
  )
}
