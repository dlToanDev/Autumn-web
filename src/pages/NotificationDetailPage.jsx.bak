// Trang NotificationDetailPage hien chi tiet mot notification.
// Muc dich:
// - Lay notification theo id tren URL /notifications/:notificationId
// - Tu dong danh dau da doc neu mo vao mot thong bao chua doc
// - Dong bo lai badge thong bao tren Header thong qua event bus nho
import { useEffect, useState } from 'react'
import { Link, useParams } from 'react-router-dom'
import DashboardHeroBanner from '../components/DashboardHeroBanner'
import { getNotificationById, markNotificationAsRead } from '../api/notificationApi'
import { getHomePathForUser, getStoredUser } from '../utils/auth'
import { emitNotificationsChanged } from '../utils/notificationEvents'
import { formatNotificationTypeLabel, getNotificationTypeClass } from '../utils/notificationPresentation'
import { formatDateTime } from '../utils/rentalFormat'

export default function NotificationDetailPage() {
  const { notificationId } = useParams()
  const currentUser = getStoredUser()
  const homePath = getHomePathForUser(currentUser)
  const [notification, setNotification] = useState(null)
  const [loading, setLoading] = useState(true)
  const [marking, setMarking] = useState(false)
  const [message, setMessage] = useState('')
  const [error, setError] = useState('')

  useEffect(() => {
    // Khi doi sang notification khac, page tai lai du lieu tu backend.
    const loadNotification = async () => {
      setLoading(true)
      setError('')
      setMessage('')

      try {
        const data = await getNotificationById(notificationId)
        setNotification(data)

        // UX: vao detail la xem thong bao, nen page co the tu chuyen sang da doc.
        if (!data.isRead) {
          try {
            const updatedNotification = await markNotificationAsRead(notificationId)
            setNotification(updatedNotification)
            emitNotificationsChanged()
          } catch {
            setNotification(data)
          }
        }
      } catch (err) {
        setNotification(null)
        setError(err?.response?.data?.message || 'Không thể tải chi tiết thông báo.')
      } finally {
        setLoading(false)
      }
    }

    loadNotification()
  }, [notificationId])

  const handleMarkAsRead = async () => {
    // Nut manual van duoc giu lai de phong auto-mark khong chay duoc.
    if (!notification || notification.isRead) return

    setMarking(true)
    setError('')
    setMessage('')

    try {
      const updatedNotification = await markNotificationAsRead(notification.id)
      setNotification(updatedNotification)
      emitNotificationsChanged()
      setMessage('Đã đánh dấu thông báo là đã đọc.')
    } catch (err) {
      setError(err?.response?.data?.message || 'Không thể cập nhật trạng thái thông báo.')
    } finally {
      setMarking(false)
    }
  }

  if (loading) {
    return (
      <div className="dashboard-page">
        <div className="dashboard-container">
          <div className="dashboard-empty">Đang tải chi tiết thông báo...</div>
        </div>
      </div>
    )
  }

  return (
    <div className="dashboard-page">
      <div className="dashboard-container room-manager-page">
        <DashboardHeroBanner
          title="Đây là trang xem chi tiết thông báo"
          description={[
            'Bạn đang xem đầy đủ nội dung, thời điểm gửi và trạng thái đọc của từng thông báo.',
            'Khi cần kiểm tra các mục khác, bạn có thể quay lại danh sách thông báo ngay.',
          ]}
          action={{ to: '/notifications', label: 'Quay lại thông báo' }}
        />

        <div className="notification-toolbar">
          <Link to="/notifications" className="ghost-button card-link-button">
            Quay lại danh sách
          </Link>
          <Link to={homePath} className="ghost-button card-link-button">
            Về trang chính
          </Link>
        </div>

        {message && <div className="alert success">{message}</div>}
        {error && <div className="alert error">{error}</div>}

        {!notification ? (
          <section className="dashboard-panel">
            <div className="dashboard-empty">Không tìm thấy thông báo này hoặc bạn không có quyền xem nó.</div>
          </section>
        ) : (
          <>
            <div className="detail-summary-grid notification-detail-summary">
              <div className="detail-summary-item">
                <span>Mã thông báo</span>
                <strong>#{notification.id}</strong>
              </div>
              <div className="detail-summary-item">
                <span>Trạng thái</span>
                <strong>{notification.isRead ? 'Đã đọc' : 'Chưa đọc'}</strong>
              </div>
              <div className="detail-summary-item">
                <span>Phân loại</span>
                <strong>{formatNotificationTypeLabel(notification.type)}</strong>
              </div>
              <div className="detail-summary-item">
                <span>Thời gian gửi</span>
                <strong>{formatDateTime(notification.createdAt)}</strong>
              </div>
            </div>

            <section className={`dashboard-panel section-top-gap notification-detail-panel${notification.isRead ? '' : ' unread'}`}>
              <div className="notification-detail-head">
                <div>
                  <div className="inline-actions notification-card-meta">
                    <span className={`status-pill ${notification.isRead ? 'expired' : 'pending'}`}>
                      {notification.isRead ? 'Đã đọc' : 'Chưa đọc'}
                    </span>
                    <span className={`mini-tag notification-type-pill ${getNotificationTypeClass(notification.type)}`}>
                      {formatNotificationTypeLabel(notification.type)}
                    </span>
                  </div>
                  <h2>{notification.title}</h2>
                  <p className="stack-note">Gửi lúc: {formatDateTime(notification.createdAt)}</p>
                </div>

                {!notification.isRead && (
                  <button
                    type="button"
                    className="primary-button"
                    onClick={handleMarkAsRead}
                    disabled={marking}
                  >
                    {marking ? 'Đang cập nhật...' : 'Đánh dấu đã đọc'}
                  </button>
                )}
              </div>

              <div className="notification-detail-content">
                {notification.content}
              </div>
            </section>
          </>
        )}
      </div>
    </div>
  )
}
