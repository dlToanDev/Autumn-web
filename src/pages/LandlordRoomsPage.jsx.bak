// Trang LandlordRoomsPage la noi chu tro CRUD phong.
// Day la page quan trong vi no noi room voi property, amenity va hinh anh.
import { useEffect, useMemo, useState } from 'react'
import { useNavigate } from 'react-router-dom'
import DashboardHeroBanner from '../components/DashboardHeroBanner'
import {
  createRoom,
  deleteRoom,
  getAmenities,
  getLandlordProperties,
  getLandlordRooms,
  updateRoom,
} from '../api/rentalApi'

const defaultForm = {
  propertyId: '',
  title: '',
  description: '',
  roomType: '',
  roomCode: '',
  area: '',
  price: '',
  depositAmount: '',
  electricPrice: '',
  waterPrice: '',
  servicePrice: '',
  maxTenants: '1',
  genderAllowed: 'all',
  furnished: false,
  furnishingDetail: '',
  status: 'available',
  approvalStatus: 'approved',
  availableFrom: '',
  amenityIds: [],
  customAmenitiesText: '',
  images: [],
}

function getStoredUser() {
  // Giu helper rieng de file tu doc user luc can redirect/kiem tra role.
  const userStr = localStorage.getItem('user')
  if (!userStr) return null

  try {
    return JSON.parse(userStr)
  } catch {
    return null
  }
}

function formatCurrency(value) {
  return Number(value || 0).toLocaleString('vi-VN')
}

function fileToDataUrl(file) {
  // Chuyen anh upload sang Data URL de gui cung payload room.
  return new Promise((resolve, reject) => {
    const reader = new FileReader()
    reader.onload = () => resolve(reader.result)
    reader.onerror = reject
    reader.readAsDataURL(file)
  })
}

function normalizeImages(images) {
  // Dam bao danh sach anh luon co thumbnail de gallery render on dinh.
  if (images.length === 0) return []

  const hasThumbnail = images.some((item) => item.isThumbnail)
  return images.map((item, index) => ({
    ...item,
    isThumbnail: hasThumbnail ? item.isThumbnail : index === 0,
  }))
}

function mapRoomToForm(room) {
  // Khi sua phong, map entity room -> shape form de input hien dung gia tri.
  return {
    propertyId: String(room.propertyId || ''),
    title: room.title || '',
    description: room.description || '',
    roomType: room.roomType || '',
    roomCode: room.roomCode || '',
    area: String(room.area ?? ''),
    price: String(room.price ?? ''),
    depositAmount: String(room.depositAmount ?? ''),
    electricPrice: String(room.electricPrice ?? ''),
    waterPrice: String(room.waterPrice ?? ''),
    servicePrice: String(room.servicePrice ?? ''),
    maxTenants: String(room.maxTenants ?? 1),
    genderAllowed: room.genderAllowed || 'all',
    furnished: Boolean(room.furnished),
    furnishingDetail: room.furnishingDetail || '',
    status: room.status || 'available',
    approvalStatus: room.approvalStatus || 'approved',
    availableFrom: room.availableFrom ? room.availableFrom.slice(0, 10) : '',
    amenityIds: room.amenities.map((item) => item.id),
    customAmenitiesText: '',
    images: normalizeImages(
      room.images.map((item, index) => ({
        id: item.id || `existing-${index}`,
        imageUrl: item.imageUrl,
        fileName: `Ảnh ${index + 1}`,
        isThumbnail: Boolean(item.isThumbnail),
      })),
    ),
  }
}

export default function LandlordRoomsPage() {
  const navigate = useNavigate()
  const [properties, setProperties] = useState([])
  const [rooms, setRooms] = useState([])
  const [amenities, setAmenities] = useState([])
  const [form, setForm] = useState(defaultForm)
  const [editingId, setEditingId] = useState(null)
  const [selectedRoom, setSelectedRoom] = useState(null)
  const [showForm, setShowForm] = useState(false)
  const [loading, setLoading] = useState(true)
  const [submitting, setSubmitting] = useState(false)
  const [uploadingImages, setUploadingImages] = useState(false)
  const [message, setMessage] = useState('')
  const [error, setError] = useState('')

  const user = useMemo(() => getStoredUser(), [])
  const roleCode = (user?.roleCode || '').toUpperCase()
  const canManage = roleCode === 'LANDLORD'

  useEffect(() => {
    const token = localStorage.getItem('token')
    if (!token) {
      navigate('/login')
      return
    }

    if (!canManage) {
      navigate('/')
      return
    }

    const loadInitial = async () => {
      setLoading(true)
      setError('')

      try {
        const [propertyData, roomData, amenityData] = await Promise.all([
          getLandlordProperties(),
          getLandlordRooms(),
          getAmenities(),
        ])
        setProperties(propertyData)
        setRooms(roomData)
      setAmenities(amenityData)
      } catch (err) {
        setError(err?.response?.data?.message || 'Không thể tải dữ liệu phòng.')
      } finally {
        setLoading(false)
      }
    }

    loadInitial()
  }, [navigate, canManage])

  const resetForm = () => {
    setForm(defaultForm)
    setEditingId(null)
  }

  const closeForm = () => {
    resetForm()
    setShowForm(false)
  }

  const handleChange = (field, value) => {
    setForm((prev) => ({ ...prev, [field]: value }))
  }

  const toggleAmenity = (amenityId) => {
    setForm((prev) => ({
      ...prev,
      amenityIds: prev.amenityIds.includes(amenityId)
        ? prev.amenityIds.filter((id) => id !== amenityId)
        : [...prev.amenityIds, amenityId],
    }))
  }

  const handleSelectImages = async (event) => {
    const files = Array.from(event.target.files || [])
    if (files.length === 0) return

    setUploadingImages(true)
    setError('')

    try {
      const imageItems = await Promise.all(
        files.map(async (file, index) => ({
          id: `${file.name}-${file.lastModified}-${index}`,
          imageUrl: await fileToDataUrl(file),
          fileName: file.name,
          isThumbnail: false,
        })),
      )

      setForm((prev) => ({
        ...prev,
        images: normalizeImages([...prev.images, ...imageItems]),
      }))
    } catch {
      setError('Không thể đọc ảnh đã chọn.')
    } finally {
      setUploadingImages(false)
      event.target.value = ''
    }
  }

  const removeImage = (imageId) => {
    setForm((prev) => ({
      ...prev,
      images: normalizeImages(prev.images.filter((item) => item.id !== imageId)),
    }))
  }

  const setThumbnail = (imageId) => {
    setForm((prev) => ({
      ...prev,
      images: prev.images.map((item) => ({
        ...item,
        isThumbnail: item.id === imageId,
      })),
    }))
  }

  const openCreateForm = () => {
    setMessage('')
    setError('')
    setSelectedRoom(null)
    resetForm()
    setShowForm(true)
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }

  const startEdit = (room) => {
    setMessage('')
    setError('')
    setEditingId(room.id)
    setForm(mapRoomToForm(room))
    setSelectedRoom(null)
    setShowForm(true)
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }

  const openDetail = (room) => {
    setSelectedRoom(room)
  }

  const refreshRooms = async () => {
    const roomData = await getLandlordRooms()
    setRooms(roomData)
  }

  const handleSubmit = async (event) => {
    event.preventDefault()
    setSubmitting(true)
    setMessage('')
    setError('')

    const payload = {
      propertyId: Number(form.propertyId),
      title: form.title,
      description: form.description || null,
      roomType: form.roomType,
      roomCode: form.roomCode || null,
      area: Number(form.area),
      price: Number(form.price),
      depositAmount: form.depositAmount === '' ? 0 : Number(form.depositAmount),
      electricPrice: form.electricPrice === '' ? 0 : Number(form.electricPrice),
      waterPrice: form.waterPrice === '' ? 0 : Number(form.waterPrice),
      servicePrice: form.servicePrice === '' ? 0 : Number(form.servicePrice),
      maxTenants: Number(form.maxTenants),
      genderAllowed: form.genderAllowed,
      furnished: form.furnished,
      furnishingDetail: form.furnishingDetail || null,
      status: form.status,
      approvalStatus: form.approvalStatus,
      availableFrom: form.availableFrom || null,
      amenityIds: form.amenityIds,
      customAmenities: form.customAmenitiesText
        .split('\n')
        .map((item) => item.trim())
        .filter(Boolean),
      images: normalizeImages(form.images).map((item, index) => ({
        imageUrl: item.imageUrl,
        isThumbnail: Boolean(item.isThumbnail),
        sortOrder: index + 1,
      })),
    }

    try {
      if (editingId) {
        await updateRoom(editingId, payload)
        setMessage('Cập nhật phòng thành công.')
      } else {
        await createRoom(payload)
        setMessage('Tạo phòng thành công.')
      }

      const [roomData, amenityData] = await Promise.all([
        getLandlordRooms(),
        getAmenities(),
      ])
      setRooms(roomData)
      setAmenities(amenityData)
      closeForm()
    } catch (err) {
      setError(err?.response?.data?.message || 'Không thể lưu phòng.')
    } finally {
      setSubmitting(false)
    }
  }

  const handleDelete = async (roomId) => {
    const confirmed = window.confirm('Bạn có chắc muốn xóa phòng này không?')
    if (!confirmed) return

    setMessage('')
    setError('')

    try {
      await deleteRoom(roomId)
      setRooms((prev) => prev.filter((item) => item.id !== roomId))
      if (editingId === roomId) {
        closeForm()
      }
      if (selectedRoom?.id === roomId) {
        setSelectedRoom(null)
      }
      setMessage('Đã xóa phòng.')
    } catch (err) {
      setError(err?.response?.data?.message || 'Không thể xóa phòng.')
    }
  }

  if (loading) {
    return (
      <div className="dashboard-page">
        <div className="dashboard-container">
          <div className="dashboard-empty">Đang tải dữ liệu phòng...</div>
        </div>
      </div>
    )
  }

  return (
    <div className="dashboard-page">
      <div className="dashboard-container room-manager-page">
        <DashboardHeroBanner
          title="Đây là trang quản lý phòng của bạn"
          description={[
            'Bạn có thể tạo mới, cập nhật thông tin, tiện ích, hình ảnh và trạng thái từng phòng ngay tại đây.',
            'Nếu cần hỗ trợ xử lý hiển thị phòng hoặc dữ liệu duyệt, hãy liên hệ admin.',
          ]}
          action={{ to: '/messages', label: 'Liên hệ admin' }}
        />

        {message && <div className="alert success">{message}</div>}
        {error && <div className="alert error">{error}</div>}

        <section className="dashboard-panel">
          <div className="room-toolbar">
            <div>
              <h2>Danh sách phòng</h2>
              <p>{rooms.length} phòng đang thuộc tài khoản của bạn.</p>
            </div>
            <button
              type="button"
              className="primary-button"
              onClick={openCreateForm}
              disabled={properties.length === 0}
            >
              Tạo phòng mới
            </button>
          </div>

          {properties.length === 0 && (
            <div className="dashboard-empty">
              Bạn cần tạo ít nhất một khu trọ trước khi thêm phòng.
            </div>
          )}

          {showForm && (
            <div className="room-form-shell">
              <div className="panel-heading">
                <div>
                  <h2>{editingId ? 'Sửa phòng' : 'Thêm phòng mới'}</h2>
                  <p>Biểu mẫu chỉ hiện khi bạn bấm nút tạo mới hoặc sửa phòng.</p>
                </div>
                <button type="button" className="ghost-button" onClick={closeForm}>
                  Đóng form
                </button>
              </div>

              <form className="dashboard-form" onSubmit={handleSubmit}>
                <div className="form-grid two-cols">
                  <label className="form-field">
                    <span>Khu trọ</span>
                    <select value={form.propertyId} onChange={(e) => handleChange('propertyId', e.target.value)} required>
                      <option value="">Chọn khu trọ</option>
                      {properties.map((property) => (
                        <option key={property.id} value={property.id}>{property.name}</option>
                      ))}
                    </select>
                  </label>

                  <label className="form-field">
                    <span>Mã phòng</span>
                    <input value={form.roomCode} onChange={(e) => handleChange('roomCode', e.target.value)} placeholder="Để trống để hệ thống tự sinh" />
                  </label>
                </div>

                <div className="form-grid two-cols">
                  <label className="form-field">
                    <span>Tiêu đề</span>
                    <input value={form.title} onChange={(e) => handleChange('title', e.target.value)} placeholder="Phòng có gác, full nội thất" required />
                  </label>

                  <label className="form-field">
                    <span>Loại trọ / phòng</span>
                    <input
                      list="room-type-suggestions"
                      value={form.roomType}
                      onChange={(e) => handleChange('roomType', e.target.value)}
                      placeholder="Ví dụ: Sinh viên, Ký túc xá, Studio, Căn hộ mini..."
                      required
                    />
                    <datalist id="room-type-suggestions">
                      <option value="Phòng trọ sinh viên" />
                      <option value="Ký túc xá" />
                      <option value="Studio" />
                      <option value="Chung cư mini" />
                      <option value="Căn hộ mini" />
                      <option value="Homestay" />
                      <option value="Phòng ở ghép" />
                    </datalist>
                  </label>
                </div>

                <div className="form-grid two-cols">
                  <label className="form-field">
                    <span>Ngày có thể vào ở</span>
                    <input type="date" value={form.availableFrom} onChange={(e) => handleChange('availableFrom', e.target.value)} />
                  </label>

                  <label className="form-field">
                    <span>Mô tả nội thất</span>
                    <input
                      value={form.furnishingDetail}
                      onChange={(e) => handleChange('furnishingDetail', e.target.value)}
                      placeholder="Ví dụ: Đầy đủ nội thất, máy lạnh, tủ lạnh, giường..."
                    />
                  </label>
                </div>

                <label className="form-field">
                  <span>Mô tả</span>
                  <textarea value={form.description} onChange={(e) => handleChange('description', e.target.value)} rows="4" placeholder="Mô tả ưu điểm nổi bật của phòng..." />
                </label>

                <div className="form-grid four-cols">
                  <label className="form-field">
                    <span>Diện tích</span>
                    <input type="number" min="1" value={form.area} onChange={(e) => handleChange('area', e.target.value)} required />
                  </label>

                  <label className="form-field">
                    <span>Giá thuê</span>
                    <input type="number" min="1" value={form.price} onChange={(e) => handleChange('price', e.target.value)} required />
                  </label>

                  <label className="form-field">
                    <span>Tiền cọc</span>
                    <input type="number" min="0" value={form.depositAmount} onChange={(e) => handleChange('depositAmount', e.target.value)} />
                  </label>

                  <label className="form-field">
                    <span>Số người tối đa</span>
                    <input type="number" min="1" value={form.maxTenants} onChange={(e) => handleChange('maxTenants', e.target.value)} required />
                  </label>
                </div>

                <div className="form-grid four-cols">
                  <label className="form-field">
                    <span>Tiền điện</span>
                    <input type="number" min="0" value={form.electricPrice} onChange={(e) => handleChange('electricPrice', e.target.value)} />
                  </label>

                  <label className="form-field">
                    <span>Tiền nước</span>
                    <input type="number" min="0" value={form.waterPrice} onChange={(e) => handleChange('waterPrice', e.target.value)} />
                  </label>

                  <label className="form-field">
                    <span>Phí dịch vụ</span>
                    <input type="number" min="0" value={form.servicePrice} onChange={(e) => handleChange('servicePrice', e.target.value)} />
                  </label>

                  <label className="form-field checkbox-field">
                    <span>Nội thất</span>
                    <input type="checkbox" checked={form.furnished} onChange={(e) => handleChange('furnished', e.target.checked)} />
                  </label>
                </div>

                <div className="form-grid three-cols">
                  <label className="form-field">
                    <span>Giới tính phù hợp</span>
                    <select value={form.genderAllowed} onChange={(e) => handleChange('genderAllowed', e.target.value)}>
                      <option value="all">Tất cả</option>
                      <option value="male">Nam</option>
                      <option value="female">Nữ</option>
                    </select>
                  </label>

                  <label className="form-field">
                    <span>Trạng thái phòng</span>
                    <select value={form.status} onChange={(e) => handleChange('status', e.target.value)}>
                      <option value="available">Có sẵn</option>
                      <option value="reserved">Đã giữ chỗ</option>
                      <option value="rented">Đã thuê</option>
                      <option value="hidden">Ẩn</option>
                    </select>
                  </label>

                  <label className="form-field">
                    <span>Trạng thái duyệt</span>
                    <select value={form.approvalStatus} onChange={(e) => handleChange('approvalStatus', e.target.value)}>
                      <option value="approved">Đã duyệt</option>
                      <option value="pending">Chờ duyệt</option>
                      <option value="rejected">Từ chối</option>
                    </select>
                  </label>
                </div>

                <div className="form-field">
                  <span>Tiện ích</span>
                  <div className="chip-grid">
                    {amenities.map((amenity) => (
                      <button
                        key={amenity.id}
                        type="button"
                        className={`choice-chip${form.amenityIds.includes(amenity.id) ? ' selected' : ''}`}
                        onClick={() => toggleAmenity(amenity.id)}
                      >
                        {amenity.name}
                      </button>
                    ))}
                  </div>
                </div>

                <label className="form-field">
                  <span>Tiện ích tự thêm</span>
                  <textarea
                    value={form.customAmenitiesText}
                    onChange={(e) => handleChange('customAmenitiesText', e.target.value)}
                    rows="4"
                    placeholder={'Mỗi dòng là 1 tiện ích mới.\nVí dụ:\nMáy giặt riêng\nBan công rộng\nThang máy'}
                  />
                </label>

                <div className="form-field">
                  <span>Ảnh phòng</span>
                  <div className="multi-upload-box">
                    <input type="file" accept="image/*" multiple onChange={handleSelectImages} />
                    <p>Chọn nhiều ảnh cùng lúc. Bạn có thể chọn ảnh đại diện sau khi tải lên.</p>
                  </div>

                  {uploadingImages && <span className="uploading-note">Đang xử lý ảnh...</span>}

                  {form.images.length > 0 && (
                    <div className="image-preview-grid">
                      {form.images.map((image) => (
                        <div key={image.id} className="image-preview-card">
                          <img src={image.imageUrl} alt={image.fileName || 'Room'} />
                          <div className="image-preview-actions">
                            <button
                              type="button"
                              className={`ghost-button compact${image.isThumbnail ? ' active' : ''}`}
                              onClick={() => setThumbnail(image.id)}
                            >
                              {image.isThumbnail ? 'Ảnh đại diện' : 'Đặt làm đại diện'}
                            </button>
                            <button
                              type="button"
                              className="danger-button compact"
                              onClick={() => removeImage(image.id)}
                            >
                              Xóa ảnh
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

                <div className="form-actions">
                  <button type="submit" className="primary-button" disabled={submitting || uploadingImages}>
                    {submitting ? 'Đang lưu...' : editingId ? 'Lưu cập nhật' : 'Tạo phòng'}
                  </button>
                </div>
              </form>
            </div>
          )}

          {rooms.length === 0 ? (
            <div className="dashboard-empty">Chưa có phòng nào trong hệ thống.</div>
          ) : (
            <div className="table-shell">
              <table className="data-table">
                <thead>
                  <tr>
                    <th>STT</th>
                    <th>Mã phòng</th>
                    <th>Tên phòng</th>
                    <th>Khu trọ</th>
                    <th>Địa chỉ</th>
                    <th>Giá thuê</th>
                    <th>Diện tích</th>
                    <th>Ảnh</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                  </tr>
                </thead>
                <tbody>
                  {rooms.map((room, index) => (
                    <tr key={room.id}>
                      <td>{index + 1}</td>
                      <td>{room.roomCode}</td>
                      <td>
                        <strong>{room.title}</strong>
                        <div className="table-sub">{room.roomType || '---'} | {room.maxTenants} người | {room.genderAllowed}</div>
                      </td>
                      <td>{room.propertyName}</td>
                      <td className="table-address">{room.fullAddress}</td>
                      <td>{formatCurrency(room.price)} đ</td>
                      <td>{room.area} m²</td>
                      <td>{room.images?.length || 0} ảnh</td>
                      <td>
                        <span className={`status-pill ${room.status}`}>{room.status}</span>
                      </td>
                      <td>
                        <div className="table-actions">
                          <button type="button" className="ghost-button compact" onClick={() => openDetail(room)}>
                            Xem chi tiết
                          </button>
                          <button type="button" className="ghost-button compact" onClick={() => startEdit(room)}>
                            Sửa
                          </button>
                          <button type="button" className="danger-button compact" onClick={() => handleDelete(room.id)}>
                            Xóa
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        {selectedRoom && (
          <div className="detail-modal-backdrop" onClick={() => setSelectedRoom(null)}>
            <div className="detail-modal" onClick={(event) => event.stopPropagation()}>
              <div className="panel-heading">
                <div>
                  <h2>Chi tiết phòng</h2>
                  <p>{selectedRoom.title}</p>
                </div>
                <button type="button" className="ghost-button" onClick={() => setSelectedRoom(null)}>
                  Đóng
                </button>
              </div>

              <div className="detail-grid">
                <div className="detail-card">
                  <span>Mã phòng</span>
                  <strong>{selectedRoom.roomCode}</strong>
                </div>
                <div className="detail-card">
                  <span>Khu trọ</span>
                  <strong>{selectedRoom.propertyName}</strong>
                </div>
                <div className="detail-card">
                  <span>Loại trọ / phòng</span>
                  <strong>{selectedRoom.roomType || '---'}</strong>
                </div>
                <div className="detail-card">
                  <span>Giá thuê</span>
                  <strong>{formatCurrency(selectedRoom.price)} đ</strong>
                </div>
                <div className="detail-card">
                  <span>Diện tích</span>
                  <strong>{selectedRoom.area} m²</strong>
                </div>
              </div>

              <p className="stack-note">{selectedRoom.fullAddress}</p>
              {selectedRoom.description && <p className="stack-note">{selectedRoom.description}</p>}
              {selectedRoom.furnishingDetail && <p className="stack-note">Nội thất: {selectedRoom.furnishingDetail}</p>}

              <div className="tag-row">
                {selectedRoom.amenities.map((amenity) => (
                  <span key={amenity.id} className="mini-tag">{amenity.name}</span>
                ))}
              </div>

              <div className="detail-image-grid">
                {selectedRoom.images.length === 0 ? (
                  <div className="dashboard-empty">Phòng này chưa có ảnh.</div>
                ) : (
                  selectedRoom.images.map((image) => (
                    <div key={image.id} className="detail-image-card">
                      <img src={image.imageUrl} alt={selectedRoom.title} />
                      {image.isThumbnail && <span className="status-pill available detail-badge">Ảnh đại diện</span>}
                    </div>
                  ))
                )}
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  )
}
