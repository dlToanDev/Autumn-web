import { useState } from 'react'
import { useFormik } from 'formik'
import * as Yup from 'yup'
import { Link, useNavigate } from 'react-router-dom'
import { login } from '../api/authApi'
import AuthBrandMark from '../components/AuthBrandMark'
import PasswordField from '../components/PasswordField'
import { getHomePathForUser } from '../utils/auth'

const REMEMBERED_ACCOUNT_KEY = 'rememberedLoginAccount'

// Trang LoginPage
// Muc dich:
// - Cho phep nguoi dung dang nhap bang email hoac so dien thoai.
// - Sau khi dang nhap thanh cong, luu token vao localStorage de truy cap cac trang can dang nhap.
// Lien ket backend:
// - POST /api/auth/login (AuthController.Login).

// Validate form dang nhap.
const validationSchema = Yup.object({
  account: Yup.string().required('Vui lòng nhập email hoặc số điện thoại'),
  password: Yup.string().required('Vui lòng nhập mật khẩu'),
})

export default function LoginPage() {
  const navigate = useNavigate()
  const [rememberMe, setRememberMe] = useState(() => Boolean(localStorage.getItem(REMEMBERED_ACCOUNT_KEY)))
  const [error, setError] = useState('')
  const [loading, setLoading] = useState(false)

  const formik = useFormik({
    initialValues: {
      account: localStorage.getItem(REMEMBERED_ACCOUNT_KEY) || '',
      password: '',
    },
    validationSchema,
    onSubmit: async (values) => {
      // Goi API login, luu token/user vao localStorage.
      // response.data gom: { token, expiresAt, user }.
      setError('')
      setLoading(true)
      try {
        // API da tach vao authApi, page chi nhan/ve du lieu de render.
        const { token, user } = await login(values)
        if (rememberMe) {
          localStorage.setItem(REMEMBERED_ACCOUNT_KEY, values.account.trim())
        } else {
          localStorage.removeItem(REMEMBERED_ACCOUNT_KEY)
        }
        localStorage.setItem('token', token)
        localStorage.setItem('user', JSON.stringify(user))
        navigate(getHomePathForUser(user))
      } catch (err) {
        setError(err.response?.data?.message || 'Đăng nhập thất bại. Vui lòng thử lại.')
      } finally {
        setLoading(false)
      }
    },
  })

  // UI trang dang nhap.
  return (
    <div className="auth-wrapper">
      <div className="auth-container">
        <div className="auth-card auth-card-login">
          <div className="auth-header">
            <AuthBrandMark />
            <p className="auth-greeting">Xin chào bạn</p>
            <h1>Đăng Nhập</h1>
            <p className="auth-subtitle">Chào mừng bạn quay lại RentalPlatform</p>
          </div>

          {error && <div className="auth-error">{error}</div>}

          <form onSubmit={formik.handleSubmit} className="auth-form">
            <div className="form-group">
              <label htmlFor="account">Email hoặc Số điện thoại</label>
              <input
                id="account"
                name="account"
                type="text"
                autoComplete="username"
                placeholder="example@email.com"
                value={formik.values.account}
                onChange={formik.handleChange}
                onBlur={formik.handleBlur}
                className={formik.touched.account && formik.errors.account ? 'input-error' : ''}
              />
              {formik.touched.account && formik.errors.account && (
                <span className="field-error">{formik.errors.account}</span>
              )}
            </div>

            <PasswordField
              id="password"
              name="password"
              label="Mật khẩu"
              autoComplete="current-password"
              placeholder="••••••••"
              value={formik.values.password}
              onChange={formik.handleChange}
              onBlur={formik.handleBlur}
              touched={formik.touched.password}
              error={formik.errors.password}
            />

            <div className="auth-utility-row">
              <label className="remember-account">
                <input
                  type="checkbox"
                  checked={rememberMe}
                  onChange={(event) => setRememberMe(event.target.checked)}
                />
                <span>Nhớ tài khoản</span>
              </label>
              <Link to="/forgot-password" className="forgot-link">Quên mật khẩu?</Link>
            </div>

            <button type="submit" className="auth-btn" disabled={loading}>
              {loading ? (
                <span className="btn-loading">
                  <span className="spinner"></span> Đang xử lý...
                </span>
              ) : (
                'Đăng Nhập'
              )}
            </button>
          </form>

          <div className="auth-footer">
            <p>Chưa có tài khoản? <Link to="/register">Đăng ký ngay</Link></p>
          </div>
        </div>
      </div>
    </div>
  )
}
