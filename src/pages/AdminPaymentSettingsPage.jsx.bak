// Trang AdminPaymentSettingsPage quan ly system config lien quan thanh toan.
// Hien tai page dang sua commission rate va thoi gian het han QR.
import { useEffect, useState } from 'react'
import { Link } from 'react-router-dom'
import DashboardHeroBanner from '../components/DashboardHeroBanner'
import { getAdminPaymentSettings, updateAdminPaymentSettings } from '../api/systemConfigApi'

const initialForm = {
  commissionRate: '5',
  expireMinutes: '15',
}

export default function AdminPaymentSettingsPage() {
  const [form, setForm] = useState(initialForm)
  const [loading, setLoading] = useState(true)
  const [saving, setSaving] = useState(false)
  const [message, setMessage] = useState('')
  const [error, setError] = useState('')

  useEffect(() => {
    // Tai cau hinh hien tai tu system_configs.
    const loadSettings = async () => {
      setLoading(true)
      setError('')

      try {
        const data = await getAdminPaymentSettings()
        setForm({
          commissionRate: String(data.commissionRate ?? 5),
          expireMinutes: String(data.expireMinutes ?? 15),
        })
      } catch (err) {
        setError(err?.response?.data?.message || 'Không thể tải cấu hình thanh toán.')
      } finally {
        setLoading(false)
      }
    }

    loadSettings()
  }, [])

  const handleSubmit = async (event) => {
    // Doi chuoi trong form ve number truoc khi goi backend.
    event.preventDefault()
    setSaving(true)
    setMessage('')
    setError('')

    try {
      const updated = await updateAdminPaymentSettings({
        commissionRate: Number(form.commissionRate),
        expireMinutes: Number(form.expireMinutes),
      })

      setForm({
        commissionRate: String(updated.commissionRate ?? 5),
        expireMinutes: String(updated.expireMinutes ?? 15),
      })
      setMessage('Đã lưu cấu hình thanh toán thành công.')
    } catch (err) {
      setError(err?.response?.data?.message || 'Không thể lưu cấu hình thanh toán.')
    } finally {
      setSaving(false)
    }
  }

  if (loading) {
    return (
      <div className="dashboard-page">
        <div className="dashboard-container">
          <div className="dashboard-empty">Đang tải cấu hình thanh toán...</div>
        </div>
      </div>
    )
  }

  return (
    <div className="dashboard-page">
      <div className="dashboard-container room-manager-page">
        <DashboardHeroBanner
          title="Đây là trang cấu hình thanh toán hệ thống"
          description={[
            'Bạn có thể chỉnh tỷ lệ hoa hồng, thời gian hết hạn QR và các tham số điều hành dùng chung ngay tại đây.',
            'Nếu cần kiểm tra tác động với user hoặc landlord thực tế, hãy mở hộp tin.',
          ]}
          action={{ to: '/messages', label: 'Mở hộp tin' }}
        />

        <div className="inline-actions">
          <Link to="/admin" className="ghost-button card-link-button">
            Về dashboard admin
          </Link>
          <Link to="/profile" className="ghost-button card-link-button">
            Mở Profile để cấu hình bank
          </Link>
        </div>

        {message && <div className="alert success">{message}</div>}
        {error && <div className="alert error">{error}</div>}

        <section className="dashboard-panel contract-form-shell">
          <div className="panel-heading">
            <div>
              <h2>Thông số hệ thống</h2>
              <p>`LANDLORD` và `ADMIN` sẽ tự nhập `bank_id`, `số tài khoản`, `tên tài khoản` và `template VietQR` trong trang Profile của họ.</p>
            </div>
          </div>

          <form className="dashboard-form" onSubmit={handleSubmit}>
            <div className="form-grid two-cols">
              <label className="form-field">
                <span>Hoa hồng mặc định (%)</span>
                <input
                  type="number"
                  min="0"
                  max="100"
                  step="0.1"
                  value={form.commissionRate}
                  onChange={(event) => setForm((prev) => ({ ...prev, commissionRate: event.target.value }))}
                  required
                />
              </label>

              <label className="form-field">
                <span>Thời gian hết hạn QR (phút)</span>
                <input
                  type="number"
                  min="5"
                  max="1440"
                  step="1"
                  value={form.expireMinutes}
                  onChange={(event) => setForm((prev) => ({ ...prev, expireMinutes: event.target.value }))}
                  required
                />
              </label>
            </div>

            <div className="detail-disabled-box">
              Luồng mới hoạt động như sau: chủ trọ tự cấu hình tài khoản nhận tiền trong Profile rồi tạo QR gửi người thuê. Admin cũng tự cấu hình Profile của mình để tạo QR hoa hồng gửi cho chủ trọ mỗi tháng. Mức hoa hồng hiện được tính theo `tổng tiền thuê thành công trong tháng x commissionRate`.
            </div>

            <div className="inline-actions">
              <button type="submit" className="primary-button" disabled={saving}>
                {saving ? 'Đang lưu...' : 'Lưu cấu hình'}
              </button>
            </div>
          </form>
        </section>
      </div>
    </div>
  )
}
