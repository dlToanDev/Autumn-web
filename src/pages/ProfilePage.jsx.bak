import { useEffect, useState } from 'react'
import { useNavigate } from 'react-router-dom'
import { deleteMe, getMe, updateMe } from '../api/authApi'

// Trang ProfilePage
// Muc dich:
// - Hien thi day du thong tin user tu bang users.
// - Cho phep cap nhat profile (sua thong tin) va xoa tai khoan.
// Lien ket backend:
// - GET /api/auth/me
// - PUT /api/auth/me
// - DELETE /api/auth/me
export default function ProfilePage() {
  const navigate = useNavigate()
  const [loading, setLoading] = useState(true)
  const [saving, setSaving] = useState(false)
  const [deleting, setDeleting] = useState(false)
  const [error, setError] = useState('')
  const [success, setSuccess] = useState('')

  const [form, setForm] = useState({
    roleId: 'user',
    roleCode: '',
    roleName: '',
    status: '',
    isVerified: false,
    createdAt: '',
    updatedAt: '',
    fullName: '',
    email: '',
    phone: '',
    avatarUrl: '',
    gender: 'other',
    dateOfBirth: '',
    address: '',
    hometown: '',
    vietQrBankId: '',
    bankAccountNo: '',
    bankAccountName: '',
    vietQrTemplate: 'compact2',
  })

  const mapUserToForm = (user) => ({
    roleId: user.roleId ?? '',
    roleCode: user.roleCode ?? '',
    roleName: user.roleName ?? user.roleCode ?? '',
    status: user.status ?? '',
    isVerified: Boolean(user.isVerified),
    createdAt: user.createdAt ? new Date(user.createdAt).toLocaleString('vi-VN') : '',
    updatedAt: user.updatedAt ? new Date(user.updatedAt).toLocaleString('vi-VN') : '',
    fullName: user.fullName ?? '',
    email: user.email ?? '',
    phone: user.phone ?? '',
    avatarUrl: user.avatarUrl ?? '',
    gender: user.gender ?? 'other',
    dateOfBirth: user.dateOfBirth ? String(user.dateOfBirth).slice(0, 10) : '',
    address: user.address ?? '',
    hometown: user.hometown ?? '',
    vietQrBankId: user.vietQrBankId ?? '',
    bankAccountNo: user.bankAccountNo ?? '',
    bankAccountName: user.bankAccountName ?? '',
    vietQrTemplate: user.vietQrTemplate ?? 'compact2',
  })

  useEffect(() => {
    const token = localStorage.getItem('token')
    if (!token) {
      navigate('/login')
      return
    }

    const loadProfile = async () => {
      setLoading(true)
      setError('')
      try {
        // Lay profile qua authApi, page khong tu viet endpoint.
        const userInfo = await getMe()
        setForm(mapUserToForm(userInfo))
      } catch (err) {
        localStorage.removeItem('token')
        localStorage.removeItem('user')
        setError(err.response?.data?.message || 'Không thể tải thông tin profile.')
        navigate('/login')
      } finally {
        setLoading(false)
      }
    }

    loadProfile()
  }, [navigate])

  const onChange = (event) => {
    const { name, value } = event.target
    setForm((prev) => ({ ...prev, [name]: value }))
  }

  const onSave = async (event) => {
    event.preventDefault()
    setSaving(true)
    setError('')
    setSuccess('')

    try {
      const payload = {
        fullName: form.fullName,
        email: form.email || null,
        phone: form.phone || null,
        avatarUrl: form.avatarUrl || null,
        gender: form.gender,
        dateOfBirth: form.dateOfBirth || null,
        address: form.address || null,
        hometown: form.hometown || null,
        vietQrBankId: form.vietQrBankId || null,
        bankAccountNo: form.bankAccountNo || null,
        bankAccountName: form.bankAccountName || null,
        vietQrTemplate: form.vietQrTemplate || null,
      }

      const updatedUser = await updateMe(payload)

      // Dong bo user local de header hien thi ten/avatar moi ngay lap tuc.
      localStorage.setItem('user', JSON.stringify(updatedUser))
      setForm(mapUserToForm(updatedUser))
      setSuccess('Đã cập nhật profile thành công.')
    } catch (err) {
      setError(err.response?.data?.message || 'Cập nhật profile thất bại.')
    } finally {
      setSaving(false)
    }
  }

  const onDeleteAccount = async () => {
    const accepted = window.confirm('Bạn chắc chắn muốn xóa tài khoản? Hành động này không thể hoàn tác.')
    if (!accepted) return

    setDeleting(true)
    setError('')
    setSuccess('')
    try {
      await deleteMe()
      localStorage.removeItem('token')
      localStorage.removeItem('user')
      navigate('/login')
    } catch (err) {
      setError(err.response?.data?.message || 'Xóa tài khoản thất bại.')
    } finally {
      setDeleting(false)
    }
  }

  const onAvatarFileChange = (event) => {
    const file = event.target.files?.[0]
    if (!file) return

    if (!file.type.startsWith('image/')) {
      setError('Vui lòng chọn file ảnh hợp lệ.')
      return
    }

    const reader = new FileReader()
    reader.onload = () => {
      const result = typeof reader.result === 'string' ? reader.result : ''
      setForm((prev) => ({ ...prev, avatarUrl: result }))
    }
    reader.readAsDataURL(file)
  }

  if (loading) {
    return (
      <div className="auth-wrapper">
        <div className="auth-container">
          <div className="loading-screen">
            <span className="spinner large"></span>
            <p>Đang tải profile...</p>
          </div>
        </div>
      </div>
    )
  }

  const canConfigurePayment = form.roleCode === 'LANDLORD' || form.roleCode === 'ADMIN'

  return (
    <div className="profile-wrapper">
      <div className="profile-container">
        <div className="profile-card">
          <div className="profile-header">
            <h1>Profile Người Dùng</h1>
            <p>Cập nhật thông tin cá nhân trong bảng users</p>
          </div>

          {error && <div className="auth-error">{error}</div>}
          {success && <div className="auth-success">{success}</div>}

          <form className="auth-form" onSubmit={onSave}>
            <div className="profile-avatar-box">
              <div className="profile-avatar-preview">
                {form.avatarUrl ? (
                  <img src={form.avatarUrl} alt="Avatar" />
                ) : (
                  <span>{form.fullName?.charAt(0)?.toUpperCase() || 'U'}</span>
                )}
              </div>
              <div className="form-group">
                <label htmlFor="roleId">Role ID</label>
                <input id="roleId" name="roleId" value={form.roleId} readOnly />
              </div>
            </div>

            <div className="form-row">
              <div className="form-group">
                <label htmlFor="roleName">Vai trò</label>
                <input id="roleName" name="roleName" value={form.roleName} readOnly />
              </div>
              <div className="form-group">
                <label htmlFor="status">Trạng thái</label>
                <input id="status" name="status" value={form.status} readOnly />
              </div>
            </div>

            <div className="form-row">
              <div className="form-group">
                <label htmlFor="isVerified">Đã xác minh</label>
                <input id="isVerified" name="isVerified" value={form.isVerified ? 'true' : 'false'} readOnly />
              </div>
              <div className="form-group">
                <label htmlFor="gender">Giới tính</label>
                <select id="gender" name="gender" value={form.gender} onChange={onChange}>
                  <option value="other">other</option>
                  <option value="male">male</option>
                  <option value="female">female</option>
                </select>
              </div>
            </div>

            <div className="form-group">
              <label htmlFor="fullName">Họ tên</label>
              <input id="fullName" name="fullName" value={form.fullName} onChange={onChange} required />
            </div>

            <div className="form-row">
              <div className="form-group">
                <label htmlFor="email">Email</label>
                <input id="email" name="email" type="email" value={form.email} onChange={onChange} />
              </div>
              <div className="form-group">
                <label htmlFor="phone">Số điện thoại</label>
                <input id="phone" name="phone" value={form.phone} onChange={onChange} />
              </div>
            </div>

            <div className="form-group">
              <label htmlFor="avatarFile">Ảnh đại diện</label>
              <input id="avatarFile" name="avatarFile" type="file" accept="image/*" onChange={onAvatarFileChange} />
              <small className="field-hint">Chọn file ảnh để cập nhật avatar</small>
            </div>

            <div className="form-row">
              <div className="form-group">
                <label htmlFor="dateOfBirth">Ngày sinh</label>
                <input id="dateOfBirth" name="dateOfBirth" type="date" value={form.dateOfBirth} onChange={onChange} />
              </div>
              <div className="form-group">
                <label htmlFor="createdAt">Ngày tạo</label>
                <input id="createdAt" name="createdAt" value={form.createdAt} readOnly />
              </div>
            </div>

            <div className="form-row">
              <div className="form-group">
                <label htmlFor="address">Địa chỉ</label>
                <input id="address" name="address" value={form.address} onChange={onChange} />
              </div>
              <div className="form-group">
                <label htmlFor="hometown">Quê quán</label>
                <input id="hometown" name="hometown" value={form.hometown} onChange={onChange} />
              </div>
            </div>

            {canConfigurePayment && (
              <>
                <div className="form-group">
                  <label htmlFor="vietQrBankId">Mã ngân hàng VietQR</label>
                  <input
                    id="vietQrBankId"
                    name="vietQrBankId"
                    value={form.vietQrBankId}
                    onChange={onChange}
                    placeholder="mbbank, VCB, ACB..."
                  />
                  <small className="field-hint">Dùng cho QR nhận tiền. Chủ trọ nhận tiền thuê, admin nhận tiền hoa hồng.</small>
                </div>

                <div className="form-row">
                  <div className="form-group">
                    <label htmlFor="bankAccountNo">Số tài khoản nhận tiền</label>
                    <input
                      id="bankAccountNo"
                      name="bankAccountNo"
                      value={form.bankAccountNo}
                      onChange={onChange}
                    />
                  </div>
                  <div className="form-group">
                    <label htmlFor="bankAccountName">Tên tài khoản</label>
                    <input
                      id="bankAccountName"
                      name="bankAccountName"
                      value={form.bankAccountName}
                      onChange={onChange}
                    />
                  </div>
                </div>

                <div className="form-group">
                  <label htmlFor="vietQrTemplate">Template VietQR</label>
                  <input
                    id="vietQrTemplate"
                    name="vietQrTemplate"
                    value={form.vietQrTemplate}
                    onChange={onChange}
                    placeholder="compact2"
                  />
                </div>
              </>
            )}

            <div className="form-group">
              <label htmlFor="updatedAt">Cập nhật lần cuối</label>
              <input id="updatedAt" name="updatedAt" value={form.updatedAt} readOnly />
            </div>

            <div className="profile-actions">
              <button type="submit" className="auth-btn" disabled={saving}>
                {saving ? 'Đang lưu...' : 'Lưu Thay Đổi'}
              </button>
              <button type="button" className="danger-btn" onClick={onDeleteAccount} disabled={deleting}>
                {deleting ? 'Đang xóa...' : 'Xóa Tài Khoản'}
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  )
}
