// Trang HomePage la landing page/public home cua he thong.
// Muc dich:
// - Lay mot nhom phong noi bat tu backend
// - Hien CTA theo trang thai dang nhap cua user
// - Tai su dung cho ca guest va user home thong qua UserHomePage
import { useEffect, useMemo, useState } from 'react'
import { Link, useLocation } from 'react-router-dom'
import { FiArrowRight, FiCheckCircle, FiClock, FiStar, FiSearch, FiDollarSign, FiMessageCircle } from 'react-icons/fi'
import { getRooms } from '../api/rentalApi'
import RoomCard from '../components/RoomCard'
import { getDefaultRoute, getStoredAuth } from '../utils/auth'
import '../styles/pages/HomePage.css'

const whyChooseUs = [
  {
    icon: FiSearch,
    title: 'Tìm Kiếm Thông Minh',
    description: 'Công nghệ AI giúp tìm phòng phù hợp với nhu cầu và ngân sách của bạn chỉ trong vài giây'
  },
  {
    icon: FiDollarSign,
    title: 'Thanh Toán An Toàn',
    description: 'Hệ thống thanh toán bảo mật với QR code, chuyển khoản và xác minh giao dịch tự động'
  },
  {
    icon: FiMessageCircle,
    title: 'Hỗ Trợ 24/7',
    description: 'Đội ngũ chăm sóc khách hàng chuyên nghiệp luôn sẵn sàng hỗ trợ bạn mọi lúc mọi nơi'
  }
]

export default function HomePage() {
  const location = useLocation()
  // auth chi doc mot lan de xac dinh CTA "vao trang cua toi" hay "tim phong".
  const auth = useMemo(() => getStoredAuth(), [])
  const [rooms, setRooms] = useState([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState('')

  useEffect(() => {
    // Landing page chi can mot request room public de tao noi dung hero + section noi bat.
    const loadRooms = async () => {
      setLoading(true)
      setError('')

      try {
        const roomData = await getRooms()
        setRooms(roomData)
      } catch (err) {
        setError(err?.response?.data?.message || 'Không thể tải danh sách phòng nổi bật.')
      } finally {
        setLoading(false)
      }
    }

    loadRooms()
  }, [])

  const availableRooms = rooms.filter((room) => String(room.status).toLowerCase() === 'available')
  const featuredRooms = (availableRooms.length > 0 ? availableRooms : rooms).slice(0, 6)
  const nextPath = getDefaultRoute(auth.isLoggedIn, auth.user)
  const isUserHome = location.pathname === '/user'
  const primaryAction = auth.isLoggedIn
    ? (isUserHome
      ? { to: '/user/rooms', label: 'Tìm phòng' }
      : { to: nextPath, label: 'Vào trang của tôi' })
    : { to: '/login', label: 'Đăng nhập' }

  return (
    <div className="home-page">
      {/* Hero Section */}
      <section className="hero-section">
        <div className="hero-container">
          <div className="hero-content">
            <span className="hero-badge">
              <FiStar /> Ưu điểm
            </span>
            <h1 className="hero-title">Tại Sao Chọn Chúng Tôi</h1>
            <p className="hero-subtitle">
              Trải nghiệm thuê phòng hoàn toàn mới với các tính năng vượt trội
            </p>

            <div className="form-actions">
              <Link to={primaryAction.to} className="primary-button">
                {primaryAction.label}
                <FiArrowRight />
              </Link>
              {!auth.isLoggedIn && (
                <Link to="/register" className="secondary-button">
                  Đăng ký
                </Link>
              )}
            </div>
          </div>
        </div>
      </section>

      {/* Why Choose Us Section */}
      <section className="why-choose-section">
        <div className="why-choose-container">
          {whyChooseUs.map((item, index) => {
            const Icon = item.icon
            return (
              <div key={index} className="why-choose-card">
                <div className="why-choose-icon">
                  <Icon />
                </div>
                <h3 className="why-choose-title">{item.title}</h3>
                <p className="why-choose-description">{item.description}</p>
              </div>
            )
          })}
        </div>
      </section>

      {/* Featured Rooms Section */}
      <section className="featured-rooms-section">
        <div className="section-header">
          <div className="section-header-badge">
            <FiStar /> Nổi bật
          </div>
          <h2 className="section-title">Phòng Trọ Cao Cấp</h2>
          <p className="section-subtitle">
            Những lựa chọn được đánh giá cao nhất từ cộng đồng người thuê
          </p>
        </div>

        {error && <div className="alert error">{error}</div>}

        {loading ? (
          <div className="loading-state">Đang tải phòng nổi bật...</div>
        ) : featuredRooms.length === 0 ? (
          <div className="empty-state">Chưa có phòng nào để hiển thị.</div>
        ) : (
          <div className="rooms-grid">
            {featuredRooms.map((room) => (
              <RoomCard key={room.id} room={room} />
            ))}
          </div>
        )}
      </section>

      {/* Trust Indicators Section */}
      <section className="trust-section">
        <div className="trust-container">
          <div className="trust-item">
            <FiCheckCircle className="trust-icon" />
            <span>Tin đăng dễ quét</span>
          </div>
          <div className="trust-item">
            <FiClock className="trust-icon" />
            <span>Luồng thao tác nhanh</span>
          </div>
          <div className="trust-item">
            <FiStar className="trust-icon" />
            <span>Trải nghiệm thống nhất</span>
          </div>
        </div>
      </section>
    </div>
  )
}
