// Trang LandlordTenantsPage la noi chu tro quan ly nguoi thue sau khi booking hop le.
// Tu day chu tro co the tao hop dong, thu tien va theo doi thanh toan.
import { useEffect, useMemo, useState } from 'react'
import ContractDetailModal from '../components/ContractDetailModal'
import DashboardHeroBanner from '../components/DashboardHeroBanner'
import PaymentQrModal from '../components/PaymentQrModal'
import {
  createLandlordContract,
  getLandlordContractById,
  getLandlordTenants,
  uploadLandlordContractFile,
} from '../api/contractApi'
import {
  createLandlordVietQrPayment,
  deleteExpiredPayment,
  getPaymentByCode,
  getMyPayments,
  markLandlordPaymentPaid,
} from '../api/paymentApi'
import { fileToDataUrl } from '../utils/file'
import {
  formatRentBillingLabel,
  getCurrentRentBillingPeriod,
  isDueDatePassed,
  isRentPaymentSuccess,
  mapBillingPaymentsByBooking,
} from '../utils/rentBilling'
import {
  formatContractStatusLabel,
  formatCurrency,
  formatDate,
  formatDateTime,
  formatRoomStatusLabel,
} from '../utils/rentalFormat'

function addMonths(dateValue, months) {
  // Tinh nhanh ngay ket thuc hop dong mac dinh.
  const date = new Date(dateValue)
  date.setMonth(date.getMonth() + months)
  return date.toISOString().slice(0, 10)
}

function getInitialContractForm(tenant) {
  // Khoi tao form contract dua tren thong tin tenant/booking hien tai.
  const startDate = tenant.moveInDate ? String(tenant.moveInDate).slice(0, 10) : new Date().toISOString().slice(0, 10)
  const endDate = addMonths(startDate, Math.max(Number(tenant.monthsToRent || 1), 1))

  return {
    bookingRequestId: tenant.bookingRequestId,
    startDate,
    endDate,
    terms: '',
  }
}

function formatPaymentStatusLabel(value) {
  const normalized = String(value || '').toLowerCase()
  if (normalized === 'pending') return 'Đang chờ thanh toán'
  if (normalized === 'waiting_confirm') return 'Chờ bạn xác nhận'
  if (normalized === 'success') return 'Đã xác nhận thanh toán'
  if (normalized === 'failed') return 'Thanh toán thất bại'
  if (normalized === 'canceled') return 'Đã hủy'
  if (normalized === 'expired') return 'QR đã hết hạn'
  return value || '---'
}

function canConfirmPayment(payment) {
  const normalized = String(payment?.status || '').toLowerCase()
  return normalized === 'waiting_confirm'
}

function canDeleteExpiredPayment(payment) {
  return String(payment?.status || '').toLowerCase() === 'expired'
}

function getRentCycleStatusTone(payment, isOverdue) {
  const normalized = String(payment?.status || '').toLowerCase()
  if (normalized === 'success') return 'success'
  if (normalized === 'waiting_confirm') return 'waiting_confirm'
  if (normalized === 'pending') return 'pending'
  if (normalized === 'expired') return 'expired'
  return isOverdue ? 'due' : 'missing'
}

function getRentCycleStatusLabel(payment, isOverdue) {
  const normalized = String(payment?.status || '').toLowerCase()
  if (normalized === 'success') return 'Đã xác nhận tháng này'
  if (normalized === 'waiting_confirm') return 'Chờ xác nhận tháng này'
  if (normalized === 'pending') return 'QR đang chờ thanh toán'
  if (normalized === 'expired') return 'QR tháng này đã hết hạn'
  return isOverdue ? 'Đã tới hạn nhưng chưa có QR' : 'Chưa tạo QR tháng này'
}

function getRentCycleButtonClass(payment) {
  return isRentPaymentSuccess(payment?.status) ? 'success-button compact' : 'danger-button compact'
}

function getRentCycleButtonLabel(payment) {
  const normalized = String(payment?.status || '').toLowerCase()
  if (normalized === 'success') return 'Đã thanh toán tháng này'
  if (normalized === 'waiting_confirm') return 'Chờ xác nhận thanh toán'
  if (normalized === 'pending') return 'Mở QR tháng này'
  if (normalized === 'expired') return 'Tạo lại QR tháng này'
  return 'Tạo QR tiền thuê tháng này'
}

export default function LandlordTenantsPage() {
  const [tenants, setTenants] = useState([])
  const [payments, setPayments] = useState([])
  const [paymentFilter, setPaymentFilter] = useState('all')
  const [selectedTenant, setSelectedTenant] = useState(null)
  const [contractForm, setContractForm] = useState(null)
  const [selectedContract, setSelectedContract] = useState(null)
  const [selectedPayment, setSelectedPayment] = useState(null)
  const [loading, setLoading] = useState(true)
  const [submitting, setSubmitting] = useState(false)
  const [uploading, setUploading] = useState(false)
  const [detailLoading, setDetailLoading] = useState(false)
  const [paymentRefreshing, setPaymentRefreshing] = useState(false)
  const [paymentCreatingBookingId, setPaymentCreatingBookingId] = useState(0)
  const [paymentOpeningCode, setPaymentOpeningCode] = useState('')
  const [confirmingPaymentCode, setConfirmingPaymentCode] = useState('')
  const [message, setMessage] = useState('')
  const [error, setError] = useState('')
  const [paymentError, setPaymentError] = useState('')

  const loadTenants = async () => {
    const data = await getLandlordTenants()
    setTenants(Array.isArray(data) ? data : [])
    return Array.isArray(data) ? data : []
  }

  const loadPayments = async () => {
    const data = await getMyPayments()
    const nextPayments = Array.isArray(data) ? data : []
    setPayments(nextPayments)
    return nextPayments
  }

  const loadDashboardData = async () => {
    const [tenantData] = await Promise.all([loadTenants(), loadPayments()])
    return tenantData
  }

  useEffect(() => {
    const loadInitial = async () => {
      setLoading(true)
      setError('')

      try {
        await loadDashboardData()
      } catch (err) {
        setError(err?.response?.data?.message || 'Không thể tải danh sách người thuê.')
      } finally {
        setLoading(false)
      }
    }

    loadInitial()
  }, [])

  const billingPeriod = useMemo(() => getCurrentRentBillingPeriod(), [])
  const currentRentPaymentMap = useMemo(
    () => mapBillingPaymentsByBooking(payments, billingPeriod.year, billingPeriod.month),
    [billingPeriod.month, billingPeriod.year, payments],
  )

  const tenantsWithBilling = useMemo(() => {
    return tenants.map((tenant) => {
      const currentRentPayment = currentRentPaymentMap.get(Number(tenant.bookingRequestId)) || null
      const dueDate = billingPeriod.dueDate
      const isCurrentRentPaid = isRentPaymentSuccess(currentRentPayment?.status)
      const isCurrentRentOverdue = !isCurrentRentPaid && isDueDatePassed(dueDate)

      return {
        ...tenant,
        currentRentPayment,
        currentRentDueDate: dueDate,
        isCurrentRentPaid,
        isCurrentRentOverdue,
      }
    })
  }, [billingPeriod.dueDate, currentRentPaymentMap, tenants])

  const stats = useMemo(() => ({
    total: tenantsWithBilling.length,
    noContract: tenantsWithBilling.filter((item) => !item.hasContract).length,
    awaitingSignatures: tenantsWithBilling.filter((item) => item.contractStatus === 'awaiting_signatures').length,
    signed: tenantsWithBilling.filter((item) => item.contractStatus === 'signed').length,
    waitingPayment: tenantsWithBilling.filter((item) => !item.isCurrentRentPaid).length,
    paidRent: tenantsWithBilling.filter((item) => item.isCurrentRentPaid).length,
  }), [tenantsWithBilling])

  const filteredTenants = useMemo(() => {
    return tenantsWithBilling.filter((tenant) => {
      if (paymentFilter === 'paid') return tenant.isCurrentRentPaid
      if (paymentFilter === 'unpaid') return !tenant.isCurrentRentPaid
      return true
    })
  }, [paymentFilter, tenantsWithBilling])

  const currentBillingLabel = useMemo(
    () => formatRentBillingLabel(billingPeriod.year, billingPeriod.month),
    [billingPeriod.month, billingPeriod.year],
  )

  const openCreateContract = (tenant) => {
    setSelectedTenant(tenant)
    setContractForm(getInitialContractForm(tenant))
    setMessage('')
    setError('')
    setSelectedContract(null)
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }

  const closeCreateContract = () => {
    setSelectedTenant(null)
    setContractForm(null)
  }

  const handleCreateContract = async (event) => {
    event.preventDefault()
    if (!contractForm) return

    setSubmitting(true)
    setMessage('')
    setError('')

    try {
      const createdContract = await createLandlordContract({
        bookingRequestId: contractForm.bookingRequestId,
        startDate: contractForm.startDate,
        endDate: contractForm.endDate,
        terms: contractForm.terms || null,
      })

      setMessage('Đã tạo hợp đồng online thành công.')
      closeCreateContract()
      await loadDashboardData()
      setSelectedContract(createdContract)
    } catch (err) {
      setError(err?.response?.data?.message || 'Không thể tạo hợp đồng.')
    } finally {
      setSubmitting(false)
    }
  }

  const openContractDetail = async (contractId) => {
    setDetailLoading(true)
    setSelectedContract({})
    setError('')

    try {
      const data = await getLandlordContractById(contractId)
      setSelectedContract(data)
    } catch (err) {
      setError(err?.response?.data?.message || 'Không thể tải chi tiết hợp đồng.')
      setSelectedContract(null)
    } finally {
      setDetailLoading(false)
    }
  }

  const handleLandlordFileUpload = async (event) => {
    const file = event.target.files?.[0]
    if (!file || !selectedContract?.id) return

    setUploading(true)
    setMessage('')
    setError('')

    try {
      const fileUrl = await fileToDataUrl(file)
      const updatedContract = await uploadLandlordContractFile(selectedContract.id, { fileUrl })
      setSelectedContract(updatedContract)
      await loadDashboardData()
      setMessage('Đã tải bản hợp đồng do chủ trọ ký lên hệ thống.')
    } catch (err) {
      setError(err?.response?.data?.message || err.message || 'Không thể tải file hợp đồng.')
    } finally {
      setUploading(false)
      event.target.value = ''
    }
  }

  const handleCreateRentQr = async (tenant) => {
    if (!tenant?.bookingRequestId) return

    setPaymentCreatingBookingId(tenant.bookingRequestId)
    setMessage('')
    setError('')
    setPaymentError('')

    try {
      const payment = await createLandlordVietQrPayment({
        bookingRequestId: tenant.bookingRequestId,
        paymentType: 'rent',
      })

      setSelectedPayment(payment)
      await loadDashboardData()
      setMessage('Đã tạo mã QR tiền thuê và gửi cho người thuê.')
    } catch (err) {
      setError(err?.response?.data?.message || 'Không thể tạo QR tiền thuê.')
    } finally {
      setPaymentCreatingBookingId(0)
    }
  }

  const openPaymentDetail = async (paymentCode) => {
    if (!paymentCode) return

    setPaymentOpeningCode(paymentCode)
    setPaymentError('')
    setMessage('')

    try {
      const payment = await getPaymentByCode(paymentCode)
      setSelectedPayment(payment)
      setPayments((prev) => {
        const exists = prev.some((item) => item.paymentCode === payment.paymentCode)
        return exists
          ? prev.map((item) => (item.paymentCode === payment.paymentCode ? payment : item))
          : [payment, ...prev]
      })
    } catch (err) {
      setPaymentError(err?.response?.data?.message || 'Không thể mở payment này.')
    } finally {
      setPaymentOpeningCode('')
    }
  }

  const refreshSelectedPayment = async () => {
    if (!selectedPayment?.paymentCode) return

    setPaymentRefreshing(true)
    setPaymentError('')

    try {
      const payment = await getPaymentByCode(selectedPayment.paymentCode)
      setSelectedPayment(payment)
      setPayments((prev) => prev.map((item) => (
        item.paymentCode === payment.paymentCode ? payment : item
      )))
      await loadDashboardData()
      setMessage('Đã cập nhật trạng thái payment mới nhất.')
    } catch (err) {
      setPaymentError(err?.response?.data?.message || 'Không thể cập nhật trạng thái payment.')
    } finally {
      setPaymentRefreshing(false)
    }
  }

  const confirmPaymentByCode = async (paymentCode) => {
    if (!paymentCode) return

    setConfirmingPaymentCode(paymentCode)
    setPaymentError('')
    setMessage('')

    try {
      const payment = await markLandlordPaymentPaid(paymentCode)
      if (selectedPayment?.paymentCode === payment.paymentCode) {
        setSelectedPayment(payment)
      }
      await loadDashboardData()
      setMessage('Đã xác nhận thanh toán cho người thuê.')
    } catch (err) {
      setPaymentError(err?.response?.data?.message || 'Không thể xác nhận thanh toán.')
    } finally {
      setConfirmingPaymentCode('')
    }
  }

  const handleMarkPaymentPaid = async () => {
    if (!selectedPayment?.paymentCode) return
    await confirmPaymentByCode(selectedPayment.paymentCode)
  }

  const handleDeleteExpiredPayment = async (paymentCode) => {
    if (!paymentCode) return

    const shouldDelete = window.confirm('QR này đã hết hạn. Bạn có muốn xóa để tạo QR mới không?')
    if (!shouldDelete) return

    setPaymentOpeningCode(paymentCode)
    setPaymentError('')
    setMessage('')

    try {
      await deleteExpiredPayment(paymentCode)
      if (selectedPayment?.paymentCode === paymentCode) {
        setSelectedPayment(null)
      }
      await loadDashboardData()
      setMessage('Đã xóa QR hết hạn. Bạn có thể tạo QR mới cho người thuê này.')
    } catch (err) {
      setPaymentError(err?.response?.data?.message || 'Không thể xóa QR hết hạn.')
    } finally {
      setPaymentOpeningCode('')
    }
  }

  if (loading) {
    return (
      <div className="dashboard-page">
        <div className="dashboard-container">
          <div className="dashboard-empty">Đang tải danh sách người thuê...</div>
        </div>
      </div>
    )
  }

  return (
    <div className="dashboard-page">
      <div className="dashboard-container room-manager-page">
        <DashboardHeroBanner
          title="Đây là trang quản lý người thuê và hợp đồng"
          description={[
            `Bạn có thể theo dõi người thuê, tạo hợp đồng, phát hành QR ${currentBillingLabel} và xác nhận thanh toán trên cùng một màn hình.`,
            `Từ ngày 05 hằng tháng, kỳ tiền thuê chưa hoàn tất sẽ được tô đỏ để bạn kiểm soát nhanh hơn.`,
            'Nếu có hồ sơ cần hỗ trợ gấp hoặc cần kiểm tra trạng thái, hãy liên hệ admin.',
          ]}
          action={{ to: '/messages', label: 'Liên hệ admin' }}
        />

        <div className="hero-stats dashboard-metric-grid">
          <div className="hero-stat-card">
            <strong>{stats.total}</strong>
            <span>người thuê đang quản lý</span>
          </div>
          <div className="hero-stat-card">
            <strong>{stats.noContract}</strong>
            <span>chưa có hợp đồng</span>
          </div>
          <div className="hero-stat-card">
            <strong>{stats.awaitingSignatures}</strong>
            <span>hợp đồng chờ đủ chữ ký</span>
          </div>
          <div className="hero-stat-card">
            <strong>{stats.signed}</strong>
            <span>hợp đồng đã ký đủ</span>
          </div>
          <div className="hero-stat-card">
            <strong>{stats.waitingPayment}</strong>
            <span>chưa thanh toán</span>
          </div>
          <div className="hero-stat-card">
            <strong>{stats.paidRent}</strong>
            <span>payment đã xác nhận</span>
          </div>
        </div>

        {message && <div className="alert success">{message}</div>}
        {error && <div className="alert error">{error}</div>}
        {paymentError && !selectedPayment && <div className="alert error">{paymentError}</div>}

        {contractForm && selectedTenant && (
          <section className="dashboard-panel contract-form-shell">
            <div className="panel-heading">
              <div>
                <h2>Tạo hợp đồng online</h2>
                <p>{selectedTenant.tenantName} - {selectedTenant.roomTitle}</p>
              </div>
              <button type="button" className="ghost-button" onClick={closeCreateContract}>
                Hủy
              </button>
            </div>

            <form className="dashboard-form" onSubmit={handleCreateContract}>
              <div className="form-grid two-cols">
                <label className="form-field">
                  <span>Ngày bắt đầu</span>
                  <input
                    type="date"
                    value={contractForm.startDate}
                    onChange={(event) => setContractForm((prev) => ({ ...prev, startDate: event.target.value }))}
                    required
                  />
                </label>
                <label className="form-field">
                  <span>Ngày kết thúc</span>
                  <input
                    type="date"
                    value={contractForm.endDate}
                    onChange={(event) => setContractForm((prev) => ({ ...prev, endDate: event.target.value }))}
                    required
                  />
                </label>
              </div>

              <label className="form-field">
                <span>Điều khoản bổ sung</span>
                <textarea
                  value={contractForm.terms}
                  onChange={(event) => setContractForm((prev) => ({ ...prev, terms: event.target.value }))}
                  placeholder="Ví dụ: Thanh toán trước ngày 05 hằng tháng, giữ gìn vệ sinh, không nuôi thú cưng..."
                />
              </label>

              <button type="submit" className="primary-button" disabled={submitting}>
                {submitting ? 'Đang tạo...' : 'Tạo hợp đồng'}
              </button>
            </form>
          </section>
        )}

        <section className="dashboard-panel">
          <div className="room-toolbar">
            <div>
              <h2>Quản lý user và thu tiền người thuê</h2>
              <p>{`Bảng này đang ưu tiên kỳ tiền thuê ${currentBillingLabel}. QR chưa xác nhận sẽ giữ màu đỏ, chỉ khi thanh toán xong và bạn xác nhận thì mới chuyển sang xanh.`}</p>
            </div>
          </div>

          <div className="booking-filter-bar">
            <label className="form-field">
              <span>Lọc thanh toán</span>
              <select value={paymentFilter} onChange={(event) => setPaymentFilter(event.target.value)}>
                <option value="all">Tất cả</option>
                <option value="unpaid">Chưa thanh toán</option>
                <option value="paid">Đã thanh toán</option>
              </select>
            </label>
          </div>

          {filteredTenants.length === 0 ? (
            <div className="dashboard-empty">
              {tenants.length === 0
                ? 'Hiện chưa có người thuê nào đã chốt phòng.'
                : 'Không có người thuê nào khớp với bộ lọc thanh toán này.'}
            </div>
          ) : (
            <div className="table-shell">
              <table className="data-table">
                <thead>
                  <tr>
                    <th>STT</th>
                    <th>Người thuê</th>
                    <th>Phòng</th>
                    <th>Ngày vào ở</th>
                    <th>Thời hạn</th>
                    <th>Trạng thái phòng</th>
                    <th>Hợp đồng</th>
                    <th>Tiền thuê tháng này</th>
                    <th>Thao tác</th>
                  </tr>
                </thead>
                <tbody>
                  {filteredTenants.map((tenant, index) => {
                    const currentRentPayment = tenant.currentRentPayment
                    const currentPaymentCode = currentRentPayment?.paymentCode || ''
                    const currentPaymentStatus = currentRentPayment?.status || ''
                    const latestViewPaymentCode = currentPaymentCode || tenant.latestRentPaymentCode
                    const shouldCreateCurrentRentQr = !currentRentPayment || canDeleteExpiredPayment(currentRentPayment)
                    const isCurrentActionLoading = shouldCreateCurrentRentQr
                      ? paymentCreatingBookingId === tenant.bookingRequestId
                      : paymentOpeningCode === currentPaymentCode

                    return (
                    <tr key={tenant.bookingRequestId}>
                      <td>{index + 1}</td>
                      <td>
                        <strong>{tenant.tenantName}</strong>
                        <div className="table-sub">{tenant.tenantPhone || tenant.tenantEmail || '---'}</div>
                      </td>
                      <td>
                        <strong>{tenant.roomTitle}</strong>
                        <div className="table-sub">{tenant.propertyName}</div>
                        <div className="table-sub">Tiền thuê: {formatCurrency(tenant.monthlyRent)} đ/tháng</div>
                      </td>
                      <td>{formatDate(tenant.moveInDate)}</td>
                      <td>{tenant.monthsToRent} tháng</td>
                      <td>
                        <span className={`status-pill ${tenant.roomStatus}`}>{formatRoomStatusLabel(tenant.roomStatus)}</span>
                      </td>
                      <td>
                        {tenant.hasContract ? (
                          <>
                            <strong>{tenant.contractCode}</strong>
                            <div className="table-sub">{formatContractStatusLabel(tenant.contractStatus)}</div>
                          </>
                        ) : 'Chưa có'}
                      </td>
                      <td>
                        {currentRentPayment ? (
                          <>
                            <strong>{currentRentPayment.paymentCode}</strong>
                            <div className="table-sub">
                              <span className={`status-pill ${getRentCycleStatusTone(currentRentPayment, tenant.isCurrentRentOverdue)}`}>
                                {getRentCycleStatusLabel(currentRentPayment, tenant.isCurrentRentOverdue)}
                              </span>
                            </div>
                            <div className="table-sub">Kỳ thu: {currentBillingLabel}</div>
                            <div className="table-sub">Số tiền: {formatCurrency(currentRentPayment.amount || tenant.monthlyRent)} đ</div>
                            <div className="table-sub">
                              {String(currentPaymentStatus).toLowerCase() === 'success'
                                ? `Đã xác nhận: ${formatDateTime(currentRentPayment.paidAt)}`
                                : `Tạo QR: ${formatDateTime(currentRentPayment.createdAt)}`}
                            </div>
                          </>
                        ) : (
                          <>
                            <strong>Chưa tạo QR {currentBillingLabel}</strong>
                            <div className="table-sub">Hạn thanh toán: {formatDate(tenant.currentRentDueDate)}</div>
                            <div className="table-sub">
                              {tenant.isCurrentRentOverdue
                                ? 'Đã quá hạn nhưng chưa phát hành QR tiền thuê kỳ này.'
                                : 'Bạn có thể phát hành QR cho kỳ thuê hiện tại.'}
                            </div>
                          </>
                        )}
                      </td>
                      <td>
                        <div className="table-actions">
                          {!tenant.hasContract && (
                            <button type="button" className="primary-button compact" onClick={() => openCreateContract(tenant)}>
                              Tạo hợp đồng
                            </button>
                          )}
                          {tenant.hasContract && (
                            <button type="button" className="ghost-button compact" onClick={() => openContractDetail(tenant.contractId)}>
                              Xem hợp đồng
                            </button>
                          )}
                          <button
                            type="button"
                            className={getRentCycleButtonClass(currentRentPayment)}
                            disabled={isCurrentActionLoading}
                            onClick={() => (
                              shouldCreateCurrentRentQr
                                ? handleCreateRentQr(tenant)
                                : openPaymentDetail(currentPaymentCode)
                            )}
                          >
                            {isCurrentActionLoading ? 'Đang xử lý...' : getRentCycleButtonLabel(currentRentPayment)}
                          </button>
                          {latestViewPaymentCode && (
                            <button
                              type="button"
                              className="ghost-button compact"
                              disabled={paymentOpeningCode === latestViewPaymentCode}
                              onClick={() => openPaymentDetail(latestViewPaymentCode)}
                            >
                              {paymentOpeningCode === latestViewPaymentCode ? 'Đang mở...' : 'Xem payment'}
                            </button>
                          )}
                          {currentPaymentCode && canDeleteExpiredPayment(currentRentPayment) && (
                            <button
                              type="button"
                              className="ghost-button compact"
                              disabled={paymentOpeningCode === currentPaymentCode}
                              onClick={() => handleDeleteExpiredPayment(currentPaymentCode)}
                            >
                              {paymentOpeningCode === currentPaymentCode ? 'Đang xóa...' : 'Xóa QR cũ'}
                            </button>
                          )}
                          {currentPaymentCode && canConfirmPayment(currentRentPayment) && (
                            <button
                              type="button"
                              className="ghost-button compact"
                              disabled={confirmingPaymentCode === currentPaymentCode}
                              onClick={() => confirmPaymentByCode(currentPaymentCode)}
                            >
                              {confirmingPaymentCode === currentPaymentCode ? 'Đang xác nhận...' : 'Xác nhận đã nhận tiền'}
                            </button>
                          )}
                        </div>
                      </td>
                    </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>
          )}
        </section>

        {selectedContract && (
          <ContractDetailModal
            contract={selectedContract}
            loading={detailLoading}
            onClose={() => setSelectedContract(null)}
            title="Chi tiết hợp đồng người thuê"
            actionArea={!detailLoading && selectedContract.id ? (
              <div className="contract-action-area">
                <label className="form-field">
                  <span>Tải bản chủ trọ đã ký</span>
                  <input type="file" accept="image/*,application/pdf" onChange={handleLandlordFileUpload} disabled={uploading} />
                </label>
                {uploading && <div className="uploading-note">Đang tải file hợp đồng...</div>}
              </div>
            ) : null}
          />
        )}

        {selectedPayment && (
          <PaymentQrModal
            payment={selectedPayment}
            onClose={() => {
              setSelectedPayment(null)
              setPaymentRefreshing(false)
              setPaymentError('')
            }}
            onRefresh={refreshSelectedPayment}
            refreshing={paymentRefreshing}
            error={paymentError}
            onPaymentDeleted={async () => {
              setSelectedPayment(null)
              setPaymentRefreshing(false)
              setPaymentError('')
              await loadDashboardData()
              setMessage('Đã xóa QR hết hạn. Bạn có thể tạo QR mới cho người thuê này.')
            }}
            actionArea={canConfirmPayment(selectedPayment) ? (
              <button
                type="button"
                className="primary-button"
                disabled={confirmingPaymentCode === selectedPayment.paymentCode}
                onClick={handleMarkPaymentPaid}
              >
                {confirmingPaymentCode === selectedPayment.paymentCode ? 'Đang xác nhận...' : 'Đã thanh toán'}
              </button>
            ) : null}
          />
        )}
      </div>
    </div>
  )
}
