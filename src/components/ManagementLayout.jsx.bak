import ManagementSidebar from './ManagementSidebar'

// ManagementLayout boc quanh tat ca trang admin va landlord.
// No them sidebar ben trai va content ben phai.
// Tat ca page JSX ben trong khong can biet ve sidebar.
export default function ManagementLayout({ children, role }) {
  return (
    <div className="mgmt-layout">
      <ManagementSidebar role={role} />
      <div className="mgmt-content">
        {children}
      </div>
    </div>
  )
}
