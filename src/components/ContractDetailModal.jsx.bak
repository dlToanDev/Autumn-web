// ContractDetailModal la modal hien chi tiet hop dong duoc dung lai o
// AdminContractsPage, LandlordTenantsPage va UserContractsPage.
import {
  formatContractStatusLabel,
  formatDate,
  formatDateTime,
  formatRoomStatusLabel,
} from '../utils/rentalFormat'

function SignaturePreview({ label, fileUrl }) {
  // Neu file la PDF thi mo tab moi, neu la anh thi preview truc tiep.
  const isPdf = String(fileUrl || '').toLowerCase().startsWith('data:application/pdf')

  return (
    <div className="contract-signature-card">
      <span>{label}</span>
      {fileUrl ? (
        <>
          {isPdf ? (
            <a href={fileUrl} target="_blank" rel="noreferrer" className="doc-link">
              Mở file PDF
            </a>
          ) : (
            <img src={fileUrl} alt={label} className="contract-signature-preview" />
          )}
        </>
      ) : (
        <div className="detail-disabled-box">Chưa có file đã ký.</div>
      )}
    </div>
  )
}

export default function ContractDetailModal({
  contract,
  onClose,
  loading = false,
  title = 'Chi tiết hợp đồng',
  actionArea = null,
}) {
  // Modal chi nhan data da duoc page cha load san, khong tu goi API.
  return (
    <div className="detail-modal-backdrop" onClick={onClose}>
      <div className="detail-modal" onClick={(event) => event.stopPropagation()}>
        <div className="panel-heading">
          <div>
            <h2>{title}</h2>
            <p>{contract?.contractCode || '---'}</p>
          </div>
          <button type="button" className="ghost-button" onClick={onClose}>
            Đóng
          </button>
        </div>

        {loading || !contract ? (
          <div className="dashboard-empty">Đang tải hợp đồng...</div>
        ) : (
          <>
            <div className="detail-grid">
              <div className="detail-card">
                <span>Trạng thái hợp đồng</span>
                <strong>{formatContractStatusLabel(contract.status)}</strong>
              </div>
              <div className="detail-card">
                <span>Trạng thái phòng</span>
                <strong>{formatRoomStatusLabel(contract.roomStatus)}</strong>
              </div>
              <div className="detail-card">
                <span>Thời hạn</span>
                <strong>{formatDate(contract.startDate)} - {formatDate(contract.endDate)}</strong>
              </div>
              <div className="detail-card">
                <span>Tạo lúc</span>
                <strong>{formatDateTime(contract.createdAt)}</strong>
              </div>
            </div>

            <div className="contract-person-grid">
              <div className="detail-card">
                <span>Bên thuê</span>
                <strong>{contract.tenantName}</strong>
                <p className="stack-note">{contract.tenantPhone || contract.tenantEmail || '---'}</p>
              </div>
              <div className="detail-card">
                <span>Bên cho thuê</span>
                <strong>{contract.landlordName}</strong>
                <p className="stack-note">{contract.landlordPhone || contract.landlordEmail || '---'}</p>
              </div>
              <div className="detail-card">
                <span>Phòng</span>
                <strong>{contract.roomTitle}</strong>
                <p className="stack-note">{contract.propertyName}</p>
              </div>
              <div className="detail-card">
                <span>Địa chỉ</span>
                <strong>{contract.fullAddress || '---'}</strong>
              </div>
            </div>

            <div className="detail-grid">
              <div className="detail-card">
                <span>Giá thuê</span>
                <strong>{Number(contract.monthlyRent || 0).toLocaleString('vi-VN')} đ/tháng</strong>
              </div>
              <div className="detail-card">
                <span>Tiền cọc</span>
                <strong>{Number(contract.depositAmount || 0).toLocaleString('vi-VN')} đ</strong>
              </div>
              <div className="detail-card booking-wide-card">
                <span>Điều khoản bổ sung</span>
                <strong>{contract.terms || 'Chưa có điều khoản bổ sung riêng.'}</strong>
              </div>
            </div>

            <div className="contract-content-box">
              <h3>Bản hợp đồng online</h3>
              <pre>{contract.onlineContractContent}</pre>
            </div>

            <div className="contract-signature-grid">
              <SignaturePreview label="Bản chủ trọ tải lên" fileUrl={contract.landlordSignedFileUrl} />
              <SignaturePreview label="Bản người thuê tải lên" fileUrl={contract.tenantSignedFileUrl} />
              <div className="contract-signature-card">
                <span>Bản lưu admin</span>
                <div className="detail-disabled-box">
                  Admin xem cùng một bản hợp đồng online này như bản lưu hệ thống.
                </div>
              </div>
            </div>

            {actionArea}
          </>
        )}
      </div>
    </div>
  )
}
