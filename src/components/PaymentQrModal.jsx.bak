// PaymentQrModal la component dung chung cho cac trang thanh toan.
// Modal nay doc chi tiet payment, hien QR/chuyen khoan, nhan proof image
// va cho phep xoa QR het han neu nghiep vu ho tro.
import { useEffect, useState } from 'react'
import { deleteExpiredPayment, submitPaymentProof } from '../api/paymentApi'
import { fileToDataUrl } from '../utils/file'
import { formatCurrency, formatDateTime } from '../utils/rentalFormat'

function formatPaymentStatusLabel(value) {
  const normalized = String(value || '').toLowerCase()
  if (normalized === 'pending') return 'Đang chờ thanh toán'
  if (normalized === 'waiting_confirm') return 'Chờ bên nhận xác nhận'
  if (normalized === 'success') return 'Đã xác nhận thanh toán'
  if (normalized === 'failed') return 'Thanh toán thất bại'
  if (normalized === 'canceled') return 'Đã hủy'
  if (normalized === 'expired') return 'QR đã hết hạn'
  return value || '---'
}

function formatPaymentTypeLabel(value) {
  const normalized = String(value || '').toLowerCase()
  if (normalized === 'deposit') return 'Tiền cọc'
  if (normalized === 'rent') return 'Tiền thuê'
  if (normalized === 'service') return 'Phí dịch vụ'
  if (normalized === 'listing_fee') return 'Phí đăng tin'
  return value || '---'
}

function formatBookingStatusLabel(value) {
  const normalized = String(value || '').toLowerCase()
  if (normalized === 'pending') return 'Đang chờ xử lý'
  if (normalized === 'waiting_payment') return 'Chờ thanh toán'
  if (normalized === 'paid') return 'Đã thanh toán'
  if (normalized === 'confirmed') return 'Đã xác nhận'
  if (normalized === 'rejected') return 'Đã từ chối'
  if (normalized === 'canceled') return 'Đã hủy'
  if (normalized === 'expired') return 'Hết hạn'
  return value || '---'
}

function PaymentCopyField({ label, value }) {
  const [copyState, setCopyState] = useState('')

  useEffect(() => {
    // Dong thong bao "da sao chep" sau mot khoang ngan de UI gon hon.
    if (!copyState) return undefined

    const timer = window.setTimeout(() => setCopyState(''), 1800)
    return () => window.clearTimeout(timer)
  }, [copyState])

  const copyValue = async () => {
    // Cho copy nhanh so tai khoan/so tien/noi dung chuyen khoan.
    if (!value) return

    try {
      await navigator.clipboard.writeText(String(value))
      setCopyState('Đã sao chép')
    } catch {
      setCopyState('Không sao chép được')
    }
  }

  return (
    <div className="payment-copy-field">
      <span>{label}</span>
      <strong>{value || '---'}</strong>
      <div className="payment-copy-actions">
        <button type="button" className="ghost-button compact" onClick={copyValue} disabled={!value}>
          Sao chép
        </button>
        {copyState && <span className="payment-copy-state">{copyState}</span>}
      </div>
    </div>
  )
}

function PaymentStatusMessage({ status, isPayer }) {
  // Phan nay chi quy doi status ky thuat thanh huong dan de doc.
  const normalized = String(status || '').toLowerCase()

  if (normalized === 'success') {
    return (
      <div className="alert success payment-alert">
        Bên nhận đã xác nhận thanh toán thành công.
      </div>
    )
  }

  if (normalized === 'waiting_confirm') {
    return (
      <div className="alert payment-alert payment-alert-warning">
        {isPayer
          ? 'Bạn đã gửi ảnh minh chứng chuyển khoản. Hãy chờ bên nhận kiểm tra và xác nhận.'
          : 'Người chuyển tiền đã gửi ảnh minh chứng. Hãy kiểm tra và bấm xác nhận nếu hợp lệ.'}
      </div>
    )
  }

  if (normalized === 'expired') {
    return (
      <div className="alert error payment-alert">
        Mã QR này đã hết hạn. Nếu bạn đã chuyển khoản, vẫn có thể tải ảnh minh chứng để bên nhận kiểm tra thủ công.
      </div>
    )
  }

  if (normalized === 'canceled') {
    return (
      <div className="alert error payment-alert">
        Payment này đã bị hủy vì booking không còn hợp lệ hoặc đã được xử lý theo hướng khác.
      </div>
    )
  }

  if (normalized === 'failed') {
    return (
      <div className="alert error payment-alert">
        Thanh toán chưa hoàn tất. Bạn có thể kiểm tra lại thông tin chuyển khoản và thử lại.
      </div>
    )
  }

  return (
    <div className="alert payment-alert payment-alert-info">
      Quét mã VietQR hoặc chuyển khoản đúng số tiền và nội dung bên dưới. Sau khi chuyển xong, hãy tải ảnh minh chứng và gửi cho bên nhận xác nhận.
    </div>
  )
}

export default function PaymentQrModal({
  payment,
  onClose,
  onRefresh,
  refreshing = false,
  error = '',
  actionArea = null,
  onPaymentChanged = null,
  onPaymentDeleted = null,
}) {
  // local state giup modal tu quan ly anh proof va thao tac submit/xoa ma QR.
  const [proofImageUrl, setProofImageUrl] = useState('')
  const [proofLoading, setProofLoading] = useState(false)
  const [proofSubmitting, setProofSubmitting] = useState(false)
  const [deleting, setDeleting] = useState(false)
  const [proofError, setProofError] = useState('')

  useEffect(() => {
    setProofImageUrl(payment?.transferProofImageUrl || '')
    setProofError('')
  }, [payment?.paymentCode, payment?.transferProofImageUrl])

  if (!payment) return null

  const currentUser = (() => {
    try {
      const rawUser = localStorage.getItem('user')
      return rawUser ? JSON.parse(rawUser) : null
    } catch {
      return null
    }
  })()

  const currentUserId = Number(currentUser?.id || 0)
  const normalizedStatus = String(payment.status || '').toLowerCase()
  const canRefresh = normalizedStatus === 'pending' || normalizedStatus === 'waiting_confirm' || normalizedStatus === 'expired'
  const isPayer = currentUserId > 0 && Number(payment.payerId) === currentUserId
  const canSubmitProof = isPayer && normalizedStatus !== 'success' && normalizedStatus !== 'canceled' && normalizedStatus !== 'failed'
  const canDeleteExpired = normalizedStatus === 'expired'

  const handleProofFileChange = async (event) => {
    const file = event.target.files?.[0]
    if (!file) return

    setProofLoading(true)
    setProofError('')

    try {
      const dataUrl = await fileToDataUrl(file)
      setProofImageUrl(dataUrl)
    } catch (fileError) {
      setProofError(fileError?.message || 'Không thể đọc file minh chứng.')
    } finally {
      setProofLoading(false)
      event.target.value = ''
    }
  }

  const handleSubmitProof = async () => {
    if (!proofImageUrl || proofSubmitting) return

    setProofSubmitting(true)
    setProofError('')

    try {
      const updatedPayment = await submitPaymentProof(payment.paymentCode, { proofImageUrl })
      onPaymentChanged?.(updatedPayment)
    } catch (submitError) {
      setProofError(submitError?.response?.data?.message || 'Không thể gửi ảnh minh chứng lúc này.')
    } finally {
      setProofSubmitting(false)
    }
  }

  const handleDeleteExpired = async () => {
    if (!canDeleteExpired || deleting) return

    const shouldDelete = window.confirm('QR này đã hết hạn. Bạn có muốn xóa payment cũ để tạo QR mới không?')
    if (!shouldDelete) return

    setDeleting(true)
    setProofError('')

    try {
      await deleteExpiredPayment(payment.paymentCode)
      await onPaymentDeleted?.(payment)
      onClose?.()
    } catch (deleteError) {
      setProofError(deleteError?.response?.data?.message || 'Không thể xóa QR hết hạn lúc này.')
    } finally {
      setDeleting(false)
    }
  }

  return (
    <div className="detail-modal-backdrop" onClick={onClose}>
      <div className="detail-modal payment-modal" onClick={(event) => event.stopPropagation()}>
        <div className="panel-heading">
          <div>
            <h2>Thanh toán QR</h2>
            <p>{payment.paymentCode}</p>
          </div>
          <button type="button" className="ghost-button" onClick={onClose}>
            Đóng
          </button>
        </div>

        <PaymentStatusMessage status={payment.status} isPayer={isPayer} />
        {error && <div className="alert error payment-alert">{error}</div>}
        {proofError && <div className="alert error payment-alert">{proofError}</div>}

        <div className="payment-modal-layout">
          <section className="payment-qr-panel">
            <div className="payment-qr-image-shell">
              {payment.qrImageUrl ? (
                <img src={payment.qrImageUrl} alt={`QR ${payment.paymentCode}`} className="payment-qr-image" />
              ) : (
                <div className="detail-disabled-box">
                  Chưa tạo được ảnh QR. Bạn vẫn có thể chuyển khoản thủ công bằng thông tin bên cạnh.
                </div>
              )}
            </div>

            <div className="payment-qr-summary">
              <div className="detail-card">
                <span>Loại thanh toán</span>
                <strong>{formatPaymentTypeLabel(payment.paymentType)}</strong>
              </div>
              <div className="detail-card">
                <span>Số tiền</span>
                <strong>{formatCurrency(payment.amount)} đ</strong>
              </div>
              <div className="detail-card">
                <span>Trạng thái payment</span>
                <strong>
                  <span className={`status-pill ${payment.status}`}>{formatPaymentStatusLabel(payment.status)}</span>
                </strong>
              </div>
              <div className="detail-card">
                <span>Trạng thái booking</span>
                <strong>
                  <span className={`status-pill ${payment.bookingStatus}`}>{formatBookingStatusLabel(payment.bookingStatus)}</span>
                </strong>
              </div>
            </div>
          </section>

          <section className="payment-info-panel">
            <div className="payment-info-grid">
              <PaymentCopyField label="Ngân hàng" value={payment.bankCode} />
              <PaymentCopyField label="Số tài khoản" value={payment.bankAccountNo} />
              <PaymentCopyField label="Tên tài khoản" value={payment.accountName} />
              <PaymentCopyField label="Nội dung chuyển khoản" value={payment.qrContent} />
            </div>

            <div className="detail-grid payment-meta-grid">
              <div className="detail-card">
                <span>Mã booking</span>
                <strong>{payment.bookingCode || '---'}</strong>
              </div>
              <div className="detail-card">
                <span>Phòng</span>
                <strong>{payment.roomTitle || '---'}</strong>
              </div>
              <div className="detail-card">
                <span>Tạo lúc</span>
                <strong>{formatDateTime(payment.createdAt)}</strong>
              </div>
              <div className="detail-card">
                <span>Hết hạn lúc</span>
                <strong>{formatDateTime(payment.expiredAt)}</strong>
              </div>
              <div className="detail-card">
                <span>Thanh toán lúc</span>
                <strong>{formatDateTime(payment.paidAt)}</strong>
              </div>
              <div className="detail-card">
                <span>Mã tham chiếu</span>
                <strong>{payment.transactionRef || 'Chưa có'}</strong>
              </div>
              <div className="detail-card">
                <span>Gửi minh chứng lúc</span>
                <strong>{formatDateTime(payment.proofSubmittedAt)}</strong>
              </div>
            </div>

            <section className="payment-proof-box">
              <div className="panel-heading compact">
                <div>
                  <h3>Ảnh minh chứng chuyển khoản</h3>
                  <p>Người chuyển tiền tải ảnh xác nhận giao dịch sau khi đã chuyển khoản thành công.</p>
                </div>
              </div>

              {proofImageUrl ? (
                <img src={proofImageUrl} alt={`Minh chứng ${payment.paymentCode}`} className="payment-proof-image" />
              ) : (
                <div className="detail-disabled-box">
                  Chưa có ảnh minh chứng nào được gửi lên.
                </div>
              )}

              {canSubmitProof && (
                <div className="payment-proof-actions">
                  <label className="form-field">
                    <span>Tải ảnh giao dịch thành công</span>
                    <input type="file" accept="image/*" onChange={handleProofFileChange} disabled={proofLoading || proofSubmitting} />
                  </label>

                  <div className="inline-actions">
                    <button type="button" className="primary-button" onClick={handleSubmitProof} disabled={!proofImageUrl || proofLoading || proofSubmitting}>
                      {proofSubmitting ? 'Đang gửi minh chứng...' : 'Tôi đã chuyển khoản, gửi xác nhận'}
                    </button>
                  </div>
                </div>
              )}
            </section>

            <div className="detail-disabled-box payment-help-box">
              Nếu app ngân hàng không quét được ảnh QR, bạn có thể chuyển khoản thủ công bằng đúng số tiền và đúng nội dung đã hiển thị, sau đó tải ảnh minh chứng lên đây.
            </div>

            <div className="inline-actions payment-modal-actions">
              {canRefresh && (
                <button type="button" className="primary-button" onClick={onRefresh} disabled={refreshing}>
                  {refreshing ? 'Đang kiểm tra...' : 'Kiểm tra trạng thái'}
                </button>
              )}
              {canDeleteExpired && (
                <button type="button" className="ghost-button" onClick={handleDeleteExpired} disabled={deleting}>
                  {deleting ? 'Đang xóa...' : 'Xóa QR hết hạn'}
                </button>
              )}
              {payment.qrImageUrl && (
                <a href={payment.qrImageUrl} target="_blank" rel="noreferrer" className="ghost-button card-link-button">
                  Mở ảnh QR
                </a>
              )}
              {actionArea}
            </div>
          </section>
        </div>
      </div>
    </div>
  )
}
