import { useEffect, useRef, useState } from 'react'
import { Link, NavLink, useLocation, useNavigate } from 'react-router-dom'
import {
  FiBell,
  FiChevronDown,
  FiCompass,
  FiLayout,
  FiLogIn,
  FiMenu,
  FiMessageCircle,
  FiSearch,
  FiUser,
  FiX,
} from 'react-icons/fi'
import { getMyNotifications } from '../api/notificationApi'
import { getDefaultRoute, getRoleCode } from '../utils/auth'
import { NOTIFICATIONS_CHANGED_EVENT } from '../utils/notificationEvents'

// Cac menu text o thanh ngang.
// Tin nhan khong con nam o day nua vi da duoc doi thanh nut chat noi.
const publicMenuItems = [
  { to: '/', label: 'Trang Chủ' },
  { to: '/login', label: 'Đăng nhập' },
  { to: '/register', label: 'Đăng ký' },
]

const userMenuItems = [
  { to: '/user', label: 'Trang Chủ' },
  { to: '/user/rooms', label: 'Tìm Phòng' },
  { to: '/user/contracts', label: 'Hợp đồng' },
  { to: '/user/payments', label: 'Lịch sử thanh toán' },
  { to: '/become-landlord', label: 'Đăng ký chủ trọ' },
]

const landlordMenuItems = [
  { to: '/user', label: 'Trang Chủ' },
  { to: '/landlord', label: 'Dashboard' },
  { to: '/landlord/properties', label: 'Khu trọ' },
  { to: '/landlord/rooms', label: 'Phòng' },
  { to: '/landlord/tenants', label: 'Người Thuê' },


]

const adminMenuItems = [
  { to: '/admin', label: 'Dashboard' },
  { to: '/admin/announcements', label: 'Đăng thông báo' },
  { to: '/admin/users', label: 'Quản lý user' },
  { to: '/admin/rooms', label: 'Quản lý phòng' },
  { to: '/admin/contracts', label: ' Quản lý hợp đồng' },
  { to: '/admin/landlord-applications', label: 'Duyệt hồ sơ' },
]

const menuIcons = {
  '/': FiCompass,
  '/login': FiLogIn,
  '/register': FiUser,
  '/user': FiLayout,
  '/user/rooms': FiSearch,
  '/landlord': FiLayout,
  '/admin': FiLayout,
}

function getRoleLabel(roleCode) {
  if (roleCode === 'ADMIN') return 'Admin mode'
  if (roleCode === 'LANDLORD') return 'Landlord mode'
  if (roleCode === 'USER') return 'Tenant mode'
  return 'Guest'
}

// Helper de Header khong phai biet user object den tu dau.
// Chi can truyen user vao la Header tu rut ra ten hien thi.
function getDisplayName(user) {
  if (!user) return ''
  return user.fullName || user.name || user.username || user.email || 'Tài khoản'
}

// Lay avatar url, co fallback neu user chua co avatar.
function getAvatarUrl(user) {
  if (!user) return ''
  return user.avatarUrl || user.avatar || user.photoUrl || ''
}

// Header la component chung xuat hien tren moi trang.
// Nhiem vu:
// - Hien menu theo role
// - Hien chuong thong bao + badge unread
// - Hien profile dropdown
export default function Header({ isLoggedIn, user }) {
  const location = useLocation()
  const navigate = useNavigate()
  const dropdownRef = useRef(null)
  const mobileMenuRef = useRef(null)
  const [openMenu, setOpenMenu] = useState(false)
  const [openMobileNav, setOpenMobileNav] = useState(false)
  const [unreadCount, setUnreadCount] = useState(0)
  const displayName = getDisplayName(user)
  const avatarUrl = getAvatarUrl(user)
  const roleCode = getRoleCode(user)
  const isAdmin = roleCode === 'ADMIN'
  const isLandlord = roleCode === 'LANDLORD'
  const homePath = getDefaultRoute(isLoggedIn, user)
  const isNotificationsPage = location.pathname.startsWith('/notifications')
  const isMessagesPage = location.pathname.startsWith('/messages')
  const menuItems = !isLoggedIn
    ? publicMenuItems
    : (isAdmin ? adminMenuItems : (isLandlord ? landlordMenuItems : userMenuItems))

  // Dong dropdown neu click ra ngoai.
  useEffect(() => {
    const onClickOutside = (event) => {
      if (dropdownRef.current && !dropdownRef.current.contains(event.target)) {
        setOpenMenu(false)
      }
    }
    document.addEventListener('mousedown', onClickOutside)
    return () => document.removeEventListener('mousedown', onClickOutside)
  }, [])

  useEffect(() => {
    const onClickOutsideMobile = (event) => {
      if (mobileMenuRef.current && !mobileMenuRef.current.contains(event.target)) {
        setOpenMobileNav(false)
      }
    }

    document.addEventListener('mousedown', onClickOutsideMobile)
    return () => document.removeEventListener('mousedown', onClickOutsideMobile)
  }, [])

  // Moi lan doi route thi dong dropdown cho giao dien gon hon.
  useEffect(() => {
    setOpenMenu(false)
    setOpenMobileNav(false)
  }, [location.pathname])

  // Polling unread notifications cho icon chuong.
  // Ngoai polling, Header con lang nghe custom event de cap nhat ngay khi page khac vua thay doi trang thai thong bao.
  useEffect(() => {
    if (!isLoggedIn) {
      setUnreadCount(0)
      return undefined
    }

    let isDisposed = false

    const loadUnreadCount = async () => {
      try {
        // Header chi can tong unread, nhung backend hien tra ca danh sach.
        // O day minh filter local de ra so luong badge.
        const notifications = await getMyNotifications()
        if (isDisposed) return

        const nextUnreadCount = Array.isArray(notifications)
          ? notifications.filter((item) => !item.isRead).length
          : 0

        setUnreadCount(nextUnreadCount)
      } catch {
        if (!isDisposed) {
          setUnreadCount(0)
        }
      }
    }

    // Event nay duoc NotificationsPage / NotificationDetailPage / AdminAnnouncementsPage phat ra.
    const handleNotificationsChanged = () => {
      loadUnreadCount()
    }

    loadUnreadCount()
    window.addEventListener(NOTIFICATIONS_CHANGED_EVENT, handleNotificationsChanged)
    const intervalId = window.setInterval(loadUnreadCount, 30000)

    return () => {
      isDisposed = true
      window.removeEventListener(NOTIFICATIONS_CHANGED_EVENT, handleNotificationsChanged)
      window.clearInterval(intervalId)
    }
  }, [isLoggedIn, location.pathname])

  // Xoa localStorage va quay ve trang public.
  const handleLogout = () => {
    localStorage.removeItem('token')
    localStorage.removeItem('user')
    setUnreadCount(0)
    setOpenMenu(false)
    navigate('/')
  }

  const unreadBadgeLabel = unreadCount > 99 ? '99+' : unreadCount

  const quickLinks = isLoggedIn
    ? [
        { to: '/notifications', label: 'Thông báo', icon: FiBell },
        { to: '/messages', label: 'Tin nhắn', icon: FiMessageCircle },
        { to: '/profile', label: 'Tài khoản', icon: FiUser },
      ]
    : []

  return (
    <header className="site-header">
      <div className="site-header-inner" ref={mobileMenuRef}>
        {/* Logo + brand, link ve trang mac dinh theo login/role */}
        <Link to={homePath} className="brand-link" aria-label="RentalPlatform Home">
          <span className="brand-logo" aria-hidden="true">
            <FiCompass />
          </span>
          <span className="brand-copy">
            <span className="brand-name">TLMT Rental</span>
            <span className="brand-tagline">{getRoleLabel(roleCode)}</span>
          </span>
        </Link>

        {/* Menu text chinh */}
        <nav className="main-menu" aria-label="Main menu">
          {menuItems.map((item) => {
            const Icon = menuIcons[item.to]

            return (
              <NavLink
                key={item.to}
                to={item.to}
                className={({ isActive }) => `menu-link${isActive ? ' active' : ''}`}
              >
                {Icon ? <span className="menu-link-icon"><Icon /></span> : null}
                {item.label}
              </NavLink>
            )
          })}
        </nav>

        <div className="auth-actions">
          <button
            type="button"
            className="mobile-nav-toggle"
            aria-label={openMobileNav ? 'Đóng menu' : 'Mở menu'}
            aria-expanded={openMobileNav}
            onClick={() => setOpenMobileNav((prev) => !prev)}
          >
            {openMobileNav ? <FiX /> : <FiMenu />}
          </button>

          {isLoggedIn ? (
            <>
              {/* Icon chuong thong bao */}
              <Link
                to="/notifications"
                className={`notification-link${isNotificationsPage ? ' active' : ''}`}
                aria-label="Thông báo"
                title="Thông báo"
              >
                <FiBell className="notification-icon" />
                {unreadCount > 0 && <span className="notification-badge">{unreadBadgeLabel}</span>}
              </Link>

              <Link
                to="/messages"
                className={`notification-link${isMessagesPage ? ' active' : ''}`}
                aria-label="Tin nhắn"
                title="Tin nhắn"
              >
                <FiMessageCircle className="notification-icon" />
              </Link>

              {/* Khu profile + dropdown */}
              <div className="auth-zone" ref={dropdownRef}>
                <button
                  type="button"
                  className="user-chip user-chip-btn"
                  title={displayName}
                  onClick={() => setOpenMenu((prev) => !prev)}
                >
                  {avatarUrl ? (
                    <img src={avatarUrl} alt={displayName} className="user-avatar" />
                  ) : (
                    <span className="user-avatar user-avatar-fallback">
                      {displayName.charAt(0).toUpperCase()}
                    </span>
                  )}
                  <span className="user-chip-copy">
                    <span className="user-role-pill">{getRoleLabel(roleCode)}</span>
                    <span className="user-name">{displayName}</span>
                  </span>
                  <FiChevronDown className="user-chip-caret" />
                </button>

                {openMenu && (
                  <div className="user-dropdown">
                    {!isAdmin && !isLandlord && (
                      <Link to="/user" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Trang chủ
                      </Link>
                    )}
                    {!isAdmin && !isLandlord && (
                      <Link to="/user/rooms" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Tìm phòng
                      </Link>
                    )}
                    {!isAdmin && !isLandlord && (
                      <Link to="/user/payments" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Lịch sử thanh toán
                      </Link>
                    )}
                    {!isAdmin && !isLandlord && (
                      <Link to="/user/contracts" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Hợp đồng của tôi
                      </Link>
                    )}
                    {isLandlord && (
                      <Link to="/landlord" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Dashboard chủ trọ
                      </Link>
                    )}
                    {isAdmin && (
                      <Link to="/admin" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Dashboard admin
                      </Link>
                    )}
                    <Link to="/notifications" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                      Thông báo
                    </Link>
                    <Link to="/messages" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                      Tin nhắn
                    </Link>
                    <Link to="/profile" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                      Profile
                    </Link>
                    <Link to="/forgot-password" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                      Đổi mật khẩu
                    </Link>
                    {!isAdmin && !isLandlord && (
                      <Link to="/become-landlord" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Đăng ký chủ trọ
                      </Link>
                    )}
                    {isLandlord && (
                      <Link to="/landlord/properties" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Quản lý khu trọ
                      </Link>
                    )}
                    {isLandlord && (
                      <Link to="/landlord/rooms" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Quản lý phòng
                      </Link>
                    )}
                    {isLandlord && (
                      <Link to="/landlord/bookings" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Quản lý booking
                      </Link>
                    )}
                    {isLandlord && (
                      <Link to="/landlord/tenants" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Quản lý user
                      </Link>
                    )}
                    {isLandlord && (
                      <Link to="/landlord/commission-payments" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Thanh toán phụ phí
                      </Link>
                    )}
                    {isLandlord && (
                      <Link to="/landlord/payments" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Lịch sử thanh toán
                      </Link>
                    )}
                    {isAdmin && (
                      <Link to="/admin/announcements" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Viết bài thông báo
                      </Link>
                    )}
                    {isAdmin && (
                      <Link to="/admin/users" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Quản lý user
                      </Link>
                    )}
                    {isAdmin && (
                      <Link to="/admin/rooms" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Quản lý phòng hệ thống
                      </Link>
                    )}
                    {isAdmin && (
                      <Link to="/admin/landlord-applications" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Duyệt hồ sơ chủ trọ
                      </Link>
                    )}
                    {isAdmin && (
                      <Link to="/admin/contracts" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Bản lưu hợp đồng
                      </Link>
                    )}
                    {isAdmin && (
                      <Link to="/admin/commission-payments" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        QR hoa hồng
                      </Link>
                    )}
                    {isAdmin && (
                      <Link to="/admin/payments" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Lịch sử thanh toán
                      </Link>
                    )}
                    {isAdmin && (
                      <Link to="/admin/payment-settings" className="user-dropdown-item" onClick={() => setOpenMenu(false)}>
                        Cấu hình hệ thống
                      </Link>
                    )}
                    <button type="button" className="user-dropdown-item danger" onClick={handleLogout}>
                      Đăng xuất
                    </button>
                  </div>
                )}
              </div>
            </>
          ) : (
            <Link to="/login" className="login-link">
              <FiLogIn />
              Đăng nhập
            </Link>
          )}
        </div>

        <div className={`mobile-nav-panel${openMobileNav ? ' open' : ''}`}>
          <div className="mobile-nav-links">
            {menuItems.map((item) => {
              const Icon = menuIcons[item.to] || FiCompass

              return (
                <NavLink
                  key={item.to}
                  to={item.to}
                  className={({ isActive }) => `mobile-nav-link${isActive ? ' active' : ''}`}
                >
                  <Icon />
                  <span>{item.label}</span>
                </NavLink>
              )
            })}
          </div>

          {quickLinks.length > 0 && (
            <div className="mobile-nav-quick-links">
              {quickLinks.map((item) => {
                const Icon = item.icon

                return (
                  <Link key={item.to} to={item.to} className="mobile-nav-quick-link">
                    <Icon />
                    <span>{item.label}</span>
                  </Link>
                )
              })}
            </div>
          )}
        </div>
      </div>
    </header>
  )
}
