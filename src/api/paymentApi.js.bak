// paymentApi la lop giao tiep voi backend cho tat ca nghiep vu QR/payment/proof.
// Nhieu page payments va modal QR cung dung chung file nay.
import apiClient from './apiClient'

function authConfig() {
  // Payment endpoint can biet ai la payer/payee nen luon can token.
  const token = localStorage.getItem('token')
  return { headers: { Authorization: `Bearer ${token}` } }
}

export async function createVietQrPayment(payload) {
  // User/tenant tao thanh toan coc hoac tien thue tu RoomDetailPage.
  const response = await apiClient.post('/api/payments/create-vietqr', payload, authConfig())
  return response.data
}

export async function createLandlordVietQrPayment(payload) {
  // Landlord tao QR thu tien thue hoac phi khac tu LandlordTenantsPage.
  const response = await apiClient.post('/api/payments/landlord/create-vietqr', payload, authConfig())
  return response.data
}

export async function getAdminCommissionBilling(params) {
  // AdminCommissionPaymentsPage lay bang tong hop hoa hong theo thang.
  const response = await apiClient.get('/api/payments/admin/commission-billing', {
    ...authConfig(),
    params,
  })
  return response.data
}

export async function createAdminCommissionVietQrPayment(payload) {
  // Admin tao QR thu hoa hong tu landlord.
  const response = await apiClient.post('/api/payments/admin/create-commission-vietqr', payload, authConfig())
  return response.data
}

export async function getMyPayments() {
  // LandlordPaymentsPage, UserPaymentsPage, AdminPaymentsPage deu lay danh sach tu day.
  const response = await apiClient.get('/api/payments/my', authConfig())
  return response.data
}

export async function getPaymentByCode(paymentCode) {
  // PaymentQrModal mo chi tiet mot giao dich dua theo ma payment_code.
  const response = await apiClient.get(`/api/payments/${paymentCode}`, authConfig())
  return response.data
}

export async function deleteExpiredPayment(paymentCode) {
  // Cho phep xoa QR da het han de tao ma moi sach hon.
  await apiClient.delete(`/api/payments/${paymentCode}`, authConfig())
}

export async function submitPaymentProof(paymentCode, payload) {
  // Nguoi chuyen khoan gui anh minh chung qua modal QR.
  const response = await apiClient.post(`/api/payments/${paymentCode}/submit-proof`, payload, authConfig())
  return response.data
}

export async function markLandlordPaymentPaid(paymentCode) {
  // Chu tro xac nhan da nhan tien.
  const response = await apiClient.post(`/api/payments/landlord/${paymentCode}/mark-paid`, {}, authConfig())
  return response.data
}

export async function markAdminPaymentPaid(paymentCode) {
  // Admin xac nhan khoan thanh toan phia he thong.
  const response = await apiClient.post(`/api/payments/admin/${paymentCode}/mark-paid`, {}, authConfig())
  return response.data
}
