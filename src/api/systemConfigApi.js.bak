// systemConfigApi hien dang duoc dung cho trang cau hinh thanh toan cua admin.
import apiClient from './apiClient'

function authConfig() {
  // Chi admin moi duoc doc/sua system config.
  const token = localStorage.getItem('token')
  return { headers: { Authorization: `Bearer ${token}` } }
}

export async function getAdminPaymentSettings() {
  // AdminPaymentSettingsPage lay commission rate va expire minutes hien tai.
  const response = await apiClient.get('/api/admin/payment-settings', authConfig())
  return response.data
}

export async function updateAdminPaymentSettings(payload) {
  // AdminPaymentSettingsPage luu lai cau hinh payment.commission_rate va payment.expire_minutes.
  const response = await apiClient.put('/api/admin/payment-settings', payload, authConfig())
  return response.data
}
