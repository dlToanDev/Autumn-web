import apiClient from './apiClient'

// File API nay gom cac ham frontend dung de goi khu vuc admin.
// Cac ham o day khong xu ly UI, khong xu ly state.
// Nhiem vu duy nhat:
// - Tao HTTP request dung endpoint
// - Gan token Authorization
// - Tra response.data gon ve cho page/component
function authConfig() {
  // Token duoc luu sau khi dang nhap thanh cong.
  // Moi API admin deu can token nay de backend xac dinh quyen ADMIN.
  const token = localStorage.getItem('token')
  return { headers: { Authorization: `Bearer ${token}` } }
}

// Lay thong ke dashboard admin.
export async function getAdminDashboard() {
  const response = await apiClient.get('/api/admin/dashboard', authConfig())
  return response.data
}

// Lay danh sach user de admin quan ly.
export async function getAdminUsers() {
  const response = await apiClient.get('/api/admin/users', authConfig())
  return response.data
}

// Cap nhat trang thai 1 user: active / inactive / locked...
export async function updateAdminUserStatus(userId, status) {
  const response = await apiClient.put(`/api/admin/users/${userId}/status`, { status }, authConfig())
  return response.data
}

// Lay danh sach phong cho admin kiem duyet.
export async function getAdminRooms() {
  const response = await apiClient.get('/api/admin/rooms', authConfig())
  return response.data
}

// Cap nhat duyet/an phong tu phia admin.
export async function updateAdminRoomModeration(roomId, payload) {
  const response = await apiClient.put(`/api/admin/rooms/${roomId}/moderation`, payload, authConfig())
  return response.data
}

// Lay lich su bai thong bao admin da gui.
// Frontend dung o AdminAnnouncementsPage.
export async function getAdminAnnouncements() {
  const response = await apiClient.get('/api/admin/announcements', authConfig())
  return response.data
}

// Gui 1 bai thong bao moi.
// payload gom: title, content, targetRole.
// Backend se tao 1 announcement + nhieu notifications cho nguoi nhan.
export async function createAdminAnnouncement(payload) {
  const response = await apiClient.post('/api/admin/announcements', payload, authConfig())
  return response.data
}
