import apiClient from './apiClient'

// Lop API rieng cho tinh nang thong bao.
// Frontend page/component nao goi file nay:
// - Header: dem badge thong bao
// - NotificationsPage: load list + mark read
// - NotificationDetailPage: mo chi tiet + mark read
function authConfig() {
  // Moi API thong bao deu can token de backend biet dang xem cua user nao.
  const token = localStorage.getItem('token')
  return { headers: { Authorization: `Bearer ${token}` } }
}

// Lay tat ca thong bao cua current user.
export async function getMyNotifications() {
  const response = await apiClient.get('/api/notifications/my', authConfig())
  return response.data
}

// Lay chi tiet 1 thong bao theo id.
export async function getNotificationById(notificationId) {
  const response = await apiClient.get(`/api/notifications/${notificationId}`, authConfig())
  return response.data
}

// Danh dau 1 thong bao la da doc.
export async function markNotificationAsRead(notificationId) {
  const response = await apiClient.post(`/api/notifications/${notificationId}/read`, {}, authConfig())
  return response.data
}

// Danh dau toan bo thong bao cua user la da doc.
export async function markAllNotificationsAsRead() {
  const response = await apiClient.post('/api/notifications/read-all', {}, authConfig())
  return response.data
}
