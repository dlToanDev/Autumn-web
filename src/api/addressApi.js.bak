// addressApi cung cap du lieu tinh/huyen/xa cho cac form tim kiem va CRUD nha/phong.
import apiClient from './apiClient'

export async function getProvinces(params = {}) {
  // RoomSearchPage va LandlordPropertiesPage nap danh sach cap tinh.
  const response = await apiClient.get('/api/provinces', { params })
  return response.data
}

export async function getDistricts(provinceId, params = {}) {
  // Lay cap huyen theo provinceId da chon.
  const response = await apiClient.get('/api/districts', {
    params: { provinceId, ...params },
  })
  return response.data
}

export async function getWards(districtId, params = {}) {
  // Lay cap xa theo districtId da chon.
  const response = await apiClient.get('/api/wards', {
    params: { districtId, ...params },
  })
  return response.data
}
