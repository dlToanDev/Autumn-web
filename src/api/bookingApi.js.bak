// bookingApi gom API tao yeu cau thue/dat lich va quy trinh landlord xu ly booking.
import apiClient from './apiClient'

function authConfig() {
  // Tat ca booking trong he thong deu gan voi user dang dang nhap.
  const token = localStorage.getItem('token')
  return { headers: { Authorization: `Bearer ${token}` } }
}

export async function createBookingRequest(payload) {
  // RoomDetailPage goi ham nay khi user bam gui yeu cau thue hoac dat lich xem.
  const response = await apiClient.post('/api/bookings', payload, authConfig())
  return response.data
}

export async function getMyBookingRequests(params = {}) {
  // RoomDetailPage dung de hien lich su booking cua user voi phong dang xem.
  const response = await apiClient.get('/api/bookings/my', {
    ...authConfig(),
    params,
  })
  return response.data
}

export async function getLandlordBookingRequests(params = {}) {
  // LandlordBookingsPage va LandlordDashboardPage lay danh sach booking cua chu tro.
  const response = await apiClient.get('/api/bookings/landlord', {
    ...authConfig(),
    params,
  })
  return response.data
}

export async function getLandlordBookingById(bookingId) {
  // LandlordBookingsPage mo chi tiet tung booking khi can review.
  const response = await apiClient.get(`/api/bookings/landlord/${bookingId}`, authConfig())
  return response.data
}

export async function reviewLandlordBooking(bookingId, payload) {
  // Chu tro duyet, tu choi hoac cap nhat trang thai booking.
  const response = await apiClient.post(`/api/bookings/landlord/${bookingId}/review`, payload, authConfig())
  return response.data
}

export async function upsertBookingReview(bookingId, payload) {
  // Sau khi o thanh cong, user co the de lai danh gia phong.
  const response = await apiClient.post(`/api/bookings/${bookingId}/reviews`, payload, authConfig())
  return response.data
}
